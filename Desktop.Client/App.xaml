<Application x:Class="Desktop.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Desktop.Client"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/NavTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
            <converters:BoolToFormTitleConverter x:Key="BoolToFormTitleConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter"/>
            <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVis"/>
            <converters:TitleCaseConverter x:Key="TitleCaseConverter"/>
            <converters:HoldLockDisplayConverter x:Key="HoldLockDisplayConverter"/>
            <converters:InverseNullToBooleanConverter x:Key="InverseNullToBooleanConverter"/>
            <!-- 8.211-T4c2b1 (S9): labels, amounts and dual-only visibility from the WPF profile. -->
            <converters:LocalAmountConverter x:Key="LocalAmountConverter"/>
            <converters:PrimaryAmountConverter x:Key="PrimaryAmountConverter"/>
            <converters:LocalCurrencySymbolConverter x:Key="LocalCurrencySymbolConverter"/>
            <converters:PrimaryCurrencySymbolConverter x:Key="PrimaryCurrencySymbolConverter"/>
            <converters:LocalCurrencyCodeConverter x:Key="LocalCurrencyCodeConverter"/>
            <converters:PrimaryCurrencyCodeConverter x:Key="PrimaryCurrencyCodeConverter"/>
            <converters:DualOnlyVisibilityConverter x:Key="DualOnlyVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
