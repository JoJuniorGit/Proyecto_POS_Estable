<Window x:Class="Desktop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Desktop.Client.Views"
        xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding Title}" Height="720" Width="1024"
        MinWidth="1024" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
            <views:SalesHistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExchangeRateViewModel}">
            <views:ExchangeRateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CheckoutViewModel}">
            <views:CheckoutDialog/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashDrawerViewModel}">
            <views:CashDrawerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportProductsViewModel}">
            <views:ImportProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersManagementViewModel}">
            <views:UsersManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DailyClosureViewModel}">
            <views:DailyClosureView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingOrdersViewModel}">
            <views:PendingOrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PendingPickupsViewModel}">
            <views:PendingPickupsView/>
        </DataTemplate>
    </Window.Resources>


    <!-- Root: Drawer Host -->
    <materialDesign:DrawerHost>
        
        <materialDesign:DrawerHost.RightDrawerContent>
            <!-- ════════════════════════════════════════
                 SIDEBAR NAVIGATION  (Light Mode)
                 Background + border isolated from app theme
                 ════════════════════════════════════════ -->
            <Border Width="220"
                    Background="{DynamicResource NavBgBrush}"
                    BorderBrush="{DynamicResource NavBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding UserSession.IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>


                <!-- Bottom: current user info & Logout -->
                <Border DockPanel.Dock="Bottom"
                        Padding="12,10"
                        BorderBrush="{DynamicResource NavBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding LogoutCommand}" ToolTip="Cerrar Sesión" Style="{StaticResource MaterialDesignToolButton}" Height="32" Width="32">
                            <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Foreground="#EE5353"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountCircle"
                                                     Width="24" Height="24"
                                                     Foreground="{DynamicResource NavTextMutedBrush}"
                                                     VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserSession.UserName}"
                                           Foreground="{DynamicResource NavTextBrush}"
                                           FontSize="12" FontWeight="Medium"/>
                                <TextBlock Text="{Binding UserSession.UserRoleDisplay}"
                                           Foreground="{DynamicResource NavTextMutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Navigation links -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel>

                        <!-- Section: Main -->
                        <TextBlock Text="MAIN"
                                   Style="{DynamicResource NavSectionHeaderStyle}"/>

                        <!-- POS (Point of Sale) -->
                        <Button x:Name="BtnPos"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToPosCommand}"
                                ToolTip="Point of Sale">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Point of Sale"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section: Inventory -->
                        <TextBlock Text="INVENTORY"
                                   Style="{DynamicResource NavSectionHeaderStyle}"
                                   Margin="16,12,8,4"/>

                        <!-- Products / Catalog -->
                        <Button x:Name="BtnInventory"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToInventoryCommand}"
                                ToolTip="Products &amp; Catalog">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Catalog"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Import Excel -->
                        <Button x:Name="BtnImportProducts"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToImportProductsCommand}"
                                ToolTip="Import Products Excel">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Import Products"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sales History -->
                        <Button x:Name="BtnSalesHistory"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToSalesHistoryCommand}"
                                ToolTip="Sales History">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Sales History"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cash Register -->
                        <Button x:Name="BtnCashDrawer"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToCashDrawerCommand}"
                                ToolTip="Cash Drawer &amp; Register">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PointOfSale"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Register"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cuentas Abiertas -->
                        <Button x:Name="BtnPendingOrders"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToPendingOrdersCommand}"
                                ToolTip="Cuentas Abiertas (Pedidos en Espera)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardClock"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Cuentas Abiertas"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Retiros Pendientes -->
                        <Button x:Name="BtnPendingPickups"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToPendingPickupsCommand}"
                                ToolTip="Retiros Pendientes (Mercancía en Custodia)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PackageCheck"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Retiros Pendientes"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Daily Closing -->
                        <Button x:Name="BtnDailyClosure"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToDailyClosureCommand}"
                                ToolTip="Daily Closing / Cash Count">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalculatorVariant"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Daily Closing"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Section: System -->
                        <TextBlock Text="SYSTEM"
                                   Style="{DynamicResource NavSectionHeaderStyle}"
                                   Margin="16,12,8,4"/>

                        <!-- Users Management (Admin Only) -->
                        <Button x:Name="BtnUsersManagement"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToUsersManagementCommand}"
                                Visibility="{Binding UserSession.IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Gestión de Usuarios (Admin)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Gestión Usuarios"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button x:Name="BtnSettings"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToSettingsCommand}"
                                ToolTip="System Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Settings"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Exchange Rate -->
                        <Button x:Name="BtnExchangeRate"
                                Style="{DynamicResource NavItemButtonStyle}"
                                Command="{Binding NavigateToExchangeRateCommand}"
                                ToolTip="Exchange Rate Configuration">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyUsd"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Exchange Rate"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Border>
        </materialDesign:DrawerHost.RightDrawerContent>

        <!-- ════════════════════════════════════════
             MAIN CONTENT AREA (Wrapped in DialogHost for checkouts)
             ════════════════════════════════════════ -->
        <materialDesign:DialogHost Identifier="RootDialog">
            <!-- The currently active View (e.g. POS or Inventory or Login) -->
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </materialDesign:DialogHost>

    </materialDesign:DrawerHost>
</Window>
