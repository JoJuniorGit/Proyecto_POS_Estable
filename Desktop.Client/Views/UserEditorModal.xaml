<UserControl x:Class="Desktop.Client.Views.UserEditorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="480" d:DesignHeight="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ManagementEditorStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseUserModalCommand}"/>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SaveUserCommand}"/>
    </UserControl.InputBindings>

    <Border Width="480" MaxHeight="720"
            Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="24" ShadowDepth="4"
                              Direction="270" Opacity="0.06"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EDE9FE"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountEdit" Width="19" Height="19" Foreground="#6D28D9"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserModalTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding UserModalSubtitle}" FontSize="11.5" Foreground="#64748B"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource ModalCloseButtonStyle}"
                            Command="{Binding CloseUserModalCommand}" ToolTip="Cerrar">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20">

                    <TextBlock Text="Usuario *" Style="{StaticResource ModalFieldLabelStyle}"/>
                    <Border Style="{StaticResource ModalFieldFrameStyle}" Margin="0,0,0,14">
                        <Grid>
                            <TextBox x:Name="UsernameTextBox"
                                     Text="{Binding Cedula, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModalTextBoxStyle}"
                                     AutomationProperties.AutomationId="UserModal_Username"/>
                            <TextBlock Text="Ej. jdavila" FontSize="12" Foreground="#94A3B8"
                                       Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cedula}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="Nombre y Apellido *" Style="{StaticResource ModalFieldLabelStyle}"/>
                    <Border Style="{StaticResource ModalFieldFrameStyle}" Margin="0,0,0,14">
                        <Grid>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModalTextBoxStyle}"
                                     AutomationProperties.AutomationId="UserModal_Name"/>
                            <TextBlock Text="Ej. Junior Dávila" FontSize="12" Foreground="#94A3B8"
                                       Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Text="Contraseña" Style="{StaticResource ModalFieldLabelStyle}"/>
                    <Border Style="{StaticResource ModalFieldFrameStyle}" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="UserPasswordBox" Grid.Column="0"
                                         Style="{StaticResource ModalPasswordBoxStyle}"
                                         Padding="10,0,38,0"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}"
                                         PasswordChanged="UserPasswordBox_PasswordChanged"/>

                            <TextBox x:Name="UserPasswordTextBox" Grid.Column="0"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModalTextBoxStyle}"
                                     Padding="10,0,38,0"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                            <TextBlock Grid.Column="0" Text="{Binding PasswordPlaceholder}"
                                       FontSize="12" Foreground="#94A3B8"
                                       Margin="12,0,42,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Password}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1" Style="{DynamicResource MaterialDesignToolButton}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Width="30" Height="30" Margin="0,0,5,0" VerticalAlignment="Center"
                                    ToolTip="Mostrar / Ocultar Contraseña">
                                <materialDesign:PackIcon Width="18" Height="18" Foreground="#64748B">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="EyeOutline"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Kind" Value="EyeOffOutline"/>
                                                    <Setter Property="Foreground" Value="#6D28D9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding UserPasswordHelpText}"
                               Style="{StaticResource ModalHelperStyle}" Margin="2,0,0,14"/>

                    <TextBlock Text="Rol del Usuario *" Style="{StaticResource ModalFieldLabelStyle}"/>
                    <Border Style="{StaticResource ModalFieldFrameStyle}" Margin="0,0,0,14">
                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                  SelectedValuePath="Role"
                                  SelectedValue="{Binding Role, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource ModalComboBoxStyle}"
                                  AutomationProperties.AutomationId="UserModal_Role"/>
                    </Border>

                    <Border Style="{StaticResource ModalStatusCardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Usuario Activo" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="Permite iniciar sesión y operar en caja" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="UserModal_ActiveToggle"/>
                        </Grid>
                    </Border>

                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                Margin="0,4,0,0">
                        <TextBlock Text="Acciones de cuenta" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ToggleActiveUserCommand}"
                                    Style="{StaticResource ModalSecondaryButtonStyle}"
                                    Height="34" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="UserModal_ToggleActive">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="AccountCancel"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="False">
                                                        <Setter Property="Kind" Value="AccountCheck"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock VerticalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Desactivar"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Activar"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding HardDeleteUserCommand}"
                                    Style="{StaticResource ModalDangerButtonStyle}"
                                    Height="34"
                                    AutomationProperties.AutomationId="UserModal_Delete">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteForever" Width="15" Height="15"
                                                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Eliminar" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Inline error -->
            <Border Grid.Row="2" Style="{StaticResource ModalErrorBannerStyle}"
                    Visibility="{Binding HasUserModalError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                             Foreground="#B91C1C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding UserModalError}" Foreground="#991B1B" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Los campos con * son obligatorios."
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancelar" Command="{Binding CloseUserModalCommand}"
                                Style="{StaticResource ModalSecondaryButtonStyle}"
                                IsEnabled="{Binding IsUserSaving, Converter={StaticResource InverseBoolConverter}}"
                                Margin="0,0,8,0"/>
                        <Button Command="{Binding SaveUserCommand}"
                                Style="{StaticResource ModalPrimaryButtonStyle}"
                                IsEnabled="{Binding IsUserSaving, Converter={StaticResource InverseBoolConverter}}"
                                AutomationProperties.AutomationId="UserModal_Save">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Crear Usuario"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Guardar Cambios"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUserSaving}" Value="True">
                                                <Setter Property="Text" Value="Guardando..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
