<UserControl x:Class="Desktop.Client.Views.PendingOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             mc:Ignorable="d"
             Background="#F8FAFC"
             d:DesignHeight="820" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:PendingOrdersViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
            <converters:InitialsConverter x:Key="InitialsConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DropShadowEffect x:Key="PendingCardShadow"
                              Color="#0F172A"
                              BlurRadius="12"
                              Opacity="0.03"
                              Direction="270"
                              ShadowDepth="2"/>

            <DropShadowEffect x:Key="PendingMenuShadow"
                              Color="#0F172A"
                              BlurRadius="14"
                              Opacity="0.10"
                              Direction="270"
                              ShadowDepth="2"/>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsThinScrollBarStyle}"/>

            <Style x:Key="PendingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Effect" Value="{StaticResource PendingCardShadow}"/>
            </Style>

            <Style x:Key="PendingSearchFrameStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#6D28D9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PendingColumnHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource SettingsTableHeaderStyle}">
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="PendingRightColumnHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource PendingColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                <Setter Property="Padding" Value="12,10,16,10"/>
            </Style>

            <Style x:Key="PendingRowStyle" TargetType="DataGridRow"
                   BasedOn="{StaticResource SettingsTableRowStyle}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F5F3FF"/>
                        <Setter Property="BorderBrush" Value="#6D28D9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PendingCellStyle" TargetType="DataGridCell"
                   BasedOn="{StaticResource SettingsTableCellStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <Style x:Key="PendingPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#6D28D9"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PrimaryBorder" Property="Background" Value="#5B21B6"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PrimaryBorder" Property="Background" Value="#4C1D95"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PrimaryBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PendingSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SecondaryBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SecondaryBorder" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PendingMoreButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MoreBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MoreBorder" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="MoreBorder" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PendingMenuItemStyle" TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="#F5F3FF"/>
                                    <Setter Property="Foreground" Value="#6D28D9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PendingDangerMenuItemStyle" TargetType="MenuItem"
                   BasedOn="{StaticResource PendingMenuItemStyle}">
                <Setter Property="Foreground" Value="#DC2626"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PendingContextMenuStyle" TargetType="ContextMenu">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="MinWidth" Value="175"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    Effect="{StaticResource PendingMenuShadow}"
                                    SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="6,4"/>
                <Setter Property="Background" Value="#F1F5F9"/>
            </Style>

            <DataTemplate x:Key="ExpandedRowTemplate">
                <Border Background="#FFFFFF" CornerRadius="0,0,8,8" Padding="24,18"
                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="16" Height="16"
                                                         Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Text="PRODUCTOS DEL PEDIDO" FontWeight="Bold" FontSize="11"
                                           Margin="6,0,0,0" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                       FontSize="12" Foreground="#1E293B"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0:0.###}'}"
                                                       FontSize="12" HorizontalAlignment="Right" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UnitPriceBsS, Converter={StaticResource LocalAmountConverter}}"
                                                       FontSize="12" HorizontalAlignment="Right" FontWeight="Medium"
                                                       Foreground="#475569" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SubtotalBsS, Converter={StaticResource LocalAmountConverter}}"
                                                       FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="#EDE9FE"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22"
                                             Foreground="#6D28D9"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Pedidos Guardados"
                               AutomationProperties.AutomationId="PendingOrders_Title"
                               FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Gestión de abonos y liquidaciones de pedidos pendientes de pago."
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="PendingOrders_RefreshButton"
                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                        Height="38" Padding="14,0" Margin="0,0,8,0"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                        materialDesign:ButtonProgressAssist.Value="-1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Refrescar" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarMenuButtonStyle}"
                        Width="38" Height="38" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Style="{StaticResource PendingCardStyle}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PendingSearchFrameStyle}"
                            MinWidth="380" MaxWidth="460" HorizontalAlignment="Left" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                                     Foreground="#94A3B8" VerticalAlignment="Center"
                                                     Margin="10,0,2,0"/>
                            <Grid Grid.Column="1">
                                <TextBox AutomationProperties.AutomationId="PendingOrders_SearchInput"
                                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" FontSize="13"
                                         Foreground="#0F172A" Padding="6,0,4,0"/>
                                <TextBlock Text="Buscar por cliente, cédula/RIF o N° de pedido..."
                                           IsHitTestVisible="False" FontSize="13" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Content="×"
                                    Command="{Binding ClearSearchCommand}"
                                    Style="{StaticResource SettingsBareButtonStyle}"
                                    Width="26" Height="26" Margin="0,0,3,0"
                                    FontSize="16" Foreground="#64748B"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                                    ToolTip="Limpiar búsqueda"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#F5F3FF" BorderBrush="#DDD6FE"
                            BorderThickness="1" CornerRadius="8" Padding="10,6"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding PendingCount, StringFormat='En espera: {0}'}"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#5B21B6"/>
                    </Border>

                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="8" Padding="10,6"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="11.5" Foreground="#0F172A">
                                <Run Text="Total acumulado: "/>
                                <Run Text="{Binding FilteredTotalLocal, Converter={StaticResource LocalAmountConverter}, Mode=OneWay}"
                                     FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock FontSize="11.5" Foreground="#64748B" Margin="5,0,0,0"
                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}">
                                <Run Text="· "/>
                                <Run Text="{Binding FilteredTotalUsd, Converter={StaticResource PrimaryAmountConverter}, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#ECFDF5" BorderBrush="#A7F3D0"
                            BorderThickness="1" CornerRadius="8" Padding="12,6"
                            VerticalAlignment="Center"
                            Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}">
                        <TextBlock FontSize="11.5" Foreground="#047857" VerticalAlignment="Center">
                            <Run Text="Tasa BCV: "/>
                            <Run Text="{Binding ExchangeRateDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencyDisplayCode, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyDisplayCode, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>

                <Border Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"
                        Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="17" Height="17"
                                                 Foreground="#166534" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SuccessMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#166534" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- GRID CARD -->
        <Border Grid.Row="2" Style="{StaticResource PendingCardStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <DataGrid x:Name="PendingOrdersGrid" ItemsSource="{Binding FilteredPendingSales}"
                              AutomationProperties.AutomationId="PendingOrders_DataGrid"
                              SizeChanged="PendingOrdersGrid_SizeChanged"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single"
                              Background="#FFFFFF" BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              RowDetailsVisibilityMode="VisibleWhenSelected"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              VerticalGridLinesBrush="Transparent"
                              HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource PendingColumnHeaderStyle}"
                              RowStyle="{StaticResource PendingRowStyle}"
                              CellStyle="{StaticResource PendingCellStyle}"
                              RowHeight="56"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource ExpandedRowTemplate}"/>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="PEDIDO / FECHA" Width="165" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id, StringFormat='Pedido #{0}'}"
                                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yy · HH:mm}'}"
                                                       FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn x:Name="CustomerColumn" Header="CLIENTE" Width="*" MinWidth="260" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                    Background="#F1F5F9" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName, Converter={StaticResource InitialsConverter}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#334155" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName, Converter={StaticResource TitleCaseConverter}}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CustomerName}"/>
                                                <TextBlock Text="{Binding CustomerCedula}" FontSize="11.5"
                                                           Foreground="#64748B" Margin="0,2,0,0"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TOTAL FACTURA" Width="185" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource PendingRightColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalBsS, Converter={StaticResource LocalAmountConverter}}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                                       HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding EffectiveTotalUSD, Converter={StaticResource PrimaryAmountConverter}}"
                                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                                       FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"
                                                       Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ACCIONES" Width="155" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource PendingRightColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Button Content="Cobrar"
                                                    Command="{Binding Data.LiquidarAbonarCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.AutomationId="PendingOrders_CheckoutButton"
                                                    Style="{StaticResource PendingPrimaryButtonStyle}"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="MoreActionsButton"
                                                    Content="⋯"
                                                    AutomationProperties.AutomationId="PendingOrders_MoreActions"
                                                    Tag="{Binding Data, Source={StaticResource Proxy}}"
                                                    Style="{StaticResource PendingMoreButtonStyle}"
                                                    ToolTip="Más opciones"
                                                    Click="MoreActionsButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource PendingContextMenuStyle}"
                                                                 Placement="Bottom"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Command="{Binding PlacementTarget.Tag.EditarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"
                                                                  AutomationProperties.AutomationId="PendingOrders_EditAction">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource PendingMenuItemStyle}"/>
                                                            </MenuItem.Style>
                                                            <MenuItem.Header>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                                                    <TextBlock Text="Editar pedido" Margin="9,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                                                </StackPanel>
                                                            </MenuItem.Header>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Command="{Binding PlacementTarget.Tag.AnularPedidoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"
                                                                  AutomationProperties.AutomationId="PendingOrders_CancelAction">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource PendingDangerMenuItemStyle}"/>
                                                            </MenuItem.Style>
                                                            <MenuItem.Header>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16"
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                                                    <TextBlock Text="Anular pedido" Margin="9,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                                                </StackPanel>
                                                            </MenuItem.Header>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                          Background="#70FFFFFF">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                         Foreground="#6D28D9" IsIndeterminate="True"
                                         Width="44" Height="44"/>
                            <TextBlock Text="Cargando pedidos..." Foreground="#475569"
                                       FontWeight="SemiBold" Margin="0,12,0,0" FontSize="13"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9"
                                HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="28" Height="28"
                                                     Foreground="#CBD5E1"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyStateSubtitle}" FontSize="12" Foreground="#94A3B8"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- FOOTER -->
                <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#F1F5F9"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,12,12"
                        Padding="16,10">
                    <Grid>
                        <TextBlock Text="{Binding VisibleCountText}" FontSize="11.5"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Total filtrado: " FontSize="11.5" Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FilteredTotalLocal, Converter={StaticResource LocalAmountConverter}}"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FilteredTotalUsd, Converter={StaticResource PrimaryAmountConverter}}"
                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                       FontSize="11.5" Foreground="#64748B" Margin="6,0,0,0"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- LOAD MORE -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
            <Button Content="Cargar más pedidos"
                    Command="{Binding LoadMoreCommand}"
                    Style="{StaticResource SettingsSecondaryButtonStyle}"
                    Height="36" Padding="20,0" FontSize="12" FontWeight="SemiBold"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoadingMore}"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                    materialDesign:ButtonProgressAssist.Value="-1"/>
        </StackPanel>
    </Grid>
</UserControl>
