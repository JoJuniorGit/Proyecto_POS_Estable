<Window x:Class="Desktop.Client.Views.PairingQrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Vincular Dispositivo Móvil / Terminal Auxiliar" 
        Height="540" Width="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border CornerRadius="14" 
            Background="{DynamicResource MaterialDesignPaper}" 
            BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
            BorderThickness="1.5"
            Effect="{DynamicResource MaterialDesignShadowDepth4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="12,12,0,0" Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="QrcodeScan" Width="26" Height="26" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="VINCULAR DISPOSITIVO MÓVIL / COMANDERA" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="White" Width="36" Height="36" Padding="0" Click="Close_Click">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area (Dual Column) -->
            <Grid Grid.Row="1" Margin="24,18,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: QR Code & Quick Scan -->
                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCard}" 
                        CornerRadius="10" Padding="16" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ESCANEO RÁPIDO" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- QR Code Container -->
                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="#E2E8F0" BorderThickness="1" Width="220" Height="220">
                            <Image x:Name="QrImageControl" Stretch="Uniform"/>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Apunta con la cámara de tu celular o tablet para abrir el POS." 
                                   FontSize="11" Foreground="{DynamicResource NavTextMutedBrush}" 
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,8"/>

                        <!-- Interface Selector -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Adaptador de Red:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NavTextMutedBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableInterfaces}" 
                                      SelectedItem="{Binding SelectedInterface}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="11" Margin="0,2,0,0"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Width="1" Fill="#20808080" HorizontalAlignment="Center" Margin="0,10"/>

                <!-- Right Column: Manual Connection Details -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DATOS PARA CONEXIÓN MANUAL" FontWeight="Bold" FontSize="13" 
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Hostname -->
                            <Border Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ServerNetwork" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nombre del Servidor / Hostname" FontSize="10" Foreground="{DynamicResource NavTextMutedBrush}"/>
                                        <TextBlock Text="{Binding ServerName}" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- IP Address with Copy -->
                            <Border Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="IpNetwork" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Dirección IP Local" FontSize="10" Foreground="{DynamicResource NavTextMutedBrush}"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding CopyIpCommand}" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                                            Height="28" Padding="8,0" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Copiar IP"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Port -->
                            <Border Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="LanConnect" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Puerto de Servicio HTTP" FontSize="10" Foreground="{DynamicResource NavTextMutedBrush}"/>
                                        <TextBlock Text="{Binding HttpPort, StringFormat='{}{0} (Predeterminado)'}" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Full URL with Copy -->
                            <Border Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Web" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="URL Completa para Navegador" FontSize="10" Foreground="{DynamicResource NavTextMutedBrush}"/>
                                        <TextBlock Text="{Binding FullUrl}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Command="{Binding CopyUrlCommand}" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" 
                                            Height="32" Padding="10,0" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Copiar URL"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Wi-Fi Alert Box -->
                            <Border Background="#150080FF" BorderBrush="#0080FF" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#0080FF" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                    <TextBlock Text="Asegúrese de que el celular o terminal esté conectado a la misma red Wi-Fi que esta caja." 
                                               FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" MaxWidth="360"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Cerrar" Width="100" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
