<Window x:Class="Desktop.Client.Views.PettyCashExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
        xmlns:converters="clr-namespace:Desktop.Client.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PettyCashExpenseDialogViewModel}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Registrar Gasto de Caja Chica"
        Height="700" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Registrar Gasto de Caja Chica" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="La tasa BCV y la valoración bimonetaria las fija el servidor al confirmar."
                               FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SESIÓN DE CAJA" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SessionId, StringFormat='#{0}'}" FontSize="15" FontWeight="Bold"
                               Foreground="#15803D" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              AutomationProperties.AutomationId="PettyCashExpense_CurrencyCombo"
                              ItemsSource="{Binding CurrencyOptions}"
                              SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              materialDesign:HintAssist.Hint="Moneda de extracción física"
                              Style="{DynamicResource MaterialDesignFloatingHintComboBox}"/>

                    <StackPanel Grid.Column="2">
                        <TextBox AutomationProperties.AutomationId="PettyCashExpense_AmountInput"
                                 Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{Binding AmountHint}"
                                 Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                                 FontWeight="Bold" FontSize="16"
                                 HorizontalContentAlignment="Right"/>
                        <TextBlock Text="{Binding EquivalentDisplay}"
                                   AutomationProperties.AutomationId="PettyCashExpense_EquivalentText"
                                   FontSize="11" Foreground="#475569"
                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <ComboBox AutomationProperties.AutomationId="PettyCashExpense_CategoryCombo"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          materialDesign:HintAssist.Hint="Categoría operativa"
                          Style="{DynamicResource MaterialDesignFloatingHintComboBox}"
                          Margin="0,0,0,14"/>

                <TextBox AutomationProperties.AutomationId="PettyCashExpense_ConceptInput"
                         Text="{Binding Concept, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Concepto detallado del gasto"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="76" VerticalContentAlignment="Top"
                         Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             AutomationProperties.AutomationId="PettyCashExpense_BeneficiaryInput"
                             Text="{Binding Beneficiary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Beneficiario o proveedor"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             MaxLength="150"/>

                    <TextBox Grid.Column="2"
                             AutomationProperties.AutomationId="PettyCashExpense_ReferenceInput"
                             Text="{Binding ReferenceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Referencia del comprobante"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             MaxLength="100"/>
                </Grid>

                <TextBlock Text="{Binding ValidationMessage}"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVis}}"
                           Foreground="#B45309" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="2,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           AutomationProperties.AutomationId="PettyCashExpense_ErrorText"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                           Foreground="#B91C1C" TextWrapping="Wrap" Margin="2,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie de página -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCELAR"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="PettyCashExpense_CancelButton"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    Height="40" Padding="18,0" Margin="0,0,10,0"/>
            <Button Content="REGISTRAR GASTO"
                    Command="{Binding ConfirmCommand}"
                    AutomationProperties.AutomationId="PettyCashExpense_ConfirmButton"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Background="#15803D" Foreground="White"
                    Height="40" Padding="22,0" FontWeight="Bold"
                    IsDefault="True"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsProcessing}"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                    materialDesign:ButtonProgressAssist.Value="-1"/>
        </StackPanel>
    </Grid>
</Window>
