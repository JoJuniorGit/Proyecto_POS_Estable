<UserControl x:Class="Desktop.Client.Views.StockCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockCountViewModel}"
             Background="#F1F5F9"
             d:DesignHeight="760" d:DesignWidth="1180">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="10"
                          Opacity="0.05"
                          Direction="270"
                          ShadowDepth="2"/>

        <Style x:Key="ScCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource EnterpriseCardShadow}"/>
        </Style>

        <Style x:Key="ScSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ScFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ScHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ScGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="StockCount_RefreshButton"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            BorderBrush="#CBD5E1"
                            Foreground="#475569"
                            Height="36" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="Recargar sesiones">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                            CommandParameter="{x:Static Dock.Right}"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            ToolTip="Abrir Menú Principal"
                            Height="36" Width="36">
                        <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" Foreground="#475569"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardListOutline" Width="28" Height="28" Foreground="#5E35B1" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Conteo Físico"
                                   AutomationProperties.AutomationId="StockCount_Title"
                                   FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="Conteo ciego por escáner: producto y cantidad contada. El descuadre se revisa al cerrar la sesión."
                                   FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Error de carga / acceso -->
            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Nueva sesión -->
            <Border Style="{StaticResource ScCardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding IsCreatePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Nueva sesión de conteo" Style="{StaticResource ScSectionTitleStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Nombre" Style="{StaticResource ScFieldLabelStyle}"/>
                            <TextBox Text="{Binding CreateName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="StockCount_CreateName"
                                     materialDesign:HintAssist.Hint="Ej: Conteo octubre 2026"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     MaxLength="80" Height="42" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Alcance" Style="{StaticResource ScFieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding CreateScopeCategory, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.AutomationId="StockCount_CreateScope"
                                      materialDesign:HintAssist.Hint="Todo el inventario o una categoría"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                      Height="42" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Notas (opcional)" Style="{StaticResource ScFieldLabelStyle}"/>
                            <TextBox Text="{Binding CreateNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="StockCount_CreateNotes"
                                     materialDesign:HintAssist.Hint="Observaciones de la sesión"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     MaxLength="300" Height="42" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CreateError}"
                               Visibility="{Binding HasCreateError, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="#B91C1C" FontSize="12" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancelar" Command="{Binding CancelCreateCommand}"
                                AutomationProperties.AutomationId="StockCount_CreateCancel"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="34" Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="Crear sesión" Command="{Binding SubmitCreateCommand}"
                                AutomationProperties.AutomationId="StockCount_CreateSubmit"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Height="34" Padding="16,0"
                                IsEnabled="{Binding CanCreateSession}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Listado de sesiones -->
            <Border Style="{StaticResource ScCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding SelectedStatusOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.AutomationId="StockCount_StatusFilter"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                      Width="150" Height="36" FontSize="12" Margin="0,0,8,0"/>
                            <Button Content="Nueva sesión"
                                    Command="{Binding OpenCreatePanelCommand}"
                                    AutomationProperties.AutomationId="StockCount_CreateButton"
                                    Style="{DynamicResource MaterialDesignRaisedButton}"
                                    Height="36" Padding="14,0"
                                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="Sesiones de conteo" Style="{StaticResource ScSectionTitleStyle}"/>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding Sessions}"
                              AutomationProperties.AutomationId="StockCount_SessionGrid"
                              Style="{StaticResource ScGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="*" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTemplateColumn Header="ESTADO" Width="120" HeaderStyle="{StaticResource ScHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground}" CornerRadius="10"
                                                Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ALCANCE" Binding="{Binding ScopeDisplay}" Width="200" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTextColumn Header="ÍTEMS" Binding="{Binding ItemsCount}" Width="70" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTextColumn Header="CREADA" Binding="{Binding CreatedAtText}" Width="145" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTemplateColumn Header="" Width="80" HeaderStyle="{StaticResource ScHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Abrir"
                                                AutomationProperties.AutomationId="StockCount_SessionOpenButton"
                                                Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource MaterialDesignFlatButton}"
                                                Height="28" Padding="8,0" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No hay sesiones de conteo registradas."
                               Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="#64748B" FontSize="12" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Detalle de sesión -->
            <Border Style="{StaticResource ScCardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding HasSelectedSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Volver" Command="{Binding BackToSessionsCommand}"
                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                    Height="32" Padding="12,0" Margin="0,0,8,0"/>
                            <Button Content="Actualizar" Command="{Binding RefreshDetailCommand}"
                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                    Height="32" Padding="12,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSession.Name}" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border Background="{Binding SelectedSession.StatusBackground}" CornerRadius="10"
                                    Padding="8,2" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSession.StatusLabel}"
                                           Foreground="{Binding SelectedSession.StatusColor}" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedSession.ScopeDisplay}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Escaneo -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding SelectedSessionIsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="StockCount_ScanInput"
                                 materialDesign:HintAssist.Hint="Escanea o escribe el SKU / código de barras y presiona Enter"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 Height="42" FontSize="13" Margin="0,0,8,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Contar"
                                Command="{Binding ScanCommand}"
                                AutomationProperties.AutomationId="StockCount_ScanButton"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Height="42" Padding="18,0"
                                IsEnabled="{Binding CanScan}"/>
                    </Grid>

                    <TextBlock Text="{Binding ScanFeedback}"
                               Visibility="{Binding HasScanFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{Binding ScanFeedbackColor}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <DataGrid ItemsSource="{Binding Items}"
                              AutomationProperties.AutomationId="StockCount_ItemsGrid"
                              Style="{StaticResource ScGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTextColumn Header="CONTADO" Binding="{Binding CountedQuantityText}" Width="100" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTextColumn Header="ACTUALIZADO" Binding="{Binding UpdatedAtText}" Width="145" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                            <DataGridTemplateColumn Header="ACCIONES" Width="250" HeaderStyle="{StaticResource ScHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-"
                                                    Command="{Binding DataContext.DecreaseItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEditItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    Height="26" Width="28" Padding="0" Margin="0,0,2,0"
                                                    ToolTip="Restar una unidad"/>
                                            <Button Content="+"
                                                    Command="{Binding DataContext.IncreaseItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEditItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    Height="26" Width="28" Padding="0" Margin="0,0,6,0"
                                                    ToolTip="Sumar una unidad"/>
                                            <Button Content="Editar"
                                                    Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEditItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    Height="26" Padding="8,0" FontSize="11" Margin="0,0,2,0"/>
                                            <Button Content="Quitar"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEditItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    Foreground="#B91C1C"
                                                    Height="26" Padding="8,0" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Aún no hay ítems contados. Escanee el primer producto."
                               Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="#64748B" FontSize="12" Margin="0,14,0,0"/>

                    <TextBlock Text="{Binding ActionFeedback}"
                               Visibility="{Binding HasActionFeedback, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="#047857" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>

                    <!-- Descuadre (solo Admin/Manager) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,14,0,0"
                            Visibility="{Binding ShowReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Actualizar descuadre"
                                        Command="{Binding LoadReviewCommand}"
                                        AutomationProperties.AutomationId="StockCount_ReviewButton"
                                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                                        Height="30" Padding="12,0" FontSize="11"/>
                                <TextBlock Text="Descuadre (Admin/Manager)" Style="{StaticResource ScSectionTitleStyle}"/>
                            </DockPanel>

                            <TextBlock Text="Teórico EN VIVO (sesión abierta): los valores pueden cambiar hasta cerrar la sesión."
                                       Visibility="{Binding Review.TheoreticalIsPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="#B45309" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="SOBRANTES" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Review.TotalSurplusValueUsd, StringFormat={}{0:N2}}"
                                               FontSize="16" FontWeight="Bold" Foreground="#047857"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="FALTANTES" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Review.TotalShortageValueUsd, StringFormat={}{0:N2}}"
                                               FontSize="16" FontWeight="Bold" Foreground="#B91C1C"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="NETO" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Review.NetValueUsd, StringFormat={}{0:N2}}"
                                               FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="NO ESCANEADOS" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Review.UnscannedInScopeCount}"
                                               FontSize="16" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                            </UniformGrid>

                            <DataGrid ItemsSource="{Binding ReviewItems}"
                                      AutomationProperties.AutomationId="StockCount_ReviewGrid"
                                      Style="{StaticResource ScGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                    <DataGridTextColumn Header="CONTADO" Binding="{Binding CountedText}" Width="90" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                    <DataGridTextColumn Header="TEÓRICO" Binding="{Binding TheoreticalText}" Width="90" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                    <DataGridTextColumn Header="Δ" Binding="{Binding DifferenceText}" Width="90" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                    <DataGridTextColumn Header="COSTO" Binding="{Binding UnitCostText}" Width="90" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                    <DataGridTextColumn Header="VALOR Δ" Binding="{Binding DifferenceValueText}" Width="100" HeaderStyle="{StaticResource ScHeaderStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Acciones de sesión -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Cerrar conteo"
                                Command="{Binding CloseCommand}"
                                AutomationProperties.AutomationId="StockCount_CloseButton"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Height="34" Padding="16,0" Margin="0,0,8,0"
                                Visibility="{Binding SelectedSessionIsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{Binding CanClose}"/>
                        <Button Content="Aplicar ajustes"
                                Command="{Binding ApplyCommand}"
                                AutomationProperties.AutomationId="StockCount_ApplyButton"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Height="34" Padding="16,0" Margin="0,0,8,0"
                                Visibility="{Binding SelectedSessionIsClosed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{Binding CanApply}"/>
                        <Button Content="Cancelar sesión"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="StockCount_CancelButton"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Foreground="#B91C1C"
                                Height="34" Padding="16,0"
                                Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                IsEnabled="{Binding CanCancel}"/>
                    </StackPanel>

                    <TextBlock Text="Esta sesión es terminal: no admite más escaneos, ediciones ni ajustes."
                               Visibility="{Binding SelectedSessionIsTerminal, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="#64748B" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
