<Window x:Class="Desktop.Client.Views.RegisterSupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Desktop.Client.Converters"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Registrar proveedor"
        Height="340" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=RifTextBox}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Registrar proveedor"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                       FontWeight="Bold"/>
            <TextBlock Text="Complete la identidad fiscal del proveedor para habilitar la revisión de sus facturas."
                       Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- FORM -->
        <StackPanel Grid.Row="1">
            <TextBox x:Name="RifTextBox"
                     Text="{Binding RifOrNit, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="RIF / NIT"
                     materialDesign:HintAssist.IsFloating="True"
                     TabIndex="1"/>
            <TextBlock Text="Opcional; se normaliza como identidad fiscal del proveedor."
                       Foreground="#64748B" FontSize="11" Margin="4,4,0,12"/>

            <TextBox Text="{Binding CommercialName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Nombre comercial *"
                     materialDesign:HintAssist.IsFloating="True"
                     TabIndex="2"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="4,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
        </StackPanel>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Margin="0,0,15,0"
                    TabIndex="4"/>
            <Button Content="Registrar"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    TabIndex="3"/>
        </StackPanel>
    </Grid>
</Window>
