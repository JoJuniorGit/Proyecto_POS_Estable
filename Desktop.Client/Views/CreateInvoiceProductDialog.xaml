<Window x:Class="Desktop.Client.Views.CreateInvoiceProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Desktop.Client.Converters"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Crear producto desde factura"
        Height="440" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=BarcodeTextBox}">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Crear producto desde factura"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                       FontWeight="Bold"/>
            <TextBlock Text="Capture el código de barras universal del producto físico. No se hereda el código del proveedor."
                       Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- FORM -->
        <StackPanel Grid.Row="1">
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CostInfo}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBox x:Name="BarcodeTextBox"
                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Código de barras EAN/UPC *"
                     materialDesign:HintAssist.IsFloating="True"
                     Loaded="BarcodeTextBox_Loaded"
                     TabIndex="1"/>
            <TextBlock Text="Escanee o digite entre 8 y 14 dígitos numéricos."
                       Foreground="#64748B" FontSize="11" Margin="4,4,0,12"/>

            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Nombre del producto *"
                     materialDesign:HintAssist.IsFloating="True"
                     TabIndex="2"/>
            <TextBlock Text="Máximo 100 caracteres."
                       Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="4,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
        </StackPanel>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Margin="0,0,15,0"
                    TabIndex="4"/>
            <Button Content="Guardar"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    TabIndex="3"/>
        </StackPanel>
    </Grid>
</Window>
