<UserControl x:Class="Desktop.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Desktop.Client.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SettingsSectionTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E8F0FE" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,15,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TÍTULO PRINCIPAL & BANNER PERMISOS -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Configuración del Sistema"
                               AutomationProperties.AutomationId="Settings_Title"
                               Style="{DynamicResource MaterialDesignHeadline4TextBlock}"
                               FontWeight="Bold" />
                    <TextBlock Text="Gestione las preferencias globales, conectividad de red, zona horaria y los métodos de pago aceptados."
                               Style="{DynamicResource MaterialDesignBody1TextBlock}"
                               Opacity="0.7"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        ToolTip="Abrir Menú Principal"
                        Height="38"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CogOutline"
                                                 Width="20" Height="20"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0" />
                        <TextBlock Text="Menú" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Visibility="{Binding UserSession.CanMutateSettings, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="LockOutline"
                                             Foreground="#D97706"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                    <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios de configuración están bloqueados."
                               Foreground="#B45309"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedSettingsSectionIndex, Mode=TwoWay}"
                    TabStripPlacement="Left"
                    ItemContainerStyle="{StaticResource SettingsSectionTabItem}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    KeyboardNavigation.DirectionalNavigation="Cycle"
                    KeyboardNavigation.TabNavigation="Cycle">

            <!-- APARTADO 1: MONEDA, TASAS Y FORMATO -->
            <TabItem Header="Moneda, Tasas y Formato"
                     AutomationProperties.AutomationId="Settings_Section_Currency">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,0,0" AutomationProperties.AutomationId="Settings_SectionContent_Currency">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CurrencyUsd"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock Text="Formato Numérico y de Moneda"
                                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Seleccione el estándar de formato y visualización para montos monetarios en todo el sistema."
                                           Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.7"
                                           Margin="34,0,0,14" />

                                <Grid Margin="34,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="340" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableCurrencyFormats}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedCurrencyFormat, Mode=TwoWay}"
                                              IsEnabled="{Binding UserSession.CanMutateSettings}"
                                              materialDesign:HintAssist.Hint="Seleccionar Formato de Moneda"
                                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                              VerticalAlignment="Center" />

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource MaterialDesignBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="EyeOutline"
                                                                     Width="18" Height="18"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="Vista Previa en Vivo: "
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding CurrencyFormatPreviewBsS}"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas, Monospace"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding CurrencyFormatPreviewUSD}"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas, Monospace"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CurrencyUsd"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock Text="Políticas de Precios y Redondeo"
                                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Reglas globales que precargan los selectores de redondeo al crear/editar productos, editar precios en masa y resolver facturas de proveedor. El auto-guardado persiste los tres valores juntos."
                                           Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.7"
                                           Margin="34,0,0,14" />

                                <Grid Margin="34,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="300" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" MinWidth="300" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding UsdRoundingOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedUsdRoundingRule, Mode=TwoWay}"
                                              IsEnabled="{Binding UserSession.CanMutateSettings}"
                                              materialDesign:HintAssist.Hint="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='Redondeo {0} (Detal/Mayor)'}"
                                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                              AutomationProperties.AutomationId="Settings_UsdRoundingCombo"
                                              VerticalAlignment="Center" />

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding CashBsRoundingOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedCashBsRoundingRule, Mode=TwoWay}"
                                              IsEnabled="{Binding UserSession.CanMutateSettings}"
                                              materialDesign:HintAssist.Hint="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencySymbol, StringFormat='Redondeo efectivo {0} (proyección)'}"
                                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                              AutomationProperties.AutomationId="Settings_CashRoundingCombo"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Protección de piso de margen" FontWeight="SemiBold" />
                                        <TextBlock Text="Si se activa, el redondeo de precios nunca baja del margen objetivo del canal (protege la rentabilidad al aplicar reglas psicológicas o de efectivo)."
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding EnforceMinimumMarginFloor, Mode=TwoWay}"
                                                  IsEnabled="{Binding UserSession.CanMutateSettings}"
                                                  AutomationProperties.AutomationId="Settings_MarginFloorToggle"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- APARTADO 2: MÉTODOS DE PAGO Y CAJA -->
            <TabItem Header="Métodos de Pago y Caja"
                     AutomationProperties.AutomationId="Settings_Section_Payments">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,0,0" AutomationProperties.AutomationId="Settings_SectionContent_Payments">

                    <!-- Parámetros operativos de caja: comisiones de adelanto -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashMultiple"
                                                         Width="22" Height="22"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0" />
                                <TextBlock Text="Comisiones de Adelanto de Efectivo"
                                           Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="32,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Transferencia / Pago Móvil (%)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding TransferCommissionText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="Settings_TransferCommissionInput"
                                             IsEnabled="{Binding UserSession.CanMutateSettings}"
                                             materialDesign:HintAssist.Hint="Ej: 7"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                             MinHeight="48"
                                             VerticalContentAlignment="Center"
                                             FontSize="13" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Efectivo (%)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CashCommissionText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="Settings_CashCommissionInput"
                                             IsEnabled="{Binding UserSession.CanMutateSettings}"
                                             materialDesign:HintAssist.Hint="Ej: 5"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                             MinHeight="48"
                                             VerticalContentAlignment="Center"
                                             FontSize="13" />
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding CashAdvanceCommissionStatus}"
                                           Visibility="{Binding HasCashAdvanceCommissionStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Foreground="#475569"
                                           FontSize="12"
                                           Margin="14,22,14,0"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="4"
                                        Content="Guardar comisiones"
                                        Command="{Binding SaveCashAdvanceCommissionCommand}"
                                        AutomationProperties.AutomationId="Settings_SaveCashAdvanceCommissionButton"
                                        IsEnabled="{Binding UserSession.CanMutateSettings}"
                                        Style="{DynamicResource MaterialDesignRaisedButton}"
                                        Height="36"
                                        Padding="16,0"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Tabla de métodos de pago -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CreditCardOutline"
                                                                 Width="24" Height="24"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" />
                                        <TextBlock Text="Métodos de Pago Aceptados"
                                                   Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Configure la lista de métodos de pago, renómbrelos o reordénelos según la prioridad en el Punto de Venta (POS)."
                                               Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                               Opacity="0.7"
                                               Margin="34,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding AddNewMethodCommand}"
                                            IsEnabled="{Binding UserSession.CanMutateSettings}"
                                            Style="{DynamicResource MaterialDesignRaisedButton}"
                                            Height="38"
                                            Padding="14,0"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus"
                                                                     Width="20" Height="20"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,6,0" />
                                            <TextBlock Text="Nuevo Método" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding LoadMethodsCommand}"
                                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                                            ToolTip="Recargar Lista"
                                            Height="38" Width="38" Padding="0">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                                    </Button>

                                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                                 Value="0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                 Margin="10,0,0,0"
                                                 Width="20" Height="20" />
                                </StackPanel>
                            </Grid>

                            <controls:PerformantDataGrid Grid.Row="1"
                                                         ItemsSource="{Binding PaymentMethods}"
                                                         AutomationProperties.AutomationId="Settings_PaymentMethodsGrid"
                                                         AutoGenerateColumns="False"
                                                         CanUserAddRows="False"
                                                         CanUserDeleteRows="False"
                                                         GridLinesVisibility="Horizontal"
                                                         HeadersVisibility="Column"
                                                         ColumnHeaderHeight="40"
                                                         RowHeight="44"
                                                         MinHeight="360"
                                                         BorderThickness="1"
                                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                         Background="Transparent">
                                <controls:PerformantDataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:PerformantDataGrid.RowStyle>

                                <controls:PerformantDataGrid.Columns>
                                    <DataGridTemplateColumn Header="Orden" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            Style="{DynamicResource MaterialDesignIconButton}"
                                                            ToolTip="Subir Posición"
                                                            AutomationProperties.Name="Subir posición del método"
                                                            Width="26" Height="26" Padding="0">
                                                        <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16" />
                                                    </Button>

                                                    <Button Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            Style="{DynamicResource MaterialDesignIconButton}"
                                                            ToolTip="Bajar Posición"
                                                            AutomationProperties.Name="Bajar posición del método"
                                                            Width="26" Height="26" Padding="0">
                                                        <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Nombre del Método" Width="*" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,8,0" />

                                                    <Button Command="{Binding DataContext.RenameMethodCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            Style="{DynamicResource MaterialDesignIconButton}"
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                            ToolTip="Renombrar Método"
                                                            AutomationProperties.Name="Renombrar método de pago"
                                                            Width="26" Height="26" Padding="0">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Tipo" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.TogglePaymentTypeCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                        ToolTip="Clic para alternar entre Físico y Digital"
                                                        Padding="8,3"
                                                        Height="28"
                                                        Cursor="Hand"
                                                        BorderThickness="1">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                            <Setter Property="Background" Value="#F1F5F9" />
                                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                            <Setter Property="Foreground" Value="#475569" />
                                                            <Setter Property="AutomationProperties.Name" Value="Método Digital. Clic para cambiar a Físico." />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCash}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                    <Setter Property="Foreground" Value="#166534" />
                                                                    <Setter Property="AutomationProperties.Name" Value="Método Físico. Clic para cambiar a Digital." />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="CreditCardOutline" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCash}" Value="True">
                                                                            <Setter Property="Kind" Value="CashMultiple" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="DIGITAL" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCash}" Value="True">
                                                                            <Setter Property="Text" Value="EFECTIVO" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Moneda" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9"
                                                        CornerRadius="4"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Currency}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Foreground="#475569" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Requiere Referencia" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding RequiresReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Command="{Binding DataContext.UpdateReferenceRequirementCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                          HorizontalAlignment="Center"
                                                          Margin="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Estado Activo" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Command="{Binding DataContext.SetActiveStatusCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                          ToolTip="Activar o desactivar este método en el POS"
                                                          HorizontalAlignment="Center"
                                                          Margin="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Acciones" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding DataContext.DeleteMethodCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding DataContext.UserSession.CanMutateSettings, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            Style="{DynamicResource MaterialDesignIconButton}"
                                                            ToolTip="Eliminar Método de Pago"
                                                            AutomationProperties.Name="Eliminar Método de Pago"
                                                            Foreground="#DC2626"
                                                            Width="30" Height="30">
                                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </controls:PerformantDataGrid.Columns>
                            </controls:PerformantDataGrid>
                        </Grid>
                    </Border>

                    <!-- F4-WU1 (Paso 14): reglas de comisión de medios de pago (solo Admin).
                         La comisión es costo del negocio y nunca se agrega al cliente. -->
                    <Border Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,20"
                            AutomationProperties.AutomationId="Settings_PaymentMethodFeesCard"
                            Visibility="{Binding CanEditPaymentMethodFeeRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Percent"
                                                                 Width="24" Height="24"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" />
                                        <TextBlock Text="Comisiones de Medios de Pago"
                                                   Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Costo del negocio por cobros electrónicos. Nunca se suma al cliente ni al checkout."
                                               Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                               Opacity="0.7"
                                               Margin="34,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding NewFeeRuleCommand}"
                                            AutomationProperties.AutomationId="Settings_NewPaymentMethodFeeButton"
                                            Style="{DynamicResource MaterialDesignRaisedButton}"
                                            Height="38"
                                            Padding="14,0"
                                            Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Nueva Regla" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                                 Value="0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsFeeRuleLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                 Width="20" Height="20" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding FeeRuleStatus}"
                                       Visibility="{Binding HasFeeRuleStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="#B45309"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding IsFeeRuleFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <WrapPanel>
                                        <StackPanel Width="240" Margin="0,0,12,10">
                                            <TextBlock Text="Método de pago" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding FeeEligiblePaymentMethods}"
                                                      DisplayMemberPath="Name"
                                                      SelectedItem="{Binding SelectedFeePaymentMethod, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsNewFeeRule}"
                                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                                      MinHeight="44" />
                                        </StackPanel>

                                        <StackPanel Width="170" Margin="0,0,12,10">
                                            <TextBlock Text="Tipo de comisión" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding FeeTypeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding SelectedFeeTypeOption, Mode=TwoWay}"
                                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                                      MinHeight="44" />
                                        </StackPanel>

                                        <StackPanel Width="130" Margin="0,0,12,10"
                                                    Visibility="{Binding ShowFeePercentage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Porcentaje (%)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding FeePercentageText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Ej: 1,5"
                                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                                     MinHeight="44" VerticalContentAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Width="130" Margin="0,0,12,10"
                                                    Visibility="{Binding ShowFeeFixedAmount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Monto fijo" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding FeeFixedAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Ej: 0,30"
                                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                                     MinHeight="44" VerticalContentAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Width="110" Margin="0,0,12,10">
                                            <TextBlock Text="Moneda" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding FeeCurrencyOptions}"
                                                      SelectedItem="{Binding FeeCurrencyCode, Mode=TwoWay}"
                                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                                      MinHeight="44" />
                                        </StackPanel>

                                        <StackPanel Width="150" Margin="0,0,12,10">
                                            <TextBlock Text="Vigente desde" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <DatePicker SelectedDate="{Binding FeeEffectiveFromDate, Mode=TwoWay}"
                                                        MinHeight="44" />
                                        </StackPanel>

                                        <StackPanel Width="150" Margin="0,0,12,10">
                                            <TextBlock Text="Vigente hasta" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <DatePicker SelectedDate="{Binding FeeEffectiveToDate, Mode=TwoWay}"
                                                        MinHeight="44" />
                                        </StackPanel>

                                        <StackPanel Width="100" Margin="0,0,12,10" VerticalAlignment="Center">
                                            <TextBlock Text="Activa" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding IsFeeRuleActive, Mode=TwoWay}"
                                                      VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancelar"
                                                Command="{Binding CancelFeeRuleEditCommand}"
                                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                                Height="36" Padding="16,0" Margin="0,0,8,0" />
                                        <Button Content="Guardar Regla"
                                                Command="{Binding SaveFeeRuleCommand}"
                                                IsEnabled="{Binding CanSaveFeeRule}"
                                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                                Height="36" Padding="16,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <controls:PerformantDataGrid ItemsSource="{Binding PaymentMethodFeeRules}"
                                                         AutomationProperties.AutomationId="Settings_PaymentMethodFeesGrid"
                                                         AutoGenerateColumns="False"
                                                         CanUserAddRows="False"
                                                         CanUserDeleteRows="False"
                                                         GridLinesVisibility="Horizontal"
                                                         HeadersVisibility="Column"
                                                         ColumnHeaderHeight="40"
                                                         RowHeight="42"
                                                         MinHeight="220"
                                                         BorderThickness="1"
                                                         BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                         Background="Transparent">
                                <controls:PerformantDataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:PerformantDataGrid.RowStyle>

                                <controls:PerformantDataGrid.Columns>
                                    <DataGridTextColumn Header="Método" Binding="{Binding PaymentMethodName}" Width="*" />
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding FeeTypeDisplay}" Width="Auto" />
                                    <DataGridTextColumn Header="Valor" Binding="{Binding FeeValueDisplay}" Width="Auto" />
                                    <DataGridTextColumn Header="Moneda" Binding="{Binding CurrencyCode}" Width="Auto" />
                                    <DataGridTextColumn Header="Desde" Binding="{Binding EffectiveFromDisplay}" Width="Auto" />
                                    <DataGridTextColumn Header="Hasta" Binding="{Binding EffectiveToDisplay}" Width="Auto" />
                                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusDisplay}" Width="Auto" />
                                    <DataGridTemplateColumn Header="Acciones" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Command="{Binding DataContext.EditFeeRuleCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource MaterialDesignIconButton}"
                                                            ToolTip="Editar regla de comisión"
                                                            Width="30" Height="30">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteFeeRuleCommand, RelativeSource={RelativeSource AncestorType=controls:PerformantDataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding IsActive}"
                                                            Style="{DynamicResource MaterialDesignIconButton}"
                                                            Foreground="#DC2626"
                                                            ToolTip="Desactivar regla de comisión"
                                                            Width="30" Height="30">
                                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </controls:PerformantDataGrid.Columns>
                            </controls:PerformantDataGrid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- APARTADO 3: INVENTARIO Y REGLAS DE VENTA -->
            <TabItem Header="Inventario y Reglas de Venta"
                     AutomationProperties.AutomationId="Settings_Section_Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,0,0" AutomationProperties.AutomationId="Settings_SectionContent_Inventory">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="PackageVariant"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock Text="Control de Existencias en Cobro"
                                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="Reglas que afectan la disponibilidad de stock al momento de cobrar."
                                           Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.7"
                                           Margin="34,0,0,14" />

                                <Grid Margin="34,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Permitir stock negativo" FontWeight="SemiBold" />
                                        <TextBlock Text="Si se activa, las ventas pueden dejar existencias negativas al superar el stock disponible"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding AllowNegativeStock, Mode=TwoWay}"
                                                  Command="{Binding ToggleAllowNegativeStockCommand}"
                                                  IsEnabled="{Binding UserSession.CanMutateSettings}"
                                                  AutomationProperties.AutomationId="Settings_NegativeStockToggle"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- APARTADO 4: CONECTIVIDAD Y RED LOCAL -->
            <TabItem Header="Conectividad y Red Local"
                     AutomationProperties.AutomationId="Settings_Section_Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,0,0" AutomationProperties.AutomationId="Settings_SectionContent_Network">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                                    <materialDesign:PackIcon Kind="ServerNetwork"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock Text="Conectividad y Red Local"
                                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{DynamicResource MaterialDesignBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,10,0">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="LanConnect"
                                                                                 Width="20" Height="20"
                                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,8,0" />
                                                        <TextBlock Text="Servidor Backend" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <Border DockPanel.Dock="Right"
                                                            Background="{Binding ConnectionStatusColor}"
                                                            CornerRadius="10"
                                                            Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ConnectionStatusText}"
                                                                       Foreground="White"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="Dirección actual del servidor POS en la red local:"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           Margin="0,0,0,6" />
                                                <Border Background="{DynamicResource MaterialDesignPaper}"
                                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,6">
                                                    <TextBlock Text="{Binding CurrentServerAddress}"
                                                               FontWeight="SemiBold"
                                                               FontFamily="Consolas, Monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MaterialDesignBody}" />
                                                </Border>
                                            </StackPanel>

                                            <Button DockPanel.Dock="Bottom"
                                                    Command="{Binding OpenServerConnectionCommand}"
                                                    AutomationProperties.AutomationId="Settings_ChangeServerButton"
                                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Padding="14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="CogOutline"
                                                                             Width="18" Height="18"
                                                                             Margin="0,0,6,0"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="Cambiar Servidor / Escanear" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource MaterialDesignBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="10,0,0,0">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="QrcodeScan"
                                                                             Width="20" Height="20"
                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,8,0" />
                                                    <TextBlock Text="Emparejamiento Móvil / Web" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Conecte teléfonos, tablets o terminales web escaneando el código QR de sincronización local:"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8" />
                                            </StackPanel>

                                            <Button DockPanel.Dock="Bottom"
                                                    Command="{Binding OpenPairingQrCommand}"
                                                    AutomationProperties.AutomationId="Settings_PairingQrButton"
                                                    Style="{DynamicResource MaterialDesignRaisedButton}"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    Padding="14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="QrcodeScan"
                                                                             Width="18" Height="18"
                                                                             Margin="0,0,6,0"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="Ver Código QR de Emparejamiento" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- APARTADO 5: SISTEMA Y MANTENIMIENTO -->
            <TabItem Header="Sistema y Mantenimiento"
                     AutomationProperties.AutomationId="Settings_Section_System">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,0,0" AutomationProperties.AutomationId="Settings_SectionContent_System">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="Web"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />
                                    <TextBlock Text="Zona Horaria Global"
                                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding AvailableTimeZones}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedItem="{Binding SelectedTimeZone, Mode=TwoWay}"
                                          IsEnabled="{Binding UserSession.CanMutateSettings}"
                                          materialDesign:HintAssist.Hint="Seleccionar Zona Horaria"
                                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                          MaxWidth="550"
                                          HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Zona de Acciones Críticas"
                                   FontWeight="Bold"
                                   Foreground="#B45309"
                                   Margin="0,4,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                AutomationProperties.AutomationId="Settings_RestartCard">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                                 Width="24" Height="24"
                                                                 Foreground="#D97706"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" />
                                        <TextBlock Text="Reiniciar Sistema"
                                                   Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Reinicia el servicio del sistema POS cuando presente lentitud o comportamiento anómalo. Las ventas y la configuración se conservan; la caja se restablece en segundos."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               FontSize="12"
                                               Margin="34,0,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding RestartSystemCommand}"
                                        AutomationProperties.AutomationId="Settings_RestartButton"
                                        IsEnabled="{Binding UserSession.CanMutateSettings}"
                                        Style="{DynamicResource MaterialDesignRaisedButton}"
                                        Height="42"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="14,0"
                                        Foreground="White"
                                        ToolTip="Reiniciar el servicio del sistema POS">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                                     Value="0"
                                                     IsIndeterminate="True"
                                                     Width="18" Height="18"
                                                     Margin="0,0,8,0"
                                                     Visibility="{Binding IsRestarting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <materialDesign:PackIcon Kind="Restart"
                                                                 Width="18" Height="18"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsRestarting, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <TextBlock Text="Reiniciar Sistema" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
