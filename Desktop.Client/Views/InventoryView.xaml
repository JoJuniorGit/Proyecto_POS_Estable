<UserControl x:Class="Desktop.Client.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Desktop.Client.Views"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:id="clr-namespace:CommunityToolkit.Mvvm.Input;assembly=CommunityToolkit.Mvvm"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyMultiplierConverter x:Key="CurrencyMultiplierConverter" />
        <Style x:Key="PrimaryTabRadioButton" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignTabRadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ── 2. Estilos para Encabezados Alineados ── -->
        <Style x:Key="RightAlignedHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,12,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CenterAlignedHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="LeftAlignedHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ── 3. Estilo Base para Iconos de Acción (Gris Neutro con Hover de Color) ── -->
        <Style x:Key="ActionIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modo Solo Lectura: Banner informativo -->
        <Border Grid.Row="0"
                Visibility="{Binding UserSession.CanMutateCatalog, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="LockOutline" Foreground="#D97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios e importaciones están deshabilitados."
                           Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- BARRA SUPERIOR: Búsqueda, Filtros y Botones de Acción Lado a Lado -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBox x:Name="SearchInput"
                         materialDesign:HintAssist.Hint="Buscar producto o SKU (mín. 2 carac)..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="SearchInput_GotFocus"
                         Width="260"
                         Margin="0,0,15,0"/>

                <!-- Pestañas de Filtro de Estado -->
                <RadioButton Content="Activos" 
                             Style="{StaticResource PrimaryTabRadioButton}" 
                             IsChecked="True" 
                             Command="{Binding SetStatusFilterCommand}" 
                             CommandParameter="active"
                             Margin="0,0,6,0"/>
                <RadioButton Content="Inactivos" 
                             Style="{StaticResource PrimaryTabRadioButton}" 
                             Command="{Binding SetStatusFilterCommand}" 
                             CommandParameter="inactive"
                             Margin="0,0,6,0"/>
                <RadioButton Content="Eliminados (Archivo)" 
                             Style="{StaticResource PrimaryTabRadioButton}" 
                             Command="{Binding SetStatusFilterCommand}" 
                             CommandParameter="deleted"
                             Margin="0,0,6,0"/>
                <RadioButton Content="Todos" 
                             Style="{StaticResource PrimaryTabRadioButton}" 
                             Command="{Binding SetStatusFilterCommand}" 
                             CommandParameter="all"/>
            </StackPanel>

            <ProgressBar Value="0"
                         IsIndeterminate="True"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Width="20" Height="20"
                         Margin="0,0,180,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            
            <!-- BOTONES DE ACCIÓN Y SELECTORES -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. Selector de Moneda (Bs.S por defecto) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Moneda:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <ComboBox SelectedValue="{Binding SelectedCurrency, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              Height="38"
                              Padding="10,4"
                              FontWeight="Bold">
                        <ComboBoxItem Content="Bs.S" IsSelected="True"/>
                        <ComboBoxItem Content="USD"/>
                    </ComboBox>
                </StackPanel>

                <!-- Botón Precios al Mayor (Desactivado por defecto) -->
                <Button Command="{Binding ToggleWholesaleCommand}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        ToolTip="Mostrar u Ocultar Precios al Mayor y Cantidad Mínima"
                        Height="38"
                        Padding="12,0"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding WholesaleButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón Nuevo Producto -->
                <Button Command="{Binding OpenAddProductCommand}"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Visibility="{Binding UserSession.CanMutateCatalog, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Crear Nuevo Producto en Catálogo"
                        Height="38"
                        Padding="14,0"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Nuevo Producto" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón Menú Lateral / Ajustes -->
                <Button Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        ToolTip="Abrir Menú Principal y Configuración"
                        Height="38"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Menú" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- CONTENEDOR PRINCIPAL: TABLA DE PRODUCTOS ESTILIZADA -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2">
                <DataGrid ItemsSource="{Binding Products}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="42"
                          RowHeight="42"
                          BorderThickness="0"
                          Background="Transparent"
                          Margin="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="Opacity" Value="0.65"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                    <Setter Property="Foreground" Value="#D97706"/>
                                    <Setter Property="Opacity" Value="0.85"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 1. Nombre del Producto -->
                        <DataGridTextColumn Header="Producto" 
                                            HeaderStyle="{StaticResource LeftAlignedHeader}"
                                            Binding="{Binding Name}" 
                                            Width="*" 
                                            MinWidth="160" 
                                            MaxWidth="350" 
                                            IsReadOnly="True" 
                                            ElementStyle="{DynamicResource MaterialDesignDataGridTextColumnStyle}"/>

                        <!-- 1. SKU / Código con Insignia Estilizada -->
                        <DataGridTemplateColumn Header="SKU / Código" HeaderStyle="{StaticResource LeftAlignedHeader}" Width="Auto" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" 
                                            BorderBrush="#CBD5E1" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="6,3" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SKU}" 
                                                   FontFamily="Consolas, Courier New, monospace" 
                                                   FontWeight="Bold" 
                                                   FontSize="12" 
                                                   Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Cantidad / Stock con Alerta Visual Roja si Stock <= 0 -->
                        <DataGridTemplateColumn Header="Stock" HeaderStyle="{StaticResource CenterAlignedHeader}" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0F9FF"/>
                                                <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStockCritical}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0369A1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStockCritical}" Value="True">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. Costo USD (Alineado a la Derecha) -->
                        <DataGridTemplateColumn Header="Costo ($ USD)" HeaderStyle="{StaticResource RightAlignedHeader}" Width="Auto" MinWidth="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cost, StringFormat='${0:N2}'}" 
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" 
                                               Margin="0,0,10,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 1 & 2. Precio Detal Dinámico (Encabezado Explícito y Alineado a la Derecha) -->
                        <DataGridTemplateColumn Header="{Binding DataContext.RetailPriceHeader, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Precio Detal (Bs.S)'}" HeaderStyle="{StaticResource RightAlignedHeader}" Width="Auto" MinWidth="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayRetailPrice}" 
                                               Foreground="#059669" 
                                               FontWeight="Bold" 
                                               FontSize="13"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" 
                                               Margin="0,0,14,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 1 & 2. Precio Mayor Dinámico (Encabezado Explícito, Alineado a la Derecha, Naranja si hereda detal) -->
                        <DataGridTemplateColumn Header="{Binding DataContext.WholesalePriceHeader, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Precio Mayor (Bs.S)'}" HeaderStyle="{StaticResource RightAlignedHeader}" Width="Auto" MinWidth="140">
                            <DataGridTemplateColumn.Visibility>
                                <Binding Path="DataContext.ShowWholesale" RelativeSource="{RelativeSource AncestorType=UserControl}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                            </DataGridTemplateColumn.Visibility>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding DisplayWholesalePrice}" 
                                                   Foreground="{Binding WholesalePriceColor}" 
                                                   FontWeight="Bold" 
                                                   FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Cantidad Mínima Mayor (Formateado de Unidades Enteras sin Decimales + Etiqueta Atenuada) -->
                        <DataGridTemplateColumn Header="Cant. Mín. Mayor" HeaderStyle="{StaticResource CenterAlignedHeader}" Width="Auto" MinWidth="115">
                            <DataGridTemplateColumn.Visibility>
                                <Binding Path="DataContext.ShowWholesale" RelativeSource="{RelativeSource AncestorType=UserControl}" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                            </DataGridTemplateColumn.Visibility>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedMinWholesaleQuantityStr}" FontWeight="Bold" FontSize="12" Foreground="{Binding WholesalePriceColor}"/>
                                        <TextBlock Text=" "/>
                                        <TextBlock Text="{Binding UnitOfMeasureStr}" FontSize="12" Foreground="#94A3B8" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Acciones (Unificadas en Gris Neutro + Efecto Hover por Acción) -->
                        <DataGridTemplateColumn Header="Acciones" HeaderStyle="{StaticResource CenterAlignedHeader}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Ajustar Stock (Hover Teal #0D9488) -->
                                        <Button Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Ajustar Inventario">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionIconButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#0D9488"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" />
                                        </Button>

                                        <!-- Consultar / Editar (Hover Azul #2563EB) -->
                                        <Button Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                ToolTip="Consultar / Editar Detalle">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionIconButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="Eye" Width="18" Height="18" />
                                        </Button>

                                        <!-- Pausar / Deshabilitar (Hover Naranja #D97706) -->
                                        <Button Command="{Binding DataContext.TogglePauseProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Pausar / Deshabilitar Producto">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionIconButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="PauseCircle" Width="18" Height="18" />
                                        </Button>

                                        <!-- Restaurar (Hover Verde #16A34A) -->
                                        <Button Command="{Binding DataContext.RestoreProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Restaurar a Estado Activo">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionIconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" />
                                        </Button>

                                        <!-- Eliminar (Hover Rojo #DC2626) -->
                                        <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                ToolTip="Opciones de Eliminación">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionIconButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Barra de Paginación 25 Elementos (Versión WPF) -->
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="Página Anterior">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>
                    <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="8,0"/>
                    <Button Command="{Binding NextPageCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Width="36" Padding="0" Margin="4,0,0,0" ToolTip="Página Siguiente">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
