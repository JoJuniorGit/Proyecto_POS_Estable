<UserControl x:Class="Desktop.Client.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Desktop.Client.Views"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:id="clr-namespace:CommunityToolkit.Mvvm.Input;assembly=CommunityToolkit.Mvvm"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
             mc:Ignorable="d" 
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding OpenAddProductCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RepeatLastActionCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding OpenBulkPriceEditCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllFilteredCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyMultiplierConverter x:Key="CurrencyMultiplierConverter" />
        
        <!-- Enterprise Subtle Drop Shadow -->
        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="10"
                          Opacity="0.05"
                          Direction="270"
                          ShadowDepth="2"/>

        <!-- ── 2. Estilos para Encabezados Alineados (Fondo #F8FAFC, Texto #64748B, 12px SemiBold) ── -->
        <Style x:Key="LeftAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="RightAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CenterAlignedHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modo Solo Lectura: Banner informativo -->
        <Border Grid.Row="0"
                Visibility="{Binding UserSession.CanMutateCatalog, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="LockOutline" Foreground="#D97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios e importaciones están deshabilitados."
                           Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- BARRA 1: Buscador + filtros (Izq/Centro) y acciones del catálogo (Der).
             Moneda y toggle de precios al mayor viven en la barra de edición masiva (Barra 2). -->
        <Border Grid.Row="1" 
                Background="#FFFFFF" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12,8" 
                Margin="0,0,0,12"
                Effect="{StaticResource EnterpriseCardShadow}"
                ToolTipService.InitialShowDelay="150"
                ToolTipService.BetweenShowDelay="50"
                ToolTipService.ShowDuration="8000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- El buscador absorbe el shrink; filtros y acciones conservan su ancho. -->
                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 1. Buscador en Cápsula Cerrada -->
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="40"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        ToolTipService.InitialShowDelay="150"
                        ToolTipService.BetweenShowDelay="50"
                        ToolTipService.ShowDuration="8000"
                        ToolTip="Buscar producto o SKU... (Ctrl+F)">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        
                        <TextBox Grid.Column="1"
                                 x:Name="SearchInput"
                                 AutomationProperties.AutomationId="Inventory_SearchInput"
                                 materialDesign:HintAssist.Hint="Buscar producto o SKU..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{DynamicResource MaterialDesignTextBox}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#1E293B"
                                 FontSize="13"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 GotFocus="SearchInput_GotFocus"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"/>

                        <ProgressBar Grid.Column="2"
                                     Value="0"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Width="16" Height="16"
                                     Margin="4,0,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </Border>

                <!-- 2. Filtros de Estado y Categoría — combos directos, sin etiquetas externas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0">
                    <ComboBox SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              AutomationProperties.AutomationId="Inventory_StatusFilterCombo"
                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              Height="40"
                              Width="125"
                              Padding="10,4"
                              FontWeight="SemiBold"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              ToolTipService.InitialShowDelay="150"
                              ToolTipService.BetweenShowDelay="50"
                              ToolTipService.ShowDuration="8000"
                              ToolTip="Filtrar por estado">
                        <ComboBoxItem Content="Activos" Tag="active"/>
                        <ComboBoxItem Content="Inactivos" Tag="inactive"/>
                        <ComboBoxItem Content="Eliminados (Archivo)" Tag="deleted"/>
                        <ComboBoxItem Content="Todos" Tag="all"/>
                    </ComboBox>

                    <!-- 8.179-T2 (S4): filtro por categoría (incluye subárbol); "Todas" = sin filtro -->
                    <ComboBox ItemsSource="{Binding CategoryFilterOptions}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                              DisplayMemberPath="Path"
                              AutomationProperties.AutomationId="Inventory_CategoryFilterCombo"
                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              Height="40"
                              Width="165"
                              Margin="12,0,0,0"
                              Padding="10,4"
                              FontWeight="SemiBold"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              ToolTipService.InitialShowDelay="150"
                              ToolTipService.BetweenShowDelay="50"
                              ToolTipService.ShowDuration="8000"
                              ToolTip="Filtrar por categoría"/>
                </StackPanel>
                
                <!-- 3. Acciones del catálogo a la derecha — compactas para no recortarse -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Actualizar: solo ícono -->
                    <Button Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="Inventory_RefreshButton"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Foreground="#475569"
                            ToolTipService.InitialShowDelay="150"
                            ToolTipService.BetweenShowDelay="50"
                            ToolTipService.ShowDuration="8000"
                            ToolTip="Actualizar catálogo de productos (F5)"
                            Width="38"
                            Height="38"
                            Padding="0"
                            Margin="0,0,8,0"
                            materialDesign:ButtonAssist.CornerRadius="6"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsRefreshing}"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                            materialDesign:ButtonProgressAssist.Value="-1">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- CTA compacto: ícono + "Nuevo" -->
                    <Button Command="{Binding OpenAddProductCommand}"
                            Background="#5E35B1"
                            BorderBrush="#5E35B1"
                            Foreground="#FFFFFF"
                            Visibility="{Binding UserSession.CanMutateCatalog, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTipService.InitialShowDelay="150"
                            ToolTipService.BetweenShowDelay="50"
                            ToolTipService.ShowDuration="8000"
                            ToolTip="Crear nuevo producto (Ctrl+N)"
                            Height="38"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            materialDesign:ButtonAssist.CornerRadius="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFFFFF"/>
                            <TextBlock Text="Nuevo" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <!-- Menú: solo ícono -->
                    <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                            CommandParameter="{x:Static Dock.Right}"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Foreground="#475569"
                            ToolTipService.InitialShowDelay="150"
                            ToolTipService.BetweenShowDelay="50"
                            ToolTipService.ShowDuration="8000"
                            ToolTip="Menú de inventario"
                            Width="38"
                            Height="38"
                            Padding="0"
                            materialDesign:ButtonAssist.CornerRadius="6">
                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENEDOR PRINCIPAL: TABLA DE PRODUCTOS ESTILIZADA -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 8.181-T2 (S5): barra de seleccion multiple para la edicion masiva de precios.
                 El estado de seleccion vive en el ViewModel por ProductId (persiste entre paginas);
                 "Seleccionar todos los filtrados" usa el modo filtro del contrato (Filter + SelectAllFiltered). -->
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,10"
                    Effect="{StaticResource EnterpriseCardShadow}"
                    ToolTipService.InitialShowDelay="150"
                    ToolTipService.BetweenShowDelay="50"
                    ToolTipService.ShowDuration="8000"
                    Visibility="{Binding Data.UserSession.CanMutateCatalog, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><!-- Espacio elástico entre selección y acciones -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: selección masiva (resumen + acciones solo-ícono) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CheckAll" Width="18" Height="18" Foreground="#5E35B1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectionSummary}"
                                   AutomationProperties.AutomationId="Inventory_SelectionSummary"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#1E293B"
                                   VerticalAlignment="Center"/>
                        <Button Command="{Binding SelectAllFilteredCommand}"
                                AutomationProperties.AutomationId="Inventory_SelectAllFilteredButton"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Width="38"
                                Height="38"
                                Padding="0"
                                Margin="16,0,8,0"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.BetweenShowDelay="50"
                                ToolTipService.ShowDuration="8000"
                                ToolTip="Seleccionar todos los productos filtrados (Ctrl+A)">
                            <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding ClearSelectionCommand}"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Width="38"
                                Height="38"
                                Padding="0"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.BetweenShowDelay="50"
                                ToolTipService.ShowDuration="8000"
                                ToolTip="Limpiar selección (Esc)">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Derecha: moneda, toggle de mayor y edición de precios -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Selector de Moneda directo (sin etiqueta externa) -->
                        <ComboBox SelectedValue="{Binding SelectedCurrency, Mode=TwoWay}"
                                  SelectedValuePath="Content"
                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                  Width="85"
                                  Height="34"
                                  Padding="10,2"
                                  FontWeight="Bold"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  ToolTipService.InitialShowDelay="150"
                                  ToolTipService.BetweenShowDelay="50"
                                  ToolTipService.ShowDuration="8000"
                                  ToolTip="Moneda de visualización del catálogo">
                            <ComboBoxItem Content="Bs.S" IsSelected="True"/>
                            <ComboBoxItem Content="USD"/>
                        </ComboBox>

                        <!-- Toggle solo-ícono: morado cuando ShowWholesale está activo -->
                        <Button Command="{Binding ToggleWholesaleCommand}"
                                Width="38"
                                Height="38"
                                Padding="0"
                                Margin="10,0,8,0"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.BetweenShowDelay="50"
                                ToolTipService.ShowDuration="8000"
                                ToolTip="Mostrar u Ocultar Precios al Mayor y Cantidad Mínima"
                                materialDesign:ButtonAssist.CornerRadius="6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowWholesale}" Value="True">
                                            <Setter Property="Background" Value="#5E35B1"/>
                                            <Setter Property="BorderBrush" Value="#5E35B1"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Divisor sutil: separa Moneda/toggle de Editar precios -->
                        <Border Width="1" Background="#E2E8F0" Margin="4,4,12,4"/>

                        <!-- CTA completa, anclada a la columna derecha Auto -->
                        <Button Command="{Binding OpenBulkPriceEditCommand}"
                                AutomationProperties.AutomationId="Inventory_BulkPriceEditButton"
                                Background="#5E35B1"
                                BorderBrush="#5E35B1"
                                Foreground="#FFFFFF"
                                Height="34"
                                Padding="14,0"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.BetweenShowDelay="50"
                                ToolTipService.ShowDuration="8000"
                                ToolTip="Abrir edición masiva de precios para los productos seleccionados (Ctrl+E)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="16" Height="16" Margin="0,0,6,0" Foreground="#FFFFFF"/>
                                <TextBlock Text="Editar precios" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    Effect="{StaticResource EnterpriseCardShadow}">
                <DataGrid x:Name="ProductsDataGrid"
                          AutomationProperties.AutomationId="Inventory_DataGrid"
                          ItemsSource="{Binding Products}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Disabled"
                          ColumnHeaderHeight="42"
                          RowHeight="46"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          BorderThickness="0"
                          Background="#FFFFFF"
                          RowBackground="#FFFFFF"
                          Margin="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="Opacity" Value="0.65"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                    <Setter Property="Foreground" Value="#D97706"/>
                                    <Setter Property="Opacity" Value="0.85"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 0. Selección múltiple para la edición masiva (8.181-T2 S5): estado de UI puro,
                             el checkbox no dispara el auto-save por fila ni recálculos de precio. -->
                        <DataGridTemplateColumn Width="48"
                                                MinWidth="48"
                                                HeaderStyle="{StaticResource CenterAlignedHeader}"
                                                Visibility="{Binding Data.UserSession.CanMutateCatalog, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Kind="CheckAll"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.AutomationId="Inventory_SelectRowCheckBox"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0"
                                              ToolTip="Seleccionar el producto para la edición masiva de precios"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 1. Nombre del Producto (Absorbe todo el espacio elástico sobrante) -->
                        <DataGridTemplateColumn HeaderStyle="{StaticResource LeftAlignedHeader}" 
                                                Width="*" 
                                                MinWidth="180">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="name"/>
                                        </Grid.InputBindings>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="PRODUCTO" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByName, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByName, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" 
                                               VerticalAlignment="Center" 
                                               FontSize="13" 
                                               Foreground="#1E293B" 
                                               Margin="14,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. SKU / Código con Insignia Estilizada -->
                        <DataGridTemplateColumn HeaderStyle="{StaticResource LeftAlignedHeader}" Width="150" MinWidth="150">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Cursor="Hand" ToolTip="Ordenar por código de barras">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="sku"/>
                                        </Grid.InputBindings>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="SKU / CÓDIGO" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedBySku, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedBySku, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" 
                                            BorderBrush="#E2E8F0" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="6,3" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SKU}" 
                                                   FontFamily="Consolas, Courier New, monospace" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Cantidad / Stock con Alerta Visual Roja si Stock <= 0 -->
                        <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Width="120">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="stock"/>
                                        </Grid.InputBindings>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="STOCK" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByStock, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByStock, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCashAdvance}" Value="True">
                                                            <Setter Property="Background" Value="#EDE9FE"/>
                                                            <Setter Property="BorderBrush" Value="#DDD6FE"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStockCritical}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding FormattedStockQuantity}" 
                                                       Typography.NumeralAlignment="Tabular"
                                                       FontWeight="SemiBold" 
                                                       FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCashAdvance}" Value="True">
                                                                <Setter Property="Foreground" Value="#6D28D9"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStockCritical}" Value="True">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Costo USD (Alineado a la Derecha) -->
                        <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Width="120">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="cost"/>
                                        </Grid.InputBindings>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='COSTO ({0})'}" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByCost, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByCost, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Typography.NumeralAlignment="Tabular"
                                               Foreground="#1E293B"
                                               FontSize="13"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" 
                                               Margin="0,0,14,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Cost, Converter={StaticResource PrimaryAmountConverter}}"/>
                                                <Style.Triggers>
                                                    <!-- Group headers with independent pricing have no own cost. -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsGroupHeader}" Value="True"/>
                                                            <Condition Binding="{Binding HasIndependentPricing}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="—"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 5. Precio Detal Dinámico (Alineado a la Derecha y Data Neutra) -->
                        <DataGridTemplateColumn HeaderStyle="{StaticResource RightAlignedHeader}" Width="150">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="price"/>
                                        </Grid.InputBindings>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#64748B">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding DataContext.RetailPriceHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <Style.Triggers>
                                                            <!-- Single has no local projection: the column always shows the primary price. -->
                                                            <DataTrigger Binding="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle}" Value="True">
                                                                <Setter Property="Text" Value="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='Precio Detal ({0})'}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByPrice, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DataContext.IsSortedByPrice, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsSortDescending, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <!-- Dual: the filter still chooses between the primary and the local projection. -->
                                        <TextBlock Text="{Binding DisplayRetailPrice}" 
                                                   Foreground="#1E293B" 
                                                   FontWeight="Bold" 
                                                   FontSize="13"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"/>
                                        <!-- Single: only the primary price exists. -->
                                        <TextBlock Foreground="#1E293B" 
                                                   FontWeight="Bold" 
                                                   FontSize="13"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding PriceUSD, Converter={StaticResource PrimaryAmountConverter}}"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsGroupHeader}" Value="True"/>
                                                                <Condition Binding="{Binding HasIndependentPricing}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="—"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Precio Mayor Dinámico (Alineado a la Derecha y Data Neutra) -->
                        <DataGridTemplateColumn Visibility="{Binding Data.ShowWholesale, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                HeaderStyle="{StaticResource RightAlignedHeader}" 
                                                Width="150">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="#64748B">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Data.WholesalePriceHeader, Source={StaticResource Proxy}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='Precio Mayor ({0})'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding DisplayWholesalePrice}" 
                                                   Foreground="#1E293B" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="13"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"/>
                                        <TextBlock Foreground="#1E293B" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="13"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding EffectivePriceWholesaleUSD, Converter={StaticResource PrimaryAmountConverter}}"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsGroupHeader}" Value="True"/>
                                                                <Condition Binding="{Binding HasIndependentPricing}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="—"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Cantidad Mínima Mayor (Alineado a la Derecha) -->
                        <DataGridTemplateColumn Header="CANT. MÍN. MAYOR" 
                                                Visibility="{Binding Data.ShowWholesale, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                HeaderStyle="{StaticResource RightAlignedHeader}" 
                                                Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding FormattedMinWholesaleQuantityStr}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text=" "/>
                                        <TextBlock Text="{Binding UnitOfMeasureStr}" FontSize="12" Foreground="#94A3B8" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. Acciones: repetición rápida + Kebab Menu ⋮ -->
                        <DataGridTemplateColumn Header="ACCIONES" HeaderStyle="{StaticResource CenterAlignedHeader}" Width="95" MinWidth="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Repite la última operación (Ctrl+R) sobre esta fila. -->
                                        <Button Command="{Binding DataContext.RepeatLastActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="Inventory_QuickRepeatButton"
                                                Style="{DynamicResource MaterialDesignFlatButton}"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Margin="0,0,4,0"
                                                Foreground="#5E35B1"
                                                ToolTipService.InitialShowDelay="150"
                                                ToolTipService.BetweenShowDelay="50"
                                                ToolTipService.ShowDuration="8000"
                                                ToolTip="{Binding Data.LastQuickRepeatToolTip, Source={StaticResource Proxy}}"
                                                Visibility="{Binding Data.HasLastQuickRepeat, Source={StaticResource Proxy}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="{Binding Data.LastQuickRepeatIcon, Source={StaticResource Proxy}}"
                                                                     Width="18"
                                                                     Height="18"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Button>

                                        <materialDesign:PopupBox Style="{DynamicResource MaterialDesignPopupBox}"
                                                                 PlacementMode="BottomAndAlignRightEdges"
                                                                 Padding="0"
                                                                 Width="32" Height="32"
                                                                 Foreground="#64748B"
                                                                 ToolTip="Opciones del Producto">
                                        <materialDesign:PopupBox.ToggleContent>
                                            <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </materialDesign:PopupBox.ToggleContent>
                                        <StackPanel Width="200">
                                            <!-- Ajustar Stock -->
                                            <Button Command="{Binding DataContext.AdjustStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    IsEnabled="{Binding CanAdjustStock}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" Margin="0,0,10,0" Foreground="#0D9488" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Ajustar Stock" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Consultar / Editar -->
                                            <Button Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" Margin="0,0,10,0" Foreground="#5E35B1" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Consultar / Editar" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Pausar / Deshabilitar -->
                                            <Button Command="{Binding DataContext.TogglePauseProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="PauseCircleOutline" Width="18" Height="18" Margin="0,0,10,0" Foreground="#D97706" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Pausar Producto" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Restaurar -->
                                            <Button Command="{Binding DataContext.RestoreProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,8">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" Margin="0,0,10,0" Foreground="#16A34A" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Restaurar a Activo" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Eliminar -->
                                            <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.UserSession.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,10,0" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Eliminar Producto" VerticalAlignment="Center" Foreground="#DC2626"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        </materialDesign:PopupBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Barra de Paginación Avanzada Centrada (Diseño Enterprise Refinado) -->
            <Border Grid.Row="2" 
                    Margin="0,10,0,0" 
                    Padding="8,4" 
                    Background="#FFFFFF" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Effect="{StaticResource EnterpriseCardShadow}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Resumen -->
                    <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" Foreground="#475569"/>

                    <!-- Botón Primera Página (<<) -->
                    <Button Command="{Binding FirstPageCommand}" 
                            IsEnabled="{Binding CanGoFirst}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" 
                            Height="32" Width="36" Padding="0" Margin="0,0,4,0" 
                            ToolTip="Primera Página">
                        <materialDesign:PackIcon Kind="PageFirst" Width="18" Height="18"/>
                    </Button>

                    <!-- Botón Página Anterior (<) -->
                    <Button Command="{Binding PreviousPageCommand}" 
                            IsEnabled="{Binding CanGoPrevious}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" 
                            Height="32" Width="36" Padding="0" Margin="0,0,6,0" 
                            ToolTip="Página Anterior">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>

                    <!-- Botones Numéricos de Páginas Relativas (Píldoras sin bordes toscos) -->
                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding PageNumber}"
                                        Content="{Binding PageNumber}"
                                        Height="32" MinWidth="34" Padding="6,0" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#5E35B1"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Botón Página Siguiente (>) -->
                    <Button Command="{Binding NextPageCommand}" 
                            IsEnabled="{Binding CanGoNext}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" 
                            Height="32" Width="36" Padding="0" Margin="6,0,4,0" 
                            ToolTip="Página Siguiente">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>

                    <!-- Botón Última Página (>>) -->
                    <Button Command="{Binding LastPageCommand}" 
                            IsEnabled="{Binding CanGoLast}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" 
                            Height="32" Width="36" Padding="0" Margin="0,0,14,0" 
                            ToolTip="Última Página">
                        <materialDesign:PackIcon Kind="PageLast" Width="18" Height="18"/>
                    </Button>

                    <!-- Separador vertical -->
                    <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="0,0,14,0"/>

                    <!-- Búsqueda Exacta: Ir a Página -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Ir a:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="#64748B"/>
                        <TextBox x:Name="TargetPageTextBox"
                                 Text="{Binding TargetPageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 PreviewTextInput="NumberValidationTextBox"
                                 GotFocus="TargetPageInput_GotFocus"
                                 PreviewMouseLeftButtonDown="TargetPageInput_PreviewMouseLeftButtonDown"
                                 Width="48" Height="30"
                                 FontSize="12" FontWeight="Bold"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 Padding="2,0" Margin="0,0,6,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SubmitGoToPageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Command="{Binding SubmitGoToPageCommand}"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Background="#5E35B1"
                                BorderBrush="#5E35B1"
                                Foreground="#FFFFFF"
                                Height="30" Width="36" Padding="0"
                                ToolTip="Ir a la página especificada">
                            <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

