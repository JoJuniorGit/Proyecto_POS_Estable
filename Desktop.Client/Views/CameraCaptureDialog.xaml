<Window x:Class="Desktop.Client.Views.CameraCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Capturar factura con cámara"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Capturar factura con cámara"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                       FontWeight="Bold" />
            <TextBlock Text="Encuadre la factura completa y presione Capturar. La foto entra al mismo flujo OCR que el archivo."
                       Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#111827" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <TextBlock x:Name="CameraUnavailableMessage"
                           Visibility="Collapsed"
                           Text="No hay cámara disponible en este equipo. Puede cargar la factura con &quot;Escanear factura (OCR)&quot;."
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="32" />
            </Grid>
        </Border>

        <TextBlock x:Name="CaptureErrorMessage"
                   Grid.Row="2"
                   Foreground="#DC2626"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,10,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar"
                    IsCancel="True"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    Margin="0,0,15,0" />
            <Button x:Name="CaptureButton"
                    Content="Capturar"
                    Click="CaptureButton_Click"
                    IsDefault="True"
                    Style="{DynamicResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
