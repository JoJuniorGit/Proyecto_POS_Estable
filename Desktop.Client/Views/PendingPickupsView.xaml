<UserControl x:Class="Desktop.Client.Views.PendingPickupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             mc:Ignorable="d"
             Background="#F1F5F9"
             d:DataContext="{d:DesignInstance Type=vm:PendingPickupsViewModel}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="15"
                          Opacity="0.04"
                          Direction="270"
                          ShadowDepth="2"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 1. Encabezado ── -->
        <DockPanel Grid.Row="0" Margin="24,20,24,14" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        BorderBrush="#CBD5E1"
                        Foreground="#475569"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                        materialDesign:ButtonProgressAssist.Value="-1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Refrescar" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="Abrir Menú Principal"
                        Height="36" Width="36"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" Foreground="#475569"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="PackageVariantClosedCheck" Width="26" Height="26" Foreground="#5E35B1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Retiros Pendientes (Mercancía en Custodia)" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Mercancía pagada al 100% pendiente de entrega física al cliente" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ── 2. Barra de Búsqueda Flotante + Mensaje de Éxito ── -->
        <StackPanel Grid.Row="1" Margin="24,0,24,16">
            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="42"
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    Effect="{StaticResource EnterpriseCardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,2,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar por N° factura, cliente o cédula/RIF..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             FontSize="13"
                             Foreground="#1E293B"
                             Padding="6,0,10,0"/>
                </Grid>
            </Border>

            <!-- Mensaje de Éxito -->
            <Border Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,10,0,0"
                    HorizontalAlignment="Left" MaxWidth="600">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Foreground="#166534"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534"
                               FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── 3. Lista de Tarjetas Virtualizada (ListBox, 1 columna) ── -->
        <ListBox x:Name="PickupsList" Grid.Row="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.IsDeferredScrollingEnabled="False"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="24,0,24,16">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Tarjeta Principal Blanca con Borde Sutil y Sombra Suave -->
                    <Border Margin="0,0,0,16" CornerRadius="8"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Effect="{StaticResource EnterpriseCardShadow}"
                            Padding="22,18">
                        <StackPanel>

                            <!-- Encabezado de la Tarjeta -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Soft Badge de Factura (#EDE9FE / #5E35B1) -->
                                <Border Grid.Column="0" Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="#5E35B1" FontWeight="Bold" FontSize="12">
                                        <Run Text="Factura N° "/>
                                        <Run Text="{Binding InvoiceNumber, StringFormat='{}{0:D5}', FallbackValue='—'}"/>
                                    </TextBlock>
                                </Border>

                                <!-- Píldora de Pendiente de Retiro (#FEF3C7 / #92400E, CornerRadius="100") -->
                                <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="100" Padding="10,4"
                                        Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Foreground="#92400E"/>
                                        <TextBlock Text="Pendiente de Retiro" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#92400E" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Montos Totales en Bs.S y USD alineados a la derecha -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalBsS, StringFormat='{}{0:N2} Bs.S'}"
                                               FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding TotalUSD, StringFormat='${0:N2} USD'}"
                                               FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Fila de Datos del Cliente (con respiración vertical adecuada) -->
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,2,18,2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Account" Width="15" Height="15" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding CustomerName, Converter={StaticResource TitleCaseConverter}}"
                                               FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,18,2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="15" Height="15" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding CustomerCedula}" FontSize="12" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,18,2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PhoneOutline" Width="15" Height="15" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding CustomerPhone, FallbackValue='Sin teléfono'}" FontSize="12" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="15" Height="15" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock FontSize="12" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Run Text="Pagado: "/>
                                        <Run Text="{Binding Date, StringFormat='{}{0:dd/MM/yy HH:mm}'}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </TextBlock>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Contenedor Gris Ultra Pálido (#F8FAFC) con Productos y Botón de Acción -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="16,12,16,16" Margin="0,0,0,0">
                                <StackPanel>
                                    <!-- Cabecera flotante en mayúsculas pequeñas -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PRODUCTO" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1" Text="CANT." FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="P. UNIT. BS.S" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="SUBTOTAL BS.S" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Lista de Productos -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                               FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0:0.###}'}"
                                                               FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitPriceBsS, StringFormat='Bs.S {0:N2}'}"
                                                               FontSize="12" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SubtotalBsS, StringFormat='Bs.S {0:N2}'}"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Typography.NumeralAlignment="Tabular"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Botón de Acción Plano (Flat Design, #5E35B1) con espacio superior para respirar -->
                                    <Button Command="{Binding Data.ConfirmPickupCommand, Source={StaticResource Proxy}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MaterialDesignFlatMidBgButton}"
                                            materialDesign:ButtonAssist.CornerRadius="6"
                                            Background="#5E35B1" Foreground="White"
                                            Height="36" HorizontalAlignment="Right" Padding="18,0"
                                            Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="PackageCheck" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Confirmar Retiro / Entregar" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Estado de Carga / Vacío -->
        <Grid Grid.Row="2" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Background="#60FFFFFF" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                             Foreground="#5E35B1" IsIndeterminate="True"
                             Width="44" Height="44"/>
                <TextBlock Text="Cargando retiros pendientes..." Margin="0,12,0,0"
                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="#475569"/>
            </StackPanel>
        </Grid>

        <!-- Botón Cargar Más -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,16"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
            <Button Content="Cargar más retiros"
                    Command="{Binding LoadMoreCommand}"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    BorderBrush="#CBD5E1" Foreground="#475569"
                    Height="36" Padding="20,0" FontSize="12" FontWeight="SemiBold"
                    materialDesign:ButtonAssist.CornerRadius="6"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoadingMore}"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                    materialDesign:ButtonProgressAssist.Value="-1"/>
        </StackPanel>
    </Grid>
</UserControl>
