<UserControl x:Class="Desktop.Client.Views.PendingPickupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PendingPickupsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 1. Encabezado ── -->
        <Border Grid.Row="0" Padding="24,20,24,12"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageCheck" Width="28" Height="28"
                                                 VerticalAlignment="Center" Foreground="#7C3AED"/>
                        <TextBlock Text="Retiros Pendientes (Mercancía en Custodia)"
                                   Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
                                   FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Mercancía pagada al 100% pendiente de entrega física al cliente"
                               FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="38,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" VerticalAlignment="Center"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                            materialDesign:ButtonProgressAssist.Value="-1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Refrescar" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                            CommandParameter="{x:Static Dock.Right}"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            ToolTip="Abrir Menú Principal"
                            Margin="8,0,0,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 2. Barra de Búsqueda Refinada + Mensaje de Éxito ── -->
        <Border Grid.Row="1" Padding="24,14" Background="{DynamicResource MaterialDesignBackground}">
            <StackPanel>
                <Grid x:Name="SearchGrid">
                    <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="14,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" Panel.ZIndex="1"/>
                    <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar por N° Factura, Nombre o Cédula..."
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Padding="38,8,12,8" FontSize="13"/>
                </Grid>

                <!-- Mensaje de Éxito -->
                <Border Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}"
                        Background="#EDE9FE" CornerRadius="6" Padding="14,8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageCheck" Width="18" Height="18" VerticalAlignment="Center" Foreground="#7C3AED"/>
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="#5B21B6"
                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── 3. Lista de Tarjetas en Cuadrícula 2 Columnas (Grid Layout) ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
            <ItemsControl ItemsSource="{Binding FilteredPickups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Tarjeta con bordes redondeados y sombra sutil -->
                        <Border Margin="8" CornerRadius="10"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                materialDesign:ElevationAssist.Elevation="Dp2"
                                Padding="20,16">
                            <StackPanel>

                                <!-- Encabezado de la Tarjeta -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Insignia de Factura -->
                                    <Border Grid.Column="0" Background="#7C3AED" CornerRadius="6" Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
                                            <Run Text="Factura N° "/>
                                            <Run Text="{Binding InvoiceNumber, StringFormat='{}{0:D5}', FallbackValue='—'}"/>
                                        </TextBlock>
                                    </Border>

                                    <!-- Estado Pendiente -->
                                    <Border Grid.Column="1" Background="#FFF3CD" CornerRadius="6" Padding="8,3"
                                            Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClockAlertOutline" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Foreground="#B45309"/>
                                            <TextBlock Text="Pendiente de Retiro" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#B45309" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Montos Totales en Bs.S y USD -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TotalBsS, StringFormat='Bs.S {0:N2}'}"
                                                   FontWeight="Bold" FontSize="17" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                                        <TextBlock Text="{Binding TotalUSD, StringFormat='${0:N2} USD'}"
                                                   FontSize="12" Foreground="Gray" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Strip de Datos del Cliente (Legibilidad y Contraste Mejorados) -->
                                <Border CornerRadius="8" Padding="14,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                            <materialDesign:PackIcon Kind="Account" Width="16" Height="16" VerticalAlignment="Center" Foreground="#475569"/>
                                            <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                            <materialDesign:PackIcon Kind="CardAccountDetails" Width="16" Height="16" VerticalAlignment="Center" Foreground="#475569"/>
                                            <TextBlock Text="{Binding CustomerCedula}" FontSize="12" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                            <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" VerticalAlignment="Center" Foreground="#475569"/>
                                            <TextBlock Text="{Binding CustomerPhone, FallbackValue='Sin teléfono'}" FontSize="12" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <materialDesign:PackIcon Kind="CalendarCheck" Width="16" Height="16" VerticalAlignment="Center" Foreground="#475569"/>
                                            <TextBlock FontSize="12" Foreground="#475569" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Run Text="Pagado: "/>
                                                <Run Text="{Binding Date, StringFormat='{}{0:dd/MM/yy HH:mm}'}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <!-- Tabla de Productos (Alineada a la Derecha con 2 Decimales) -->
                                <DataGrid ItemsSource="{Binding Items}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                          Background="Transparent" MaxHeight="180"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,0,0,16"
                                          materialDesign:DataGridAssist.CellPadding="10,6"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="10,6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}"
                                                            Width="*" IsReadOnly="True"/>
                                        
                                        <DataGridTemplateColumn Width="75">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Cant." HorizontalAlignment="Center" TextAlignment="Center"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}'}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="130">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="P. Unit Bs.S" HorizontalAlignment="Right" TextAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding UnitPriceBsS, StringFormat='Bs.S {0:N2}'}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="140">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="Subtotal Bs.S" HorizontalAlignment="Right" TextAlignment="Right"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SubtotalBsS, StringFormat='Bs.S {0:N2}'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Botón de Acción Estilizado con Bordes Redondeados -->
                                <Button Command="{Binding DataContext.ConfirmPickupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{DynamicResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Background="#7C3AED" Foreground="White"
                                        Height="42" HorizontalAlignment="Right" Padding="20,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PackageCheck" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="Confirmar Retiro / Entregar" Margin="8,0,0,0" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado de Carga / Vacío -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                         Width="48" Height="48"/>
            <TextBlock Text="Cargando retiros pendientes..." Margin="0,12,0,0"
                       FontSize="14" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>
    </Grid>
</UserControl>
