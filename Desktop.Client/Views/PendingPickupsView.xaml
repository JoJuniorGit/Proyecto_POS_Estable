<UserControl x:Class="Desktop.Client.Views.PendingPickupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             xmlns:conv="clr-namespace:Desktop.Client.Converters"
             mc:Ignorable="d"
             Background="#F8FAFC"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             d:DesignHeight="820" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:PendingPickupsViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
            <conv:InitialsConverter x:Key="InitialsConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- S2: single minimal card shadow (0.03) shared by the four KPI cards. -->
            <DropShadowEffect x:Key="PickupKpiShadow"
                              Color="#0F172A"
                              BlurRadius="12"
                              Opacity="0.03"
                              Direction="270"
                              ShadowDepth="2"/>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsThinScrollBarStyle}"/>

            <!-- KPI strip -->
            <Style x:Key="PickupKpiCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Effect" Value="{StaticResource PickupKpiShadow}"/>
            </Style>

            <Style x:Key="PickupKpiLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#64748B"/>
            </Style>

            <Style x:Key="PickupKpiValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="Margin" Value="0,3,0,0"/>
            </Style>

            <Style x:Key="PickupKpiSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Toolbar search frame -->
            <Style x:Key="PickupSearchFrameStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#6D28D9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Segmented status filter pill -->
            <Style x:Key="PickupFilterPillStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#EDE9FE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#DDD6FE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Left tray item -->
            <Style x:Key="PickupListItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemRoot"
                                    Background="Transparent"
                                    BorderBrush="#F1F5F9"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SelectionBar" Grid.Column="0"
                                            Background="#6D28D9" Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemRoot" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemRoot" Property="Background" Value="#F5F3FF"/>
                                    <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Well-proportioned status pill (no deformed ovals) -->
            <Style x:Key="PickupStatusPillStyle" TargetType="Border">
                <Setter Property="Background" Value="#FEF3C7"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPartiallyDelivered}" Value="True">
                        <Setter Property="Background" Value="#DBEAFE"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PickupStatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#B45309"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPartiallyDelivered}" Value="True">
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PickupVolumePillStyle" TargetType="Border">
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasLargePendingVolume}" Value="True">
                        <Setter Property="Background" Value="#FFFBEB"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PickupVolumeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasLargePendingVolume}" Value="True">
                        <Setter Property="Foreground" Value="#B45309"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PickupMetaTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                        <Setter Property="Foreground" Value="#B45309"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Delivery progress bars -->
            <Style x:Key="PickupMiniProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="MinHeight" Value="4"/>
                <Setter Property="Background" Value="#E2E8F0"/>
                <Setter Property="Foreground" Value="#16A34A"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="PART_Track"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="2"/>
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DispatchProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Background" Value="#E2E8F0"/>
                <Setter Property="Foreground" Value="#6D28D9"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="PART_Track"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="3"/>
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Product custody grid -->
            <Style x:Key="PickupColumnHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource SettingsTableHeaderStyle}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="PickupColumnHeaderCenterStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource PickupColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,0"/>
            </Style>

            <Style x:Key="PickupColumnHeaderRightStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource PickupColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style x:Key="PickupRowStyle" TargetType="DataGridRow"
                   BasedOn="{StaticResource SettingsTableRowStyle}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PickupCellStyle" TargetType="DataGridCell"
                   BasedOn="{StaticResource SettingsTableCellStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <!-- Customer data chips -->
            <Style x:Key="PickupChipStyle" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="7,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── S1: Unified header ── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="#EDE9FE"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariantClosedCheck"
                                             Width="22" Height="22"
                                             Foreground="#6D28D9"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Retiros Pendientes (Mercancía en Custodia)"
                               FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Mercancía pagada al 100% pendiente de entrega física al cliente."
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="PendingPickups_RefreshButton"
                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                        Height="38" Padding="14,0" Margin="0,0,8,0"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                        materialDesign:ButtonProgressAssist.Value="-1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Refrescar" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarMenuButtonStyle}"
                        Width="38" Height="38" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ── S2: Four operational KPIs ── -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PickupKpiCardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Border Width="4" Background="#6D28D9" CornerRadius="12,0,0,12"
                            HorizontalAlignment="Left"/>
                    <StackPanel Margin="16,12,14,12">
                        <TextBlock Text="CUSTODIAS ACTIVAS" Style="{StaticResource PickupKpiLabelStyle}"/>
                        <TextBlock Text="{Binding ActiveCustodyCount}" Style="{StaticResource PickupKpiValueStyle}"/>
                        <TextBlock Text="{Binding ActiveCustodySubtitle}" Style="{StaticResource PickupKpiSubtitleStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PickupKpiCardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Border Width="4" Background="#D97706" CornerRadius="12,0,0,12"
                            HorizontalAlignment="Left"/>
                    <StackPanel Margin="16,12,14,12">
                        <TextBlock Text="UNIDADES POR ENTREGAR" Style="{StaticResource PickupKpiLabelStyle}"/>
                        <TextBlock Text="{Binding UnitsToDeliver, StringFormat='{}{0:0.###} uds.'}"
                                   Style="{StaticResource PickupKpiValueStyle}"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding UnitsToDeliverSubtitle}" Style="{StaticResource PickupKpiSubtitleStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PickupKpiCardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Border Width="4" Background="#0284C7" CornerRadius="12,0,0,12"
                            HorizontalAlignment="Left"/>
                    <StackPanel Margin="16,12,14,12">
                        <TextBlock Text="RETIROS PARCIALES" Style="{StaticResource PickupKpiLabelStyle}"/>
                        <TextBlock Text="{Binding PartialPickupsValue}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PickupKpiValueStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PartialPickupsCount}" Value="0">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding PartialPickupsSubtitle}" Style="{StaticResource PickupKpiSubtitleStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource PickupKpiCardStyle}">
                <Grid>
                    <Border Width="4" Background="#16A34A" CornerRadius="12,0,0,12"
                            HorizontalAlignment="Left"/>
                    <StackPanel Margin="16,12,14,12">
                        <TextBlock Text="VALOR EN CUSTODIA" Style="{StaticResource PickupKpiLabelStyle}"/>
                        <TextBlock Text="{Binding CustodyValueBsS, Converter={StaticResource LocalAmountConverter}}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CustodyValueUSD, Converter={StaticResource PrimaryAmountConverter}}"
                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"
                                   Typography.NumeralAlignment="Tabular"
                                   Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── S3: Search + segmented status filter + sort ── -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PickupSearchFrameStyle}"
                        MinWidth="340" MaxWidth="460"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify"
                                                 Width="18" Height="18" Foreground="#94A3B8"
                                                 VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <Grid Grid.Column="1">
                            <TextBox AutomationProperties.AutomationId="PendingPickups_SearchInput"
                                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     Height="Auto" Padding="10,0,4,0"/>
                            <TextBlock Text="Buscar por N° factura, cliente, cédula/RIF o producto..."
                                       IsHitTestVisible="False"
                                       FontSize="11" Foreground="#94A3B8"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Content="×"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource SettingsBareButtonStyle}"
                                Width="26" Height="26" Margin="0,0,3,0"
                                FontSize="16" Foreground="#64748B"
                                Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"
                                ToolTip="Limpiar búsqueda"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="#F1F5F9"
                        CornerRadius="8"
                        Padding="3"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding AllFilterLabel}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="{x:Static vm:PickupStatusFilter.All}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PickupFilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStatusFilter}"
                                                     Value="{x:Static vm:PickupStatusFilter.All}">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#5B21B6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding NotPickedUpFilterLabel}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="{x:Static vm:PickupStatusFilter.NotPickedUp}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PickupFilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStatusFilter}"
                                                     Value="{x:Static vm:PickupStatusFilter.NotPickedUp}">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#5B21B6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding PartialFilterLabel}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="{x:Static vm:PickupStatusFilter.Partial}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PickupFilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStatusFilter}"
                                                     Value="{x:Static vm:PickupStatusFilter.Partial}">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="Foreground" Value="#5B21B6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource SettingsFieldFrameStyle}"
                        Height="38" MinHeight="38" MinWidth="185"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <ComboBox AutomationProperties.AutomationId="PendingPickups_SortSelector"
                              Style="{StaticResource SettingsComboBoxStyle}"
                              Height="36"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>
            </Grid>
        </Border>

        <!-- Success banner above the workspace -->
        <Border Grid.Row="3"
                Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"
                Background="#DCFCE7"
                BorderBrush="#86EFAC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                         Foreground="#166534" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="#166534" FontWeight="SemiBold" FontSize="12"
                           Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── S4-S8: Master-detail dispatch workspace ── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.8*" MinWidth="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="6.2*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: custody tray ── -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0"
                            Padding="16,0">
                        <Grid>
                            <TextBlock Text="Facturas en custodia"
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#F1F5F9" CornerRadius="999" Padding="8,2">
                                <TextBlock Text="{Binding VisiblePickupCountLabel}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox AutomationProperties.AutomationId="PendingPickups_List"
                                 ItemsSource="{Binding FilteredPickups}"
                                 SelectedItem="{Binding SelectedCustody, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource PickupListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Row 1: invoice badge · status pill · main amount -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#EDE9FE"
                                                    CornerRadius="6" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InvoiceBadge}"
                                                           Foreground="#5B21B6" FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </Border>
                                            <Border Grid.Column="1" Margin="8,0,0,0"
                                                    Style="{StaticResource PickupStatusPillStyle}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource PickupStatusTextStyle}">
                                                    <Run Text="● "/><Run Text="{Binding ShortStatusLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TotalBsS, Converter={StaticResource LocalAmountConverter}}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="#0F172A"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </Grid>

                                        <!-- Row 2: customer name · cedula/RIF -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding CustomerName}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CustomerName}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CustomerCedula}"
                                                       FontSize="11.5" Foreground="#64748B"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Row 3: volume pill · date/age · USD equivalent -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Style="{StaticResource PickupVolumePillStyle}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PendingUnitsLabel}"
                                                           Style="{StaticResource PickupVolumeTextStyle}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                       Style="{StaticResource PickupMetaTextStyle}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding DateDisplay, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AgeLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding EffectiveTotalUSD, Converter={StaticResource PrimaryAmountConverter}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="#64748B"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"/>
                                        </Grid>

                                        <!-- Row 4: delivered/total mini progress -->
                                        <ProgressBar Margin="0,8,0,0"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Style="{StaticResource PickupMiniProgressBarStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- S7: left empty state -->
                        <Border Background="#FFFFFF"
                                Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="290" Margin="20">
                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                         Width="46" Height="46" Foreground="#CBD5E1"
                                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EmptyStateTitle}"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding EmptyStateDescription}"
                                           FontSize="12" Foreground="#64748B"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <Button Content="Limpiar filtros"
                                        Command="{Binding ClearFiltersCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        Height="32" Padding="14,0"
                                        HorizontalAlignment="Center" Margin="0,14,0,0"
                                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Compact paging footer -->
                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="12,6"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                        <Button Content="Cargar más retiros"
                                Command="{Binding LoadMoreCommand}"
                                Style="{StaticResource SettingsSecondaryButtonStyle}"
                                Height="30" Padding="14,0"
                                FontSize="11.5" FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoadingMore}"
                                materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                materialDesign:ButtonProgressAssist.Value="-1"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Right: active dispatch panel ── -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <!-- Detail content: hidden when no invoice is selected -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCustody}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid DataContext="{Binding SelectedCustody}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- S6: dispatch header -->
                            <Border Grid.Row="0"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="12,12,0,0"
                                    Padding="20,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <WrapPanel Grid.Column="0" Orientation="Horizontal"
                                                   VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InvoiceDisplay}"
                                                       FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Style="{StaticResource PickupStatusPillStyle}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource PickupStatusTextStyle}">
                                                    <Run Text="● "/><Run Text="{Binding DetailStatusLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#475569">
                                                    <Run Text="Pagado: "/><Run Text="{Binding PaymentDateDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalBsS, Converter={StaticResource LocalAmountConverter}}"
                                                       FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                                       HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding EffectiveTotalUSD, Converter={StaticResource PrimaryAmountConverter}}"
                                                       FontSize="12.5" Foreground="#64748B"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Compact customer card -->
                                    <Border Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34"
                                                    CornerRadius="17" Background="#EDE9FE"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName, Converter={StaticResource InitialsConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#5B21B6"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CustomerName}"/>
                                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource PickupChipStyle}"
                                                            Margin="0,0,6,4">
                                                        <TextBlock FontSize="11" Foreground="#475569">
                                                            <Run Text="Cédula/RIF: "/><Run Text="{Binding CustomerCedula, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Style="{StaticResource PickupChipStyle}" Margin="0,0,0,4">
                                                        <TextBlock FontSize="11" Foreground="#475569">
                                                            <Run Text="Teléfono: "/><Run Text="{Binding CustomerPhoneDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SettingsIconButtonStyle}"
                                                    AutomationProperties.AutomationId="PendingPickups_CopyPhoneButton"
                                                    ToolTip="Copiar teléfono"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasCustomerPhone, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding Data.CopyCustomerPhoneCommand, Source={StaticResource Proxy}}">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Delivery progress -->
                                    <StackPanel Margin="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="Progreso de entrega"
                                                       FontSize="11.5" Foreground="#64748B"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeliveryProgressLabel}"
                                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ProgressBar Margin="0,5,0,0"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Style="{StaticResource DispatchProgressBarStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- S7: product custody grid -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Items}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      VerticalGridLinesBrush="Transparent"
                                      RowHeight="48"
                                      BorderThickness="0"
                                      Background="#FFFFFF"
                                      ColumnHeaderStyle="{StaticResource PickupColumnHeaderStyle}"
                                      RowStyle="{StaticResource PickupRowStyle}"
                                      CellStyle="{StaticResource PickupCellStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.IsDeferredScrollingEnabled="False"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="PRODUCTO" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProductName}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="COMPRADO" Width="85" MinWidth="85"
                                                            HeaderStyle="{StaticResource PickupColumnHeaderCenterStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0:0.###}'}"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="ENTREGADO" Width="90" MinWidth="90"
                                                            HeaderStyle="{StaticResource PickupColumnHeaderCenterStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeliveredQuantity, StringFormat='{}{0:0.###}'}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeliveredQuantity}" Value="0">
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="PENDIENTE" Width="95" MinWidth="95"
                                                            HeaderStyle="{StaticResource PickupColumnHeaderCenterStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        CornerRadius="999" Padding="8,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEF3C7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PendingQuantity}" Value="0">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <TextBlock Text="{Binding PendingQuantity, StringFormat='{}{0:0.###}'}"
                                                                   FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PendingQuantity}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="✓ Listo" FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PendingQuantity}" Value="0">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="115" MinWidth="115"
                                                            HeaderStyle="{StaticResource PickupColumnHeaderRightStyle}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="P. UNIT. "/><Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencyDisplayCode, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UnitPriceBsS, Converter={StaticResource LocalAmountConverter}}"
                                                           FontSize="12" Foreground="#64748B"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular"
                                                           Margin="0,0,12,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="125" MinWidth="125"
                                                            HeaderStyle="{StaticResource PickupColumnHeaderRightStyle}">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="SUBTOTAL "/><Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencyDisplayCode, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SubtotalBsS, Converter={StaticResource LocalAmountConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular"
                                                           Margin="0,0,12,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- S8: fixed dispatch footer -->
                            <Border Grid.Row="2"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12"
                                    Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DispatchSummaryLabel}"
                                               FontSize="12.5" Foreground="#64748B"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="Entrega Parcial"
                                                Command="{Binding Data.ConfirmPickupCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="PendingPickups_ConfirmButton"
                                                Style="{StaticResource SettingsSecondaryButtonStyle}"
                                                Height="40" Padding="14,0" Margin="0,0,10,0"
                                                ToolTip="Abre el diálogo para ajustar cantidades y registrar una entrega parcial de esta factura."/>
                                        <Button Content="Entregar Todo (100%)"
                                                Command="{Binding Data.DeliverAllCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="PendingPickups_DeliverAllButton"
                                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                                Height="40" Padding="16,0"
                                                ToolTip="Precarga el 100% de las unidades pendientes y abre la confirmación para registrar la entrega completa."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- S7: right empty state -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCustody}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="300">
                            <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                     Width="48" Height="48" Foreground="#CBD5E1"
                                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Sin factura seleccionada"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Selecciona una factura en custodia para ver el detalle de despacho."
                                       FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Loading overlay over the workspace -->
            <Grid Grid.ColumnSpan="3"
                  Background="#CCFFFFFF"
                  IsHitTestVisible="False"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                 Foreground="#6D28D9" IsIndeterminate="True"
                                 Width="44" Height="44"/>
                    <TextBlock Text="Cargando retiros pendientes..."
                               Margin="0,12,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#475569"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
