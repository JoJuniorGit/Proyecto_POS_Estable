<UserControl x:Class="Desktop.Client.Views.CashDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             d:DataContext="{d:DesignInstance vm:CashDrawerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <Style x:Key="LocalExpectedAutomationStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter Property="AutomationProperties.AutomationId" Value="CashDrawer_BalanceText" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LocalIncomeAutomationStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter Property="AutomationProperties.AutomationId" Value="CashDrawer_TotalIncomeText" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LocalExpenseAutomationStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter Property="AutomationProperties.AutomationId" Value="CashDrawer_TotalExpenseText" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- KPI Cards -->
            <RowDefinition Height="Auto"/>   <!-- Physical Method Balances -->
            <RowDefinition Height="Auto"/>   <!-- Petty Cash Panel -->
            <RowDefinition Height="Auto"/>   <!-- Top Recent Incomes Panel -->
            <RowDefinition Height="*"/>      <!-- Transaction DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             ROW 0: HEADER CONTROLS
             ══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="Open Navigation Menu"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" />
                </Button>
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource PrimaryHueLightBrush}"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Caja de Tienda" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Gestión de saldo, ingresos y movimientos en efectivo" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" 
                        AutomationProperties.AutomationId="CashDrawer_RefreshButton"
                        Style="{DynamicResource MaterialDesignIconButton}" 
                        Margin="0,0,12,0" 
                        ToolTip="Refrescar datos de caja"
                        Foreground="{DynamicResource PrimaryHueMidBrush}">
                    <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24"/>
                </Button>
                
                <Button Command="{Binding ProcessCashInCommand}" 
                        AutomationProperties.AutomationId="CashDrawer_CashInButton"
                        IsEnabled="{Binding IsAdmin}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" ToolTip="Ingresar efectivo a caja (Solo Administradores)" Foreground="#27AE60" BorderBrush="#27AE60" Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowDownThick" VerticalAlignment="Center"/>
                        <TextBlock Text="CASH IN" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ProcessCashOutCommand}" 
                        AutomationProperties.AutomationId="CashDrawer_CashOutButton"
                        IsEnabled="{Binding IsAdmin}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" ToolTip="Retirar efectivo de caja (Solo Administradores)" Foreground="#C0392B" BorderBrush="#C0392B" Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowUpThick" VerticalAlignment="Center"/>
                        <TextBlock Text="CASH OUT" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ProcessCashAdvanceCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" ToolTip="Procesar adelanto de efectivo a cliente (Cobro electrónico)" Foreground="#2980B9" BorderBrush="#2980B9" Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashFast" VerticalAlignment="Center"/>
                        <TextBlock Text="ADELANTO EFECTIVO" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- T4 (Paso 13 / 8.188, S1): egresos de caja chica del turno (Admin/Gerente/Cajero). -->
                <Button Command="{Binding TogglePettyCashPanelCommand}"
                        AutomationProperties.AutomationId="CashDrawer_PettyCashButton"
                        IsEnabled="{Binding CanUsePettyCash}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="10,0,0,0"
                        ToolTip="Registrar y consultar gastos de caja chica del turno"
                        Foreground="#B45309" BorderBrush="#B45309"
                        Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashMinus" VerticalAlignment="Center"/>
                        <TextBlock Text="CAJA CHICA" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- T4 (8.188, S2): cierre de la sesión con arqueo USD opcional (supervisión). -->
                <Button Command="{Binding CloseCashDrawerCommand}"
                        AutomationProperties.AutomationId="CashDrawer_CloseSessionButton"
                        Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="10,0,0,0"
                        ToolTip="Arqueo y cierre de la sesión de caja (Administrador/Gerente)"
                        Foreground="#475569" BorderBrush="#94A3B8"
                        Visibility="{Binding CanCloseCashDrawer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockOutline" VerticalAlignment="Center"/>
                        <TextBlock Text="CERRAR CAJA" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════
             ROW 1: SUMMARY BY ACTIVE CURRENCY
             ══════════════════════════════════════════ -->
        <ItemsControl Grid.Row="1" Margin="0,0,0,20" ItemsSource="{Binding CurrencySummaries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DisplayLabel}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="LOCAL" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expected cash -->
                            <Border Grid.Column="0" Padding="20,16" CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="EFECTIVO ESPERADO EN CAJA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FormattedExpected}" FontSize="34" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Style="{StaticResource LocalExpectedAutomationStyle}"/>
                                            <TextBlock Text="{Binding CurrencySymbol}" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" Margin="6,0,0,8" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0">
                                            <Run Text="Fondo inicial: "/>
                                            <Run Text="{Binding CurrencySymbol, Mode=OneWay}"/>
                                            <Run Text="{Binding FormattedOpening, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PrimaryHueLightBrush}" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Bank" Width="26" Height="26" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Incomes -->
                            <Border Grid.Column="2" Padding="18,16" CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowDownThick" Width="18" Height="18" Foreground="#27AE60" VerticalAlignment="Center"/>
                                        <TextBlock Text="TOTAL INGRESOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding FormattedInflows}" FontSize="22" FontWeight="Bold" Foreground="#27AE60" Style="{StaticResource LocalIncomeAutomationStyle}"/>
                                        <TextBlock Text="{Binding CurrencySymbol}" FontSize="13" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="Acumulado en sesión" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Expenses -->
                            <Border Grid.Column="4" Padding="18,16" CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowUpThick" Width="18" Height="18" Foreground="#C0392B" VerticalAlignment="Center"/>
                                        <TextBlock Text="TOTAL EGRESOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding FormattedOutflows}" FontSize="22" FontWeight="Bold" Foreground="#C0392B" Style="{StaticResource LocalExpenseAutomationStyle}"/>
                                        <TextBlock Text="{Binding CurrencySymbol}" FontSize="13" FontWeight="Bold" Foreground="#C0392B" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="Retiros y salidas" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ══════════════════════════════════════════
             ROW 2: PETTY CASH PANEL (T4 / 8.188)
             ══════════════════════════════════════════ -->
        <Border Grid.Row="3" Margin="0,0,0,20"
                AutomationProperties.AutomationId="CashDrawer_PettyCashPanel"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10" Padding="16,14"
                Effect="{DynamicResource MaterialDesignShadowDepth1}"
                Visibility="{Binding IsPettyCashPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título + acciones -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashMinus" Width="20" Height="20" Foreground="#B45309" VerticalAlignment="Center"/>
                        <TextBlock Text="CAJA CHICA DEL TURNO" FontSize="13" FontWeight="Bold" Foreground="#B45309"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PettyCashSummary}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding RegisterPettyCashExpenseCommand}"
                                AutomationProperties.AutomationId="CashDrawer_PettyCashRegisterButton"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Foreground="#B45309" BorderBrush="#B45309" Height="32" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="REGISTRAR GASTO" FontSize="11" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshPettyCashCommand}"
                                AutomationProperties.AutomationId="CashDrawer_PettyCashRefreshButton"
                                Style="{DynamicResource MaterialDesignIconButton}"
                                ToolTip="Refrescar gastos de caja chica" Height="32" Width="32" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <Button Command="{Binding TogglePettyCashPanelCommand}"
                                AutomationProperties.AutomationId="CashDrawer_PettyCashClosePanelButton"
                                Style="{DynamicResource MaterialDesignIconButton}"
                                ToolTip="Ocultar panel de caja chica" Height="32" Width="32">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Saldos físicos del turno (arqueo ciego para no supervisores) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="ScaleBalance" Width="16" Height="16" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencySymbol, StringFormat='Efectivo físico {0}:'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PettyCashPhysicalBalanceBsSDisplay}"
                               AutomationProperties.AutomationId="CashDrawer_PettyCashBalanceBsSText"
                               FontSize="12" FontWeight="Bold" Foreground="#0F766E" Margin="4,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}">
                        <TextBlock Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='Efectivo físico {0}:'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PettyCashPhysicalBalanceUsdDisplay}"
                                   AutomationProperties.AutomationId="CashDrawer_PettyCashBalanceUsdText"
                                   FontSize="12" FontWeight="Bold" Foreground="#0F766E" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Cargando..." FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsPettyCashLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Listado virtualizado del turno -->
                <controls:PerformantDataGrid Grid.Row="2"
                          AutomationProperties.AutomationId="CashDrawer_PettyCashGrid"
                          ItemsSource="{Binding PettyCashExpenses}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          MaxHeight="240" RowHeight="46"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <controls:PerformantDataGrid.Columns>
                        <DataGridTextColumn Header="VALE" Binding="{Binding VoucherCode}" Width="90"/>
                        <DataGridTextColumn Header="FECHA / HORA" Binding="{Binding CreatedAtDisplay}" Width="130"/>
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding CategoryLabel}" Width="170"/>
                        <DataGridTemplateColumn Header="CONCEPTO / BENEFICIARIO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,2">
                                        <TextBlock Text="{Binding ConceptDisplay}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesignBody}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding BeneficiaryDisplay}" FontSize="10"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencySymbol, StringFormat='MONTO {0}'}"
                                            Binding="{Binding Expense.AmountBsS, Converter={StaticResource LocalAmountConverter}}" Width="120"/>
                        <DataGridTextColumn Header="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='MONTO {0}'}"
                                            Binding="{Binding Expense.AmountUsd, Converter={StaticResource PrimaryAmountConverter}}"
                                            Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                            Width="110"/>
                        <DataGridTemplateColumn Header="ESTADO" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="AUTORIZADOR" Binding="{Binding AuthorizerDisplay}" Width="110"/>
                        <DataGridTemplateColumn Header="ACCIONES" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding Data.PrintPettyCashVoucherCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Descargar vale del gasto"
                                                Style="{DynamicResource MaterialDesignIconButton}" Height="28" Width="28"
                                                ToolTip="Descargar / imprimir vale">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Foreground="#B45309"/>
                                        </Button>
                                        <Button Command="{Binding Data.CancelPettyCashExpenseCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Anular gasto de caja chica"
                                                Style="{DynamicResource MaterialDesignIconButton}" Height="28" Width="28"
                                                ToolTip="Anular gasto (solo activos)"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16" Foreground="#B91C1C"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </controls:PerformantDataGrid.Columns>
                </controls:PerformantDataGrid>

                <TextBlock Grid.Row="2" Text="No hay gastos de caja chica registrados en este turno."
                           FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"
                           HorizontalAlignment="Center" Margin="0,20,0,20"
                           Visibility="{Binding HasPettyCashExpenses, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             ROW 3: TOP RECENT INCOMES PANEL
             ══════════════════════════════════════════ -->
        <Border Grid.Row="4" Margin="0,0,0,20"
                Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="10" Padding="16,14"
                Effect="{DynamicResource MaterialDesignShadowDepth1}"
                Visibility="{Binding HasRecentIncomes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- Section Title (Margen amplio mb-4) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="CashCheck" Width="20" Height="20" Foreground="#27AE60" VerticalAlignment="Center"/>
                    <TextBlock Text="ÚLTIMOS INGRESOS RECIBIDOS" FontSize="13" FontWeight="Bold" Foreground="#27AE60" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Cards horizontal scroll container for recent incomes (Evita compresión y cortes) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding RecentIncomes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" CornerRadius="8" Padding="14,12" Margin="0,0,12,0" 
                                        BorderBrush="#ABEBC6" BorderThickness="1" MinWidth="180">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Invoice Number / Description (Gris Oscuro / Sólido #1E293B, Centrado) -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding FormattedInvoiceNumber}"
                                                   FontWeight="Bold" FontSize="13"
                                                   Foreground="#1E293B"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Time (Gris claro, Centrado) -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,6">
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="12" Height="12" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding TransactionTimeLocal, StringFormat={}{0:hh:mm tt}}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>

                                        <!-- Local amount + primary duplicate (green reserved for amounts, centered) -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AmountBsS, Converter={StaticResource LocalAmountConverter}}"
                                                       FontWeight="ExtraBold" FontSize="13"
                                                       Foreground="#27AE60"/>
                                            <TextBlock Text="{Binding AmountUsd, Converter={StaticResource PrimaryAmountConverter}}"
                                                       Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        
        <!-- ══════════════════════════════════════════
             ROW 4: TRANSACTION LIST
             ══════════════════════════════════════════ -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="Movimientos de Caja (Físicos)" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            
            <controls:PerformantDataGrid Grid.Row="1" ItemsSource="{Binding OrderedTransactions}" 
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:PerformantDataGrid.Columns>
                    
                    <!-- FECHA / HORA (Columna Apilada) -->
                    <DataGridTemplateColumn Header="FECHA / HORA" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,2">
                                    <TextBlock Text="{Binding TransactionTimeLocal, StringFormat={}{0:dd/MM/yyyy}}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text="{Binding TransactionTimeLocal, StringFormat={}{0:hh:mm tt}}"
                                               FontSize="10"
                                               Foreground="Gray"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Tipo (Badge) -->
                    <DataGridTemplateColumn Header="Tipo" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EAECEE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Income">
                                                    <Setter Property="Background" Value="#E8F8F5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                    <Setter Property="Background" Value="#FDEDEC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Type}"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Income">
                                                        <Setter Property="Text" Value="Ingreso"/>
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                        <Setter Property="Text" Value="Egreso"/>
                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Origen -->
                    <DataGridTextColumn Header="Origen" Binding="{Binding SourceDisplay}" Width="130"/>

                    <!-- Factura N° / Detalle -->
                    <DataGridTextColumn Header="Factura / Detalle" Binding="{Binding FormattedInvoiceNumber}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Local amount -->
                    <DataGridTextColumn Header="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencySymbol, StringFormat='Monto ({0})'}"
                                        Binding="{Binding AmountBsS, Converter={StaticResource LocalAmountConverter}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Primary-currency duplicate (hidden in Single) -->
                    <DataGridTextColumn Header="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode}"
                                        Binding="{Binding AmountUsd, Converter={StaticResource PrimaryAmountConverter}}"
                                        Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Exchange rate only exists in Dual -->
                    <DataGridTextColumn Header="Tasa" Binding="{Binding ExchangeRate, StringFormat={}{0:N2}}"
                                        Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </controls:PerformantDataGrid.Columns>
            </controls:PerformantDataGrid>

            <!-- Pie de página con Paginación (hasta 25 movimientos por página) -->
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="4,4"
                    Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}"
                               VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalPhysicalTransactions, StringFormat={}Total registros: {0}}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" Foreground="Gray"/>

                        <Button Command="{Binding PreviousPageCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="8,0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Anterior" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding CurrentPageDisplay}"
                                   VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                   Margin="8,0"/>

                        <Button Command="{Binding NextPageCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="8,0" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Siguiente" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 8.201 (S1): apertura dual de caja (fondo Bs.S + USD). Overlay solo sin sesión. -->
        <Border Grid.Row="0" Grid.RowSpan="6" Background="#66000000"
                Visibility="{Binding IsSessionInactive, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="CashDrawer_OpenOverlay">
            <Border Width="520" Padding="28" CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="CashRegister" Width="28" Height="28"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="Abrir Caja" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Declare el fondo físico inicial de cada gaveta."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                        <TextBlock Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='El fondo {0} queda segregado y se transfiere automáticamente al turno siguiente.'}"
                                   Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding OpeningPhysicalMethods}"
                                  Visibility="{Binding HasOpeningPhysicalMethods, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CurrencySymbol}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Fondo *"
                                             Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox materialDesign:HintAssist.Hint="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencySymbol, StringFormat='Fondo inicial {0} *'}"
                             Text="{Binding OpeningBalanceLocalText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowLegacyOpeningInputs, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             AutomationProperties.AutomationId="CashDrawer_OpeningBalanceLocal"
                             Margin="0,0,0,14"/>
                    <TextBox materialDesign:HintAssist.Hint="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyCode, StringFormat='Fondo inicial {0}'}"
                             Text="{Binding OpeningBalanceUsdText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowLegacyOpeningInputs, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             AutomationProperties.AutomationId="CashDrawer_OpeningBalanceUsd"
                             Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding OpeningRateDisplay}"
                               Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                               FontSize="12" Opacity="0.7" Margin="0,0,0,18"/>
                    <Button Command="{Binding OpenCashDrawerCommand}"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            IsDefault="True"
                            AutomationProperties.AutomationId="CashDrawer_OpenSessionButton"
                            HorizontalAlignment="Right" MinWidth="150" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOpen" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ABRIR CAJA" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>

