<UserControl x:Class="Desktop.Client.Views.CashTransactionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:b="clr-namespace:Desktop.Client.Behaviors"
             Width="400" Padding="24">
    <StackPanel>
        <!-- Header -->
        <TextBlock x:Name="TitleText" Text="Cash Transaction" 
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Enter the amount and reason below."
                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                   Margin="0,0,0,24" TextWrapping="Wrap"/>

        <!-- Amount (Integer Only using Behavior) -->
        <TextBox x:Name="AmountBox"
                 b:IntegerTextBoxBehavior.IsIntegerOnly="True"
                 materialDesign:HintAssist.Hint="Amount"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 FontSize="18"
                 Margin="0,0,0,16" />

        <!-- Description (Reason) -->
        <TextBox x:Name="ReasonBox"
                 materialDesign:HintAssist.Hint="Reason / Description (Max 40 chars)"
                 materialDesign:HintAssist.HelperText="Máximo 40 caracteres"
                 materialDesign:HintAssist.IsFloating="True"
                 MaxLength="40"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="70"
                 Margin="0,0,0,8" />

        <!-- Error Message -->
        <TextBlock x:Name="ErrorText" 
                   Foreground="{DynamicResource PrimaryHueLightBrush}" 
                   Visibility="Collapsed" 
                   Margin="0,0,0,16" TextWrapping="Wrap" />

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCEL" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    Margin="0,0,8,0"/>
            
            <Button Content="CONFIRM"
                    Click="Confirm_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource PrimaryHueMidBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
