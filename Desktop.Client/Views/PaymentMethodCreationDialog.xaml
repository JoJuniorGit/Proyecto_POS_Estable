<Window x:Class="Desktop.Client.Views.PaymentMethodCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Nuevo Método de Pago"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Nuevo Método de Pago"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                       FontWeight="Bold"/>
            <TextBlock Text="Definí el nombre y, si corresponde, la comisión que cobra el medio. La comisión es un costo del negocio y no se suma al cliente."
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource NavTextMutedBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBox x:Name="NameTextBox"
                         materialDesign:HintAssist.Hint="Nombre del método"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>

                <CheckBox x:Name="IsCashCheckBox"
                          Content="Es Efectivo (Físico)"
                          Margin="0,0,0,8"
                          Checked="Cash_Changed"
                          Unchecked="Cash_Changed"/>
                <CheckBox x:Name="RequiresReferenceCheckBox"
                          Content="Requiere referencia"
                          Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,14"/>

                <TextBlock Text="Comisión del método (opcional)"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="El mantenimiento de cuenta y los gastos mensuales del POS no se ingresan acá: se registran como gasto operativo del período."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Opacity="0.7"
                           Margin="0,0,0,12"/>

                <ComboBox x:Name="FeeTypeComboBox"
                          materialDesign:HintAssist.Hint="Tipo de comisión"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,12"
                          SelectedIndex="0"
                          SelectionChanged="FeeType_SelectionChanged">
                    <ComboBoxItem Content="Porcentaje (%)" Tag="0"/>
                    <ComboBoxItem Content="Monto fijo por transacción" Tag="1"/>
                    <ComboBoxItem Content="Porcentaje + fijo" Tag="2"/>
                </ComboBox>

                <TextBox x:Name="PercentageTextBox"
                         materialDesign:HintAssist.Hint="Porcentaje (%)"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>
                <TextBox x:Name="FixedAmountTextBox"
                         materialDesign:HintAssist.Hint="Monto fijo por transacción"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>
                <TextBox x:Name="CurrencyTextBox"
                         materialDesign:HintAssist.Hint="Moneda de la comisión (USD / moneda local)"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         Text="USD"
                         MaxLength="10"
                         Margin="0,0,0,8"/>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#EE5353"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCELAR"
                    Click="Cancel_Click"
                    Style="{DynamicResource MaterialDesignFlatButton}"
                    IsCancel="True"
                    Margin="0,0,12,0"/>
            <Button Content="CREAR MÉTODO"
                    Click="Save_Click"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
