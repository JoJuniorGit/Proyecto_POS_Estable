<Window x:Class="Desktop.Client.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
        xmlns:converters="clr-namespace:Desktop.Client.Converters"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"        
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding DialogTitle}" Height="720" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding DialogTitle}" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold"/>
            
            <Border Visibility="{Binding UserSession.CanMutateCatalog, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="LockOutline" Foreground="#D97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios están bloqueados."
                               Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- MAIN FORM WITH SCROLLVIEWER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" /> <!-- Spacing -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- LEFT COLUMN: Basic Info & Categorization -->
                <StackPanel Grid.Column="0">
                    <!-- 1. Tarjeta de Información Básica -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="16,14,16,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                        <StackPanel>
                            <TextBlock Text="Información Básica" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,14"/>
                            
                            <!-- 1.1 Nombre del Producto -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="PackageVariantClosed" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,14,0,0" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             materialDesign:HintAssist.Hint="Nombre del Producto *" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="1"/>
                                    <TextBlock Text="ej. Coca Cola 2L" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1.2 SKU / Código de Barras -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Barcode" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,14,0,0" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox" 
                                             materialDesign:HintAssist.Hint="Código de Barras / SKU *" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="2"/>
                                    <TextBlock Text="Número entero (solo dígitos 0-9)" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                    <TextBlock Text="{Binding SkuVerificationMessage}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="10" Margin="4,2,0,0" Visibility="{Binding IsSkuVerifying, Converter={StaticResource BoolToVisConverter}}"/>
                                    <TextBlock Text="{Binding SkuVerificationMessage}" Foreground="Red" FontSize="10" Margin="4,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSkuVerifying}" Value="False" />
                                                            <Condition Binding="{Binding IsSkuValid}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 1.3 Descripción / Detalles -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="TextSubject" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,14,0,0" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                             materialDesign:HintAssist.Hint="Descripción / Detalles" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" 
                                             TabIndex="3"/>
                                    <TextBlock Text="Texto opcional" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1.4 Unidad de Medida -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ScaleBalance" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,14,0,0" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding UnitOfMeasureTypes}" SelectedItem="{Binding UnitOfMeasureType}" 
                                              IsEnabled="{Binding CanEditPricing}" 
                                              materialDesign:HintAssist.Hint="Unidad de Medida" 
                                              materialDesign:HintAssist.IsFloating="True"
                                              Style="{DynamicResource MaterialDesignOutlinedComboBox}" 
                                              TabIndex="4"/>
                                    <TextBlock Text="Und, Kg, Grs, Lt, etc." Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1.5 Producto Padre Selection (para Variantes) -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding IsGroupHeader, Converter={StaticResource InverseBoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="FamilyTree" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,14,0,0" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding ParentProducts}" 
                                              SelectedItem="{Binding SelectedParentProduct}"
                                              IsEnabled="{Binding CanSelectParentProduct}"
                                              DisplayMemberPath="Name"
                                              materialDesign:HintAssist.Hint="Producto Padre (Opcional)" 
                                              materialDesign:HintAssist.IsFloating="True"
                                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"/>
                                    <TextBlock Text="Hereda precios y costos automáticamente" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Tarjeta de Propiedades Especiales y Variantes -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="16,14,16,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                        <StackPanel>
                            <TextBlock Text="Propiedades Especiales" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>

                            <CheckBox IsChecked="{Binding IsGroupHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      FontWeight="Bold" 
                                      Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                      Margin="0,0,0,6" 
                                      ToolTip="{Binding GroupHeaderToolTip}"
                                      AutomationProperties.HelpText="{Binding GroupHeaderToolTip}"
                                      IsEnabled="{Binding CanEditGroupHeader}">
                                <TextBlock Text="Agrupador de Presentaciones" TextWrapping="Wrap"/>
                            </CheckBox>
                            
                            <!-- Sub-opciones de Grupo -->
                            <StackPanel Margin="22,0,0,6" Visibility="{Binding IsGroupHeader, Converter={StaticResource BoolToVisConverter}}">
                                <CheckBox IsChecked="{Binding IsStockShared, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditStockShared}"
                                          FontWeight="SemiBold"
                                          ToolTip="Todas las presentaciones descontarán unidades del mismo total."
                                          Margin="0,0,0,6">
                                    <TextBlock Text="Inventario compartido (Stock centralizado)" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding HasIndependentPricing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanEditIndependentPricing}"
                                          FontWeight="SemiBold"
                                          ToolTip="Permite asignar un costo y precio de venta distinto a cada opción."
                                          Margin="0,0,0,4">
                                    <TextBlock Text="Precios individuales por presentación" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>

                            <CheckBox IsChecked="{Binding IsFractional, UpdateSourceTrigger=PropertyChanged}" 
                                      FontWeight="SemiBold" 
                                      ToolTip="Habilita la venta usando decimales o peso (Ej. 1,5 Kg)."
                                      Margin="0,0,0,6" 
                                      IsEnabled="{Binding CanEditFractional}">
                                <TextBlock Text="Permitir venta fraccionada (a granel)" TextWrapping="Wrap"/>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding IsCashAdvance, UpdateSourceTrigger=PropertyChanged}" 
                                      ToolTip="Este producto habilita el servicio de entrega de dinero en efectivo en el POS" 
                                      IsEnabled="{Binding IsGroupHeader, Converter={StaticResource InverseBoolConverter}}" 
                                      Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Es Servicio de Adelanto de Efectivo (Retira de gaveta)" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Pricing & Inventory -->
                <StackPanel Grid.Column="2">
                    <!-- Banner Informativo: Precios Individuales por Presentación -->
                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="14,14" Margin="0,0,0,16" Visibility="{Binding ShowIndependentPricingNotice, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="TagMultiple" Foreground="#7C3AED" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Precios Individuales por Presentación" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="Este producto agrupa presentaciones con costos y precios individuales. Las tarifas no se definen en el agrupador padre, sino en cada una de sus variantes." 
                                       TextWrapping="Wrap" Foreground="#5B21B6" FontSize="12" LineHeight="16"/>
                            <Button Content="Administrar Variantes"
                                    Command="{Binding ManageVariantsCommand}"
                                    Visibility="{Binding ShowManageVariantsButton, Converter={StaticResource BoolToVisConverter}}"
                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Contenedor de Precios y Costos -->
                    <StackPanel Visibility="{Binding ShowPricingInputs, Converter={StaticResource BoolToVisConverter}}">
                        <!-- 1. Costo Base USD -->
                        <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="14,12,14,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                            <StackPanel>
                                <TextBlock Text="Costo de Adquisición" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>
                                <TextBox helpers:AtmBehavior.Mode="Currency"
                                         helpers:AtmBehavior.Value="{Binding CostPriceUSD, Mode=TwoWay}"
                                         helpers:AtmBehavior.RecalculateTrigger="Cost"
                                         IsEnabled="{Binding CanEditPricing}"
                                         materialDesign:HintAssist.Hint="Costo Base ($ USD) *" 
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                         TabIndex="5"/>
                                <TextBlock Text="Costo unitario de compra o adquisición" Foreground="#64748B" FontSize="11" Margin="4,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Sección Detal -->
                        <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="14,12,14,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                            <StackPanel>
                                <TextBlock Text="Venta Al Detal" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             helpers:AtmBehavior.Mode="Percentage"
                                             helpers:AtmBehavior.Value="{Binding ProfitMarginRetail, Mode=TwoWay}"
                                             helpers:AtmBehavior.RecalculateTrigger="MarginRetail"
                                             IsEnabled="{Binding CanEditPricing}"
                                             materialDesign:HintAssist.Hint="Margen %" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="6"/>
                                    <TextBox Grid.Column="2" 
                                             helpers:AtmBehavior.Mode="Currency"
                                             helpers:AtmBehavior.Value="{Binding PriceRetailUSD, Mode=TwoWay}"
                                             helpers:AtmBehavior.RecalculateTrigger="PriceRetail"
                                             IsEnabled="{Binding CanEditPricing}"
                                             materialDesign:HintAssist.Hint="Precio Detal $" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="7"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Equivalente: " FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding PriceRetailBsS, StringFormat='Bs.S {0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Sección Mayor -->
                        <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="14,12,14,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Venta Al Mayor" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding HasWholesale}" IsEnabled="{Binding CanEditPricing}" HorizontalAlignment="Right" FontWeight="SemiBold">
                                        <TextBlock Text="Habilitar Precio al Mayor"/>
                                    </CheckBox>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             helpers:AtmBehavior.Mode="Percentage"
                                             helpers:AtmBehavior.Value="{Binding ProfitMarginWholesale, Mode=TwoWay}"
                                             helpers:AtmBehavior.RecalculateTrigger="MarginWholesale"
                                             IsEnabled="{Binding CanEditWholesale}" 
                                             materialDesign:HintAssist.Hint="Margen Mayor %" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="8"/>
                                    <TextBox Grid.Column="2" 
                                             helpers:AtmBehavior.Mode="Currency"
                                             helpers:AtmBehavior.Value="{Binding PriceWholesaleUSD, Mode=TwoWay}"
                                             helpers:AtmBehavior.RecalculateTrigger="PriceWholesale"
                                             IsEnabled="{Binding CanEditWholesale}" 
                                             materialDesign:HintAssist.Hint="Precio Mayor $" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="9"/>
                                </Grid>
                                <TextBox helpers:AtmBehavior.Mode="Quantity"
                                         helpers:AtmBehavior.Value="{Binding MinWholesaleQuantity, Mode=TwoWay}"
                                         IsEnabled="{Binding CanEditWholesale}" 
                                         materialDesign:HintAssist.Hint="Cantidad Mínima al Mayor (ej. 6)" 
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                         Margin="0,0,0,6"
                                         TabIndex="10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Equivalente: " FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding PriceWholesaleBsS, StringFormat='Bs.S {0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. Stock & Inventario (Para productos físicos) -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="14,12,14,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}" Visibility="{Binding ShowStockInputs, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Stock &amp; Inventario" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>

                            <!-- Creation Mode: Stock Inicial + Alerta Mínimo -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox helpers:AtmBehavior.Mode="Quantity"
                                             helpers:AtmBehavior.Value="{Binding StockQuantity, Mode=TwoWay}"
                                             materialDesign:HintAssist.Hint="Stock Inicial" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="11"/>
                                    <TextBlock Text="Cantidad actual" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox helpers:AtmBehavior.Mode="Quantity"
                                             helpers:AtmBehavior.Value="{Binding LowStockThreshold, Mode=TwoWay}"
                                             materialDesign:HintAssist.Hint="Alerta Mínimo" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="12"/>
                                    <TextBlock Text="Umbral de aviso" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Edit Mode: Alerta Mínimo (col 0) + Stock Actual de Solo Lectura (col 2) -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox helpers:AtmBehavior.Mode="Quantity"
                                             helpers:AtmBehavior.Value="{Binding LowStockThreshold, Mode=TwoWay}"
                                             materialDesign:HintAssist.Hint="Alerta Mínimo" 
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                             TabIndex="11"/>
                                    <TextBlock Text="Umbral de aviso" Foreground="#64748B" FontSize="11" Margin="4,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="6" BorderThickness="0" Padding="12,6" Height="52" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Stock Actual (Solo Lectura)" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CurrentStockDisplay}" FontSize="13" FontWeight="Bold" Foreground="#334155"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4.1 Factor de Conversión (Para variantes con stock compartido) -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="14,12,14,16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#0284C7" Visibility="{Binding ShowConversionFactorInput, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0" Width="18" Height="18"/>
                                <TextBlock Text="Factor de Conversión (Equivalencia Base)" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox helpers:AtmBehavior.Mode="Quantity"
                                     helpers:AtmBehavior.Value="{Binding ConversionFactor, Mode=TwoWay}"
                                     materialDesign:HintAssist.Hint="Unidades Base del Padre *" 
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                     TabIndex="11"/>
                            <TextBlock Text="Cant. que descuenta del padre al vender 1 unidad de esta variante (ej. 30)" Foreground="#64748B" FontSize="11" Margin="4,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Banner informativo de Adelanto de Efectivo -->
                    <Border Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding IsCashAdvance, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Foreground="#6D28D9" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                            <TextBlock Text="Este producto es un Servicio de Adelanto de Efectivo (no requiere inventario numérico)." Foreground="#6D28D9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER: Actions -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Administrar Variantes" 
                    Command="{Binding ManageVariantsCommand}" 
                    Visibility="{Binding ShowManageVariantsButton, Converter={StaticResource BoolToVisConverter}}"
                    Style="{DynamicResource MaterialDesignOutlinedButton}" 
                    HorizontalAlignment="Left" TabIndex="14"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,15,0" IsCancel="True" TabIndex="13"/>
                <Button Content="Guardar" Command="{Binding SaveCommand}" IsEnabled="{Binding UserSession.CanMutateCatalog}" Style="{DynamicResource MaterialDesignRaisedButton}" IsDefault="True" TabIndex="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
