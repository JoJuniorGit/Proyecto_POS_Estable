<Window x:Class="Desktop.Client.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"        
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="{Binding DialogTitle}" Height="680" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding DialogTitle}" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold"/>
            
            <Border Visibility="{Binding UserSession.CanMutateCatalog, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="LockOutline" Foreground="#D97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios están bloqueados."
                               Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- MAIN FORM WITH SCROLLVIEWER -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" /> <!-- Spacing -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Basic Info & Categorization -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Basic Information" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,15"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignTextBoxBorder}"/>
                        <TextBlock Text="Product Name" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Name *" materialDesign:HintAssist.HelperText="e.g. Coca Cola 2L" Style="{DynamicResource MaterialDesignOutlinedTextBox}" TabIndex="1"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Barcode" VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignTextBoxBorder}"/>
                        <TextBlock Text="SKU / Barcode" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberValidationTextBox" materialDesign:HintAssist.Hint="Código de Barras / SKU *" materialDesign:HintAssist.HelperText="Número entero (solo dígitos 0-9)" Style="{DynamicResource MaterialDesignOutlinedTextBox}" TabIndex="2"/>
                        <TextBlock Text="{Binding SkuVerificationMessage}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="10" Visibility="{Binding IsSkuVerifying, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Text="{Binding SkuVerificationMessage}" Foreground="Red" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSkuVerifying}" Value="False" />
                                                <Condition Binding="{Binding IsSkuValid}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,15,0,0">
                        <materialDesign:PackIcon Kind="TextSubject" VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignTextBoxBorder}"/>
                        <TextBlock Text="Description" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Details" materialDesign:HintAssist.HelperText="Optional text" Style="{DynamicResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" TabIndex="3"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ScaleBalance" VerticalAlignment="Center" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignTextBoxBorder}"/>
                        <TextBlock Text="Unidad de Medida" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding UnitOfMeasureTypes}" SelectedItem="{Binding UnitOfMeasureType}" materialDesign:HintAssist.Hint="Unidad" materialDesign:HintAssist.HelperText="Und, Kg, Grs, Lt, etc." Style="{DynamicResource MaterialDesignOutlinedComboBox}" TabIndex="4"/>
                </Grid>

                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="1">
                        <CheckBox Content="Producto Fraccionable (Venta por peso/granel)" IsChecked="{Binding IsFractional, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>
                        <CheckBox Content="Is Cash Advance Limit (deducts from drawer)" IsChecked="{Binding IsCashAdvance, UpdateSourceTrigger=PropertyChanged}" ToolTip="This product triggers physical cash withdrawal in the POS"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- RIGHT COLUMN: Pricing & Inventory -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Costo &amp; Precios" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>

                <!-- 1. Costo Base USD -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Costo Base ($ USD)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Column="1" 
                             helpers:AtmBehavior.Mode="Currency"
                             helpers:AtmBehavior.Value="{Binding CostPriceUSD, Mode=TwoWay}"
                             helpers:AtmBehavior.RecalculateTrigger="Cost"
                             materialDesign:HintAssist.Hint="0.00 $" 
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                             TabIndex="5"/>
                </Grid>

                <!-- 2. Sección Detal -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="10" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueLightBrush}">
                    <StackPanel>
                        <TextBlock Text="Venta Al Detal" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     helpers:AtmBehavior.Mode="Percentage"
                                     helpers:AtmBehavior.Value="{Binding ProfitMarginRetail, Mode=TwoWay}"
                                     helpers:AtmBehavior.RecalculateTrigger="MarginRetail"
                                     materialDesign:HintAssist.Hint="Margen %" 
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                     TabIndex="6"/>
                            <TextBox Grid.Column="2" 
                                     helpers:AtmBehavior.Mode="Currency"
                                     helpers:AtmBehavior.Value="{Binding PriceRetailUSD, Mode=TwoWay}"
                                     helpers:AtmBehavior.RecalculateTrigger="PriceRetail"
                                     materialDesign:HintAssist.Hint="Precio Detal $" 
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                     TabIndex="7"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Equivalente Bs.S: " FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding PriceRetailBsS, StringFormat='Bs.S {0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Sección Mayor -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="10" Margin="0,0,0,15" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Venta Al Mayor" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" Content="Habilitar Precio al Mayor" IsChecked="{Binding HasWholesale}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#10B981"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     helpers:AtmBehavior.Mode="Percentage"
                                     helpers:AtmBehavior.Value="{Binding ProfitMarginWholesale, Mode=TwoWay}"
                                     helpers:AtmBehavior.RecalculateTrigger="MarginWholesale"
                                     IsEnabled="{Binding HasWholesale}" 
                                     materialDesign:HintAssist.Hint="Margen Mayor %" 
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                     TabIndex="8"/>
                            <TextBox Grid.Column="2" 
                                     helpers:AtmBehavior.Mode="Currency"
                                     helpers:AtmBehavior.Value="{Binding PriceWholesaleUSD, Mode=TwoWay}"
                                     helpers:AtmBehavior.RecalculateTrigger="PriceWholesale"
                                     IsEnabled="{Binding HasWholesale}" 
                                     materialDesign:HintAssist.Hint="Precio Mayor $" 
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                                     TabIndex="9"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cant. Mínima" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding MinWholesaleQuantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasWholesale}" materialDesign:HintAssist.Hint="Mín. Mayor (ej. 6)" Style="{DynamicResource MaterialDesignOutlinedTextBox}" TabIndex="10"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Equivalente Bs.S: " FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="{Binding PriceWholesaleBsS, StringFormat='Bs.S {0:N2}'}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stock & Alert -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditMode, Converter={x:Static materialDesign:Converters.NotConverter.Instance}}" materialDesign:HintAssist.Hint="Stock Inicial" Style="{DynamicResource MaterialDesignOutlinedTextBox}" TabIndex="11"/>
                    <TextBox Grid.Column="2" Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Alerta Mínimo" Style="{DynamicResource MaterialDesignOutlinedTextBox}" TabIndex="12"/>
                </Grid>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!-- FOOTER: Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cerrar" Command="{Binding CancelCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,20,0" IsCancel="True" TabIndex="11"/>
            <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding UserSession.CanMutateCatalog}" Style="{DynamicResource MaterialDesignRaisedButton}" IsDefault="True" TabIndex="10"/>
        </StackPanel>
    </Grid>
</Window>
