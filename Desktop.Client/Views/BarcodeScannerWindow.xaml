<Window x:Class="Desktop.Client.Views.BarcodeScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Barcode Scanner &amp; Text (OCR)"
        Height="640" Width="760"
        MinHeight="580" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ Header: title + camera indicator ══════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="BarcodeScan" Width="22" Height="22"
                                          Foreground="{DynamicResource PrimaryHueMidBrush}"
                                          VerticalAlignment="Center"/>
                <TextBlock Text="Barcode Scanner &amp; Text (OCR)" FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="CameraDot" Width="10" Height="10" Fill="Gray"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="CameraStatusText" Text="Starting camera…" FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══════════ Mode toggle ══════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="BarcodeModeRadio" Content="Barcode" IsChecked="True"
                         GroupName="ScannerMode" Checked="Mode_Changed"
                         Style="{DynamicResource MaterialDesignRadioButton}"/>
            <RadioButton x:Name="OcrModeRadio" Content="Text (OCR)" GroupName="ScannerMode"
                         Checked="Mode_Changed" Margin="16,0,0,0"
                         Style="{DynamicResource MaterialDesignRadioButton}"/>
        </StackPanel>

        <!-- ══════════ Camera preview ══════════ -->
        <Border Grid.Row="2" Background="Black" CornerRadius="6"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>

                <!-- Placeholder shown while the camera is off / unavailable -->
                <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="CameraOff" Width="44" Height="44"
                                             Foreground="#889" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PreviewPlaceholderText" Text="Camera is off"
                               Foreground="#BBB" FontSize="13" Margin="0,10,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>

                <!-- Scan target overlay (barcode mode only) -->
                <Rectangle x:Name="ScanOverlay" Width="340" Height="96"
                           Stroke="#66FFFFFF" StrokeThickness="2"
                           StrokeDashArray="6 4" RadiusX="8" RadiusY="8"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsHitTestVisible="False" Margin="0,0,0,24"/>

                <!-- Status strip over the feed -->
                <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="12,7">
                    <TextBlock x:Name="StatusText" Text="Point the camera at a barcode…"
                               Foreground="White" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ OCR controls (text mode only) ══════════ -->
        <Grid x:Name="OcrPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CaptureTextButton" Click="CaptureText_Click"
                        Style="{DynamicResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TextRecognition" Width="18" Height="18"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Capture &amp; Read Text" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyTextButton" Click="CopyOcrText_Click"
                        Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="8,0,0,0"
                        Content="Copy text" IsEnabled="False"/>
                <TextBlock x:Name="OcrLanguageText" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </StackPanel>
            <TextBox x:Name="OcrTextBox" Grid.Row="1" Margin="0,8,0,0" Height="120"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="13"
                     materialDesign:HintAssist.Hint="Recognized text — editable; select any portion to copy"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
        </Grid>

        <!-- ══════════ History ══════════ -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Recent (last 5)" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,6"/>
            <ListBox x:Name="HistoryList" Grid.Row="1" MaxHeight="116" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseLeftButtonUp="HistoryList_MouseLeftButtonUp"
                     ToolTip="Click an item to copy it again">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding}" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ══════════ Footer: privacy notice + close ══════════ -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         VerticalAlignment="Center"/>
                <TextBlock Text="Privacy: the camera is used only for scanning. No images are stored or uploaded."
                           Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="11"
                           TextWrapping="Wrap" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close (Esc)" Click="CloseButton_Click"
                    Style="{DynamicResource MaterialDesignFlatButton}" HorizontalAlignment="Right"
                    Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
