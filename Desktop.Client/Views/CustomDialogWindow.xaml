<Window x:Class="Desktop.Client.Views.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}" MinHeight="180" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">

    <Grid Margin="16">
        <Border Background="{DynamicResource MaterialDesignPaper}" 
                CornerRadius="8" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" />
            </Border.Effect>
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Title Header -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Margin="0,0,0,12" />

                <!-- Message Body with Icon -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:PackIcon x:Name="DialogIcon"
                                             Kind="HelpCircle" 
                                             Width="40" Height="40" 
                                             VerticalAlignment="Top" 
                                             Margin="0,2,16,0" />
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding Message}" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Normal" 
                               TextWrapping="Wrap" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </Grid>

                <!-- Actions / Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnNo"
                            Content="No" 
                            IsCancel="True"
                            Click="BtnNo_Click"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Margin="0,0,12,0"
                            MinWidth="90"
                            Visibility="Collapsed" />
                    
                    <Button x:Name="BtnYes"
                            Content="Sí" 
                            IsDefault="True"
                            Click="BtnYes_Click"
                            Style="{DynamicResource MaterialDesignRaisedButton}" 
                            MinWidth="90" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
