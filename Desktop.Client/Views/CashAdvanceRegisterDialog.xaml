<Window x:Class="Desktop.Client.Views.CashAdvanceRegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"        
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Adelanto de Efectivo" Height="580" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="CashFast" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Adelanto de Efectivo" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="12,10" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                <Grid>
                    <TextBlock Text="DISPONIBLE EN MÉTODO:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding DispensedAvailableDisplay}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Form & Calculations -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,5,5,5">
                <!-- 8.212-WU4: physical dispenser selector -->
                <TextBlock Text="1. Método Físico que Entrega el Efectivo" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding PhysicalCashMethods}"
                          SelectedItem="{Binding SelectedDispensedCashMethod, UpdateSourceTrigger=PropertyChanged}"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Seleccione la gaveta física *"
                          Margin="0,0,0,6"
                          Visibility="{Binding HasPhysicalCashMethods, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Name}"/>
                                <Run Text=" ("/><Run Text="{Binding CurrencyCode}"/><Run Text=") — Disponible: "/>
                                <Run Text="{Binding CurrencySymbol}"/><Run Text="{Binding CurrentBalance, StringFormat='{}{0:N2}'}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ProjectedBalanceDisplay}" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Visibility="{Binding HasPhysicalCashMethods, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Amount Requested -->
                <TextBlock Text="2. Monto Entregado al Cliente (Efectivo)" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                <TextBox x:Name="RequestedAmountInput" 
                         materialDesign:HintAssist.Hint="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencySymbol, StringFormat='Monto en {0} *'}" 
                         materialDesign:HintAssist.HelperText="Ingrese la cantidad en efectivo a retirar de caja"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                         Text="{Binding RequestedAmountBsS, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="0,0,0,16"/>

                <!-- Payment Method Selection -->
                <TextBlock Text="3. Método de Cobro al Cliente (Solo Electrónico)" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Medium" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding ElectronicPaymentMethods}"
                          SelectedItem="{Binding SelectedPaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Seleccione Método Electrónico *"
                          Margin="0,0,0,18"/>

                <!-- Financial Breakdown Card -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#3B82F6" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="RESUMEN FINANCIERO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Salida de Efectivo de Caja:" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding RequestedAmountDisplay, StringFormat='-{0}'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#EF4444"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Comisión de Ganancia (" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding CommissionPercentage, StringFormat='{}{0:0}%'}" Foreground="{DynamicResource MaterialDesignBodyLight}" FontWeight="Bold"/>
                                <TextBlock Text="):" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CommissionAmountBsS, Converter={StaticResource LocalAmountConverter}, StringFormat='+ {0}'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                        </Grid>

                        <Separator Margin="0,6,0,8"/>

                        <Grid>
                            <TextBlock Text="TOTAL A COBRAR AL CLIENTE:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TotalToChargeBsS, Converter={StaticResource LocalAmountConverter}}" FontSize="18" FontWeight="ExtraBold" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding TotalToChargeUSD, Converter={StaticResource PrimaryAmountConverter}}"
                                           Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}"
                                           FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Error Display -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Foreground="DimGray" Margin="0,0,15,0" IsCancel="True"/>
            <Button Content="Procesar Adelanto" Command="{Binding ConfirmCommand}" Style="{DynamicResource MaterialDesignRaisedButton}" IsEnabled="{Binding CanConfirm}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

