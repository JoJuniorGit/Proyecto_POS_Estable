<UserControl x:Class="Desktop.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="LoginFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="LoginInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#6D28D9"/>
            <Setter Property="SelectionBrush" Value="#DDD6FE"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginInputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0,44,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginKeypadButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="#EDE9FE"/>
                                <Setter Property="Foreground" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter TargetName="KeyBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KeyBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="LoginFunctionKeyTemplate" TargetType="Button">
            <Border x:Name="KeyBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="KeyBorder" Property="Background" Value="#E2E8F0"/>
                    <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#CBD5E1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="KeyBorder" Property="Background" Value="#CBD5E1"/>
                    <Setter Property="Foreground" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#6D28D9"/>
                    <Setter TargetName="KeyBorder" Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LoginFunctionKeyStyle" TargetType="Button" BasedOn="{StaticResource LoginKeypadButtonStyle}">
            <Setter Property="Template" Value="{StaticResource LoginFunctionKeyTemplate}"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <ControlTemplate x:Key="LoginClearKeyTemplate" TargetType="Button">
            <Border x:Name="KeyBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="KeyBorder" Property="Background" Value="#FEE2E2"/>
                    <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#FCA5A5"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="KeyBorder" Property="Background" Value="#FECACA"/>
                    <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#FCA5A5"/>
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#DC2626"/>
                    <Setter TargetName="KeyBorder" Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LoginClearKeyStyle" TargetType="Button" BasedOn="{StaticResource LoginKeypadButtonStyle}">
            <Setter Property="Template" Value="{StaticResource LoginClearKeyTemplate}"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#6D28D9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#4C1D95"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#C4B5FD"/>
                                <Setter TargetName="PrimaryBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="SecondaryBorder" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter TargetName="SecondaryBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#6D28D9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GhostBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter TargetName="GhostBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginEyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="EyeBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter TargetName="EyeBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420">

            <Border Width="420"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Opacity="0.06"
                                      Color="#0F172A"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Identidad visual -->
                    <Border Width="52" Height="52"
                            HorizontalAlignment="Center"
                            CornerRadius="14"
                            Background="#EDE9FE"
                            Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="AccountKey"
                                                 Width="28" Height="28"
                                                 Foreground="#6D28D9"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="INICIO DE SESIÓN POS"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Ingrese su Usuario para continuar"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,20"/>

                    <!-- Error -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock AutomationProperties.AutomationId="Login_ErrorMessage"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"/>
                    </Border>

                    <!-- Usuario -->
                    <TextBlock Text="Usuario" Style="{StaticResource LoginFieldLabelStyle}"/>
                    <TextBox Text="{Binding Cedula, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="Login_Username"
                             Style="{StaticResource LoginInputTextBoxStyle}"
                             MaxLength="50"
                             Margin="0,0,0,14"
                             KeyDown="TextBox_KeyDown"/>

                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Style="{StaticResource LoginFieldLabelStyle}"/>
                    <Grid Margin="0,0,0,18">
                        <PasswordBox x:Name="PasswordInput"
                                     AutomationProperties.AutomationId="Login_Password"
                                     Style="{StaticResource LoginInputPasswordBoxStyle}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     KeyDown="PasswordInput_KeyDown"/>

                        <TextBox x:Name="PasswordTextInput"
                                 AutomationProperties.AutomationId="Login_PasswordText"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginInputTextBoxStyle}"
                                 Padding="12,0,44,0"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                 KeyDown="TextBox_KeyDown"/>

                        <Button Style="{StaticResource LoginEyeButtonStyle}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                ToolTip="Mostrar / Ocultar Contraseña">
                            <materialDesign:PackIcon Width="22" Height="22"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="EyeOutline"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                <Setter Property="Kind" Value="EyeOffOutline"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                    </Grid>

                    <!-- Teclado táctil -->
                    <UniformGrid Rows="4" Columns="3" Margin="0,0,0,16">
                        <Button Content="1" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="1"/>
                        <Button Content="2" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="2"/>
                        <Button Content="3" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="3"/>
                        <Button Content="4" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="4"/>
                        <Button Content="5" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="5"/>
                        <Button Content="6" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="6"/>
                        <Button Content="7" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="7"/>
                        <Button Content="8" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="8"/>
                        <Button Content="9" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="9"/>
                        <Button Content="C" Style="{StaticResource LoginClearKeyStyle}" Command="{Binding ClearCommand}"/>
                        <Button Content="0" Style="{StaticResource LoginKeypadButtonStyle}" Command="{Binding AppendDigitCommand}" CommandParameter="0"/>
                        <Button Content="⌫" Style="{StaticResource LoginFunctionKeyStyle}" Command="{Binding BackspaceCommand}"/>
                    </UniformGrid>

                    <!-- Acción principal -->
                    <Button Command="{Binding LoginCommand}"
                            AutomationProperties.AutomationId="Login_SubmitButton"
                            Style="{StaticResource LoginPrimaryButtonStyle}"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="{Binding IsLoading}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Login" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="INGRESAR AL SISTEMA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Estado de conexión -->
            <Border Width="420"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#22C55E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerConnected}" Value="False">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScanningServer}" Value="True">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ServerStatusText}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#334155"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource LoginGhostButtonStyle}"
                            Command="{Binding OpenServerSettingsCommand}"
                            Height="28"
                            Padding="8,0"
                            FontSize="11"
                            ToolTip="Configurar o buscar servidor POS en la red">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#6D28D9"/>
                            <TextBlock Text="Servidor" VerticalAlignment="Center" Foreground="#6D28D9"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Vincular móvil / QR -->
        <Button Style="{StaticResource LoginSecondaryButtonStyle}"
                Command="{Binding OpenPairingQrCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                Padding="12,8"
                ToolTip="Vincular teléfono, tablet o comandera mediante Código QR">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="QrcodeScan"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         Foreground="#6D28D9"/>
                <TextBlock Text="Vincular Móvil / QR"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#1E293B"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
