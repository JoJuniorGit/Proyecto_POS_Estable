<UserControl x:Class="Desktop.Client.Views.StockKardexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockKardexViewModel}"
             Background="#F1F5F9"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="10"
                          Opacity="0.05"
                          Direction="270"
                          ShadowDepth="2"/>

        <Style x:Key="KardexHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="KardexRightHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource KardexHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="KardexRightElementStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Δ coloreado por sentido del movimiento (entrada verde / salida roja) -->
        <Style x:Key="KardexDeltaStyle" TargetType="TextBlock" BasedOn="{StaticResource KardexRightElementStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#047857"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEntry}" Value="False">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KardexFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             0. CABECERA Y ACCIONES
             ═══════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="StockKardex_RefreshButton"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        BorderBrush="#CBD5E1"
                        Foreground="#475569"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        ToolTip="Recargar movimientos y KPIs">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="Abrir Menú Principal"
                        Height="36" Width="36"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" Foreground="#475569"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ClipboardListOutline" Width="26" Height="26" Foreground="#5E35B1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Kardex — Auditoría de Inventario"
                           AutomationProperties.AutomationId="StockKardex_Title"
                           FontSize="20" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══════════════════════════════════════════
             1. FILTROS COMBINABLES
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="16,14"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Effect="{StaticResource EnterpriseCardShadow}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Búsqueda predictiva de producto -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Producto (nombre o código)" Style="{StaticResource KardexFilterLabelStyle}"/>
                        <Grid x:Name="ProductSearchGrid">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8"
                                                     VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Panel.ZIndex="1"/>
                            <TextBox AutomationProperties.AutomationId="StockKardex_SearchInput"
                                     Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Buscar producto..."
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Padding="34,8,10,8"
                                     Height="42"
                                     FontSize="13"/>
                            <Popup IsOpen="{Binding IsProductSuggestionsOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=ProductSearchGrid}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <materialDesign:Card MaxHeight="240" Width="{Binding ElementName=ProductSearchGrid, Path=ActualWidth}">
                                    <ListBox ItemsSource="{Binding ProductSuggestions}"
                                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding SKU, StringFormat='SKU: {0}'}" FontSize="11" Foreground="Gray"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </materialDesign:Card>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Desde" Style="{StaticResource KardexFilterLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="StockKardex_DateFrom"
                                    Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                    Width="140" Height="42" FontSize="13" Padding="8,6" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Hasta" Style="{StaticResource KardexFilterLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="StockKardex_DateTo"
                                    Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                    Width="140" Height="42" FontSize="13" Padding="8,6" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Motivo" Style="{StaticResource KardexFilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ReasonOptions}"
                                  SelectedItem="{Binding SelectedReason, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="StockKardex_ReasonFilter"
                                  materialDesign:HintAssist.Hint="Motivo estandarizado"
                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                  Width="170" Height="42" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,12,0">
                        <TextBlock Text="Origen" Style="{StaticResource KardexFilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding OriginOptions}"
                                  SelectedItem="{Binding SelectedOrigin, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="StockKardex_OriginFilter"
                                  materialDesign:HintAssist.Hint="Tipo de origen"
                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                  Width="150" Height="42" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Sentido" Style="{StaticResource KardexFilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding DirectionOptions}"
                                  SelectedItem="{Binding SelectedDirection, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  AutomationProperties.AutomationId="StockKardex_DirectionFilter"
                                  materialDesign:HintAssist.Hint="Entradas / Salidas"
                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                  Width="140" Height="42" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="Hoy" Command="{Binding ApplyTodayCommand}"
                                AutomationProperties.AutomationId="StockKardex_ApplyToday"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12"/>
                        <Button Content="Esta Semana" Command="{Binding ApplyThisWeekCommand}"
                                AutomationProperties.AutomationId="StockKardex_ApplyWeek"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12"/>
                        <Button Content="Mes Actual" Command="{Binding ApplyCurrentMonthCommand}"
                                AutomationProperties.AutomationId="StockKardex_ApplyMonth"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="0,0,14,0" FontSize="12"/>
                        <Button Content="Limpiar" Command="{Binding ClearFiltersCommand}"
                                AutomationProperties.AutomationId="StockKardex_ClearFilters"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Foreground="#64748B"
                                Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12"/>
                        <Button Content="Aplicar Filtros" Command="{Binding ApplyFiltersCommand}"
                                AutomationProperties.AutomationId="StockKardex_ApplyFilters"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Background="#5E35B1" BorderBrush="#5E35B1" Foreground="#FFFFFF"
                                Height="32" Padding="16,0" FontSize="12"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="CSV" Command="{Binding ExportCsvCommand}"
                                IsEnabled="{Binding CanExport}"
                                AutomationProperties.AutomationId="StockKardex_ExportCsv"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12"
                                ToolTip="Exportar el listado filtrado a CSV"/>
                        <Button Content="Excel" Command="{Binding ExportExcelCommand}"
                                IsEnabled="{Binding CanExport}"
                                AutomationProperties.AutomationId="StockKardex_ExportExcel"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" Margin="0,0,6,0" FontSize="12"
                                ToolTip="Exportar el listado filtrado a Excel (.xlsx)"/>
                        <Button Content="PDF" Command="{Binding ExportPdfCommand}"
                                IsEnabled="{Binding CanExport}"
                                AutomationProperties.AutomationId="StockKardex_ExportPdf"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="12,0" FontSize="12"
                                ToolTip="Exportar el Kardex Oficial a PDF"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════
             2. TARJETAS KPI
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Padding="16,14"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Effect="{StaticResource EnterpriseCardShadow}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Movimientos" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalMovementsDisplay}" AutomationProperties.AutomationId="StockKardex_KpiTotal"
                                   Foreground="#1E293B" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Volumen Neto" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NetVolumeDisplay}" AutomationProperties.AutomationId="StockKardex_KpiVolume"
                                   Foreground="#1E293B" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Entradas (USD)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EntriesValueDisplay}" AutomationProperties.AutomationId="StockKardex_KpiEntries"
                                   Foreground="#047857" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Mermas / Salidas (USD)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LossesValueDisplay}" AutomationProperties.AutomationId="StockKardex_KpiLosses"
                                   Foreground="#B91C1C" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Balance Neto (USD)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NetValueDisplay}" AutomationProperties.AutomationId="StockKardex_KpiNet"
                                   Foreground="#5E35B1" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding UnvaluedWarningText}"
                           AutomationProperties.AutomationId="StockKardex_UnvaluedWarning"
                           Visibility="{Binding HasUnvaluedMovements, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="#B45309" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════
             3. GRILLA DE MOVIMIENTOS
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Effect="{StaticResource EnterpriseCardShadow}">
            <DataGrid x:Name="MovementsDataGrid"
                      AutomationProperties.AutomationId="StockKardex_Grid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeight="38"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="FECHA (LOCAL)" Width="150" HeaderStyle="{StaticResource KardexHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateLocalText}"
                                           ToolTip="{Binding DateUtcText}"
                                           VerticalAlignment="Center" Margin="10,0"
                                           Foreground="#334155" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" HeaderStyle="{StaticResource KardexHeaderStyle}"/>
                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" HeaderStyle="{StaticResource KardexHeaderStyle}"/>
                    <DataGridTextColumn Header="Δ" Binding="{Binding DeltaText}" Width="65"
                                        HeaderStyle="{StaticResource KardexRightHeaderStyle}"
                                        ElementStyle="{StaticResource KardexDeltaStyle}"/>
                    <DataGridTextColumn Header="STOCK ANTES" Binding="{Binding StockBeforeText}" Width="90"
                                        HeaderStyle="{StaticResource KardexRightHeaderStyle}"
                                        ElementStyle="{StaticResource KardexRightElementStyle}"/>
                    <DataGridTextColumn Header="STOCK RESULT." Binding="{Binding NewStockText}" Width="100"
                                        HeaderStyle="{StaticResource KardexRightHeaderStyle}"
                                        ElementStyle="{StaticResource KardexRightElementStyle}"/>
                    <DataGridTextColumn Header="COSTO USD" Binding="{Binding UnitCostDisplay}" Width="90"
                                        HeaderStyle="{StaticResource KardexRightHeaderStyle}"
                                        ElementStyle="{StaticResource KardexRightElementStyle}"/>
                    <DataGridTextColumn Header="VALOR USD" Binding="{Binding TotalValueDisplay}" Width="90"
                                        HeaderStyle="{StaticResource KardexRightHeaderStyle}"
                                        ElementStyle="{StaticResource KardexRightElementStyle}" FontWeight="Bold"/>

                    <DataGridTextColumn Header="ORIGEN" Binding="{Binding OriginLabel}" Width="100" HeaderStyle="{StaticResource KardexHeaderStyle}"/>

                    <DataGridTemplateColumn Header="MOTIVO" Width="160" HeaderStyle="{StaticResource KardexHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ReasonLabel}"
                                           ToolTip="{Binding ReasonTooltip}"
                                           VerticalAlignment="Center" Margin="10,0"
                                           TextTrimming="CharacterEllipsis" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="EJECUTOR" Binding="{Binding ExecutedByDisplay}" Width="110" HeaderStyle="{StaticResource KardexHeaderStyle}"/>
                    <DataGridTextColumn Header="AUTORIZADOR" Binding="{Binding AuthorizedByDisplay}" Width="115" HeaderStyle="{StaticResource KardexHeaderStyle}"/>
                    <DataGridTextColumn Header="REFERENCIA" Binding="{Binding ReferenceDisplay}" Width="100" HeaderStyle="{StaticResource KardexHeaderStyle}"/>

                    <DataGridTemplateColumn Header="OBSERVACIÓN" Width="190" HeaderStyle="{StaticResource KardexHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ObservationDisplay}"
                                           ToolTip="{Binding ObservationDisplay}"
                                           VerticalAlignment="Center" Margin="10,0"
                                           TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#475569"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════════════════════════════════════
             4. PAGINACIÓN SERVER-SIDE (25 por página)
             ═══════════════════════════════════════════ -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding ErrorMessage}"
                       Foreground="#EF4444"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="520"/>

            <Border DockPanel.Dock="Right"
                    Padding="8,4"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource EnterpriseCardShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="StockKardex_PageSummary"
                               Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" Foreground="#475569"/>

                    <Button Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoFirst}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="32" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="Primera Página">
                        <materialDesign:PackIcon Kind="PageFirst" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                            AutomationProperties.AutomationId="StockKardex_PreviousPage"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="32" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="Página Anterior">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                            AutomationProperties.AutomationId="StockKardex_NextPage"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="32" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="Página Siguiente">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoLast}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="32" Width="36" Padding="0" ToolTip="Última Página">
                        <materialDesign:PackIcon Kind="PageLast" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
