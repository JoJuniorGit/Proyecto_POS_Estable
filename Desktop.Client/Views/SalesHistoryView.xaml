<UserControl x:Class="Desktop.Client.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Desktop.Client.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SalesHistoryViewModel}"
             Background="#F1F5F9"
             d:DesignHeight="650" d:DesignWidth="950">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Enterprise Subtle Drop Shadow (0 4px 6px -1px rgba(0,0,0,0.05)) -->
        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="10"
                          Opacity="0.05"
                          Direction="270"
                          ShadowDepth="2"/>

        <!-- Standard column header style -->
        <Style x:Key="StandardHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Right aligned column header style -->
        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- Center aligned column header style -->
        <Style x:Key="CenterAlignedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Right aligned cell style -->
        <Style x:Key="RightAlignedElementStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- White card panel for invoice details -->
        <Style x:Key="InvoiceDetailPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Effect" Value="{StaticResource EnterpriseCardShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSale}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPurchaseDetailsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════
             0. CABECERA Y ACCIONES
             ═══════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadHistoryCommand}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                        BorderBrush="#CBD5E1"
                        Foreground="#475569"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <!-- Botón de Menú Principal -->
                <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="Abrir Menú Principal"
                        Height="36" Width="36"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" Foreground="#475569"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ReceiptText" Width="26" Height="26" Foreground="#5E35B1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Historial de Ventas" FontSize="20" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- ═══════════════════════════════════════════
             1. TARJETA DE FILTROS Y BÚSQUEDA
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" 
                Margin="0,0,0,16" 
                Padding="16,14" 
                CornerRadius="8" 
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Effect="{StaticResource EnterpriseCardShadow}">
            <Grid VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Buscador multicampo: N° de factura / Cliente / Cajero con Ícono Integrado -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Buscar (Factura / Cliente / Cajero)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,2,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="N° de factura, cliente o cajero..."
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     FontSize="13"
                                     Foreground="#1E293B"
                                     Padding="6,0,10,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Fecha Inicio -->
                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Fecha Inicio" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                Width="155" Height="42" 
                                FontSize="13"
                                Padding="10,6" 
                                VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Fecha Fin -->
                <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Fecha Fin" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                Background="#FFFFFF"
                                BorderBrush="#E2E8F0"
                                Width="155" Height="42" 
                                FontSize="13"
                                Padding="10,6" 
                                VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botón Principal Buscar (Alineación Pixel-Perfect a 42px de altura) -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <TextBlock Text=" " FontSize="12" Margin="0,0,0,6"/>
                    <Button Command="{Binding LoadHistoryCommand}"
                            Background="#5E35B1"
                            BorderBrush="#5E35B1"
                            Foreground="#FFFFFF"
                            Height="42"
                            Padding="20,0"
                            materialDesign:ButtonAssist.CornerRadius="6">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Buscar" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <!-- Indicador de Carga -->
                <ProgressBar Grid.Column="4" 
                             IsIndeterminate="True" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Foreground="#5E35B1"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" Margin="14,18,0,0" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════
             2. TARJETA DE LA TABLA (DATAGRID MODERNO)
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                Effect="{StaticResource EnterpriseCardShadow}">
            <controls:PerformantDataGrid ItemsSource="{Binding Sales}" 
                      SelectedItem="{Binding SelectedSale}"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="Transparent"
                      MinRowHeight="46"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      materialDesign:DataGridAssist.CellPadding="14,8,14,8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="14,10,14,10"
                      RowDetailsVisibilityMode="Collapsed"
                      Background="#FFFFFF"
                      RowBackground="#FFFFFF"
                      BorderThickness="0">
                <controls:PerformantDataGrid.Columns>
                    
                    <!-- N° FACTURA -->
                    <DataGridTemplateColumn Header="N° FACTURA" 
                                            HeaderStyle="{StaticResource StandardHeaderStyle}" 
                                            Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InvoiceNumber, StringFormat={}N° {0:D6}}" 
                                           FontWeight="Bold" 
                                           FontSize="13" 
                                           Foreground="#1E293B" 
                                           VerticalAlignment="Center" 
                                           Margin="14,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- FECHA / HORA -->
                    <DataGridTemplateColumn Header="FECHA / HORA" 
                                            HeaderStyle="{StaticResource StandardHeaderStyle}" 
                                            Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding DateLocal, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding DateLocal, StringFormat={}{0:hh:mm tt}}" Foreground="#94A3B8" FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- CLIENTE -->
                    <DataGridTemplateColumn Header="CLIENTE" 
                                            HeaderStyle="{StaticResource StandardHeaderStyle}" 
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CustomerName, FallbackValue='Consumidor Final'}" 
                                           FontWeight="Medium" 
                                           FontSize="12" 
                                           Foreground="#1E293B" 
                                           VerticalAlignment="Center" 
                                           Margin="14,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CAJERO -->
                    <DataGridTemplateColumn Header="CAJERO" 
                                            HeaderStyle="{StaticResource StandardHeaderStyle}" 
                                            Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CashierName, FallbackValue='Usuario Desconocido'}" 
                                           FontSize="12" 
                                           Foreground="#475569" 
                                           VerticalAlignment="Center" 
                                           Margin="14,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TOTAL BS.S (Alineado a la Derecha con Monto Principal en Oscuro y Subtexto USD Tenue) -->
                    <DataGridTemplateColumn Header="TOTAL BS.S" 
                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                            Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding TotalBsS, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="#1E293B" FontSize="13" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding TotalUSD, StringFormat={}USD ${0:N2}}" Foreground="#94A3B8" FontSize="11" TextAlignment="Right" Margin="0,1,0,0" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ESTADO (Badges tipo Píldora SaaS con CornerRadius="100") -->
                    <DataGridTemplateColumn Header="ESTADO" 
                                            HeaderStyle="{StaticResource CenterAlignedHeaderStyle}"
                                            Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadgeBorder" 
                                        CornerRadius="100" 
                                        Padding="12,4" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        Background="#F1F5F9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon x:Name="StatusIcon" Kind="ClockOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#475569"/>
                                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Completada / Pagado (Verde pastel y esmeralda oscuro) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#DCFCE7"/>
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircle"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#166534"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="Completada"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#166534"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Pagado">
                                        <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#DCFCE7"/>
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircle"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#166534"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="Completada"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#166534"/>
                                    </DataTrigger>

                                    <!-- Cancelled / Anulada (Rojo pastel y vino oscuro) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEE2E2"/>
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircle"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#991B1B"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="Anulada"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#991B1B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Anulada">
                                        <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEE2E2"/>
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircle"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#991B1B"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="Anulada"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#991B1B"/>
                                    </DataTrigger>

                                    <!-- Pending (Ámbar pastel) -->
                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                        <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEF3C7"/>
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="ClockOutline"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#92400E"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="Pendiente"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#92400E"/>
                                    </DataTrigger>

                                    <!-- OnHold (Ámbar pastel) -->
                                    <DataTrigger Binding="{Binding Status}" Value="OnHold">
                                        <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEF3C7"/>
                                        <Setter TargetName="StatusIcon" Property="Kind" Value="ClockOutline"/>
                                        <Setter TargetName="StatusIcon" Property="Foreground" Value="#92400E"/>
                                        <Setter TargetName="StatusText" Property="Text" Value="En Espera"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#92400E"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </controls:PerformantDataGrid.Columns>
            </controls:PerformantDataGrid>
        </Border>

        <!-- ═══════════════════════════════════════════
             3. PANEL DESPLEGABLE DE DETALLE (FACTURA)
             ═══════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource InvoiceDetailPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado del Detalle con la Hora Exacta de Emisión -->
                <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{DynamicResource MaterialDesignIconButton}"
                                Command="{Binding TogglePurchaseDetailsPanelCommand}"
                                ToolTip="Minimizar/Restaurar detalle"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="WindowMinimize"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPurchaseDetailsExpanded}" Value="False">
                                                <Setter Property="Kind" Value="WindowRestore"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <Button Style="{DynamicResource MaterialDesignIconButton}"
                                Command="{Binding ClosePurchaseDetailsCommand}"
                                ToolTip="Cerrar detalle"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsPurchaseDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#5E35B1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center">
                            <Run Text="Detalle de Factura N° "/>
                            <Run Text="{Binding SelectedSale.InvoiceNumber, StringFormat={}{0:D6}}"/>
                            <Run Text=" — Emitida: " Foreground="#64748B" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock Text="{Binding DetailDateLocalFormatted}" 
                                   Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" 
                                   Foreground="#5E35B1" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" MaxHeight="320" Background="Transparent"
                              Visibility="{Binding IsPurchaseDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="4,0,4,4">

                        <TextBlock Text="Cargando detalles..." Margin="0,0,0,8" Foreground="#64748B"
                                   Visibility="{Binding IsDetailDebouncing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsDetailFetching, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Foreground="#5E35B1" Width="50" Height="4" VerticalAlignment="Center"/>
                            <TextBlock Text="Obteniendo datos..." Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#64748B"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DetailErrorMessage}"
                                   Foreground="#EF4444"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetailErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DetailErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Tabla de Productos Comprados -->
                        <controls:PerformantDataGrid ItemsSource="{Binding SelectedSaleItems}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   EnableRowVirtualization="False"
                                   HeadersVisibility="Column"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   GridLinesVisibility="Horizontal"
                                   HorizontalGridLinesBrush="#E2E8F0"
                                   VerticalGridLinesBrush="Transparent"
                                   Margin="0,0,0,12">
                            <controls:PerformantDataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" HeaderStyle="{StaticResource StandardHeaderStyle}"/>
                                <DataGridTextColumn Header="CANT." Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="80" HeaderStyle="{StaticResource StandardHeaderStyle}"/>
                                <DataGridTextColumn Header="P. UNIDAD" Binding="{Binding UnitPriceBsS, StringFormat={}{0:N2}}" Width="110" HeaderStyle="{StaticResource RightAlignedHeaderStyle}" ElementStyle="{StaticResource RightAlignedElementStyle}"/>
                                <DataGridTextColumn Header="SUBTOTAL BS.S" Binding="{Binding SubtotalBsS, StringFormat={}{0:N2}}" Width="130" HeaderStyle="{StaticResource RightAlignedHeaderStyle}" ElementStyle="{StaticResource RightAlignedElementStyle}" FontWeight="Bold"/>
                            </controls:PerformantDataGrid.Columns>
                        </controls:PerformantDataGrid>

                        <!-- Desglose de Métodos de Pago y Totales -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INFORMACIÓN DE PAGO" Style="{DynamicResource MaterialDesignCaptionTextBlock}" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedSalePayments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding MethodName}" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AmountBsS, StringFormat={}{0:N2}}" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#5E35B1"/>
                                                <TextBlock Text="{Binding Reference, StringFormat={}Ref: {0}}" Foreground="#64748B" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="240" Margin="16,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MaxWidth="160"/>
                                    <ColumnDefinition Width="*" MinWidth="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Tasa Aplicada -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tasa Aplicada:" TextTrimming="CharacterEllipsis" Foreground="#64748B" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailAppliedRate, StringFormat={}{0:N2} Bs/$}" Foreground="#475569" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,4"/>

                                <!-- Total USD -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Total USD:" TextTrimming="CharacterEllipsis" Foreground="#64748B" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailTotalUSD, StringFormat={}${0:N2}}" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,4"/>

                                <!-- Total Factura Bs.S -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Factura Bs.S:" TextTrimming="CharacterEllipsis" Foreground="#1E293B" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailTotalBsS, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="16" Foreground="#5E35B1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════
             4. PAGINACIÓN Y FOOTER CON SEPARADOR
             ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <!-- Separador fino -->
            <Border Height="1" Background="#E2E8F0" Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- Total del Período -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Total del Período:" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalBsSForThePeriod, StringFormat='{}Bs.S {0:N2}'}" Foreground="#5E35B1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <!-- Barra de Paginación Avanzada -->
                <Border Grid.Column="1" 
                        HorizontalAlignment="Right"
                        Padding="8,4" 
                        Background="#FFFFFF" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Effect="{StaticResource EnterpriseCardShadow}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Resumen -->
                        <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0" Foreground="#475569"/>

                        <!-- Botón Primera Página (<<) -->
                        <Button Command="{Binding FirstPageCommand}" 
                                IsEnabled="{Binding CanGoFirst}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                Height="32" Width="36" Padding="0" Margin="0,0,4,0" 
                                ToolTip="Primera Página">
                            <materialDesign:PackIcon Kind="PageFirst" Width="18" Height="18"/>
                        </Button>

                        <!-- Botón Página Anterior (<) -->
                        <Button Command="{Binding PreviousPageCommand}" 
                                IsEnabled="{Binding CanGoPrevious}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                Height="32" Width="36" Padding="0" Margin="0,0,6,0" 
                                ToolTip="Página Anterior">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                        </Button>

                        <!-- Botones Numéricos de Páginas Relativas -->
                        <ItemsControl ItemsSource="{Binding PageNumbers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding PageNumber}"
                                            Content="{Binding PageNumber}"
                                            Height="32" MinWidth="34" Padding="6,0" Margin="2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#5E35B1"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#5E35B1"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Botón Página Siguiente (>) -->
                        <Button Command="{Binding NextPageCommand}" 
                                IsEnabled="{Binding CanGoNext}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                Height="32" Width="36" Padding="0" Margin="6,0,4,0" 
                                ToolTip="Página Siguiente">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                        </Button>

                        <!-- Botón Última Página (>>) -->
                        <Button Command="{Binding LastPageCommand}" 
                                IsEnabled="{Binding CanGoLast}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}" 
                                Height="32" Width="36" Padding="0" Margin="0,0,14,0" 
                                ToolTip="Última Página">
                            <materialDesign:PackIcon Kind="PageLast" Width="18" Height="18"/>
                        </Button>

                        <!-- Separador vertical -->
                        <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="0,0,14,0"/>

                        <!-- Búsqueda Exacta: Ir a Página -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ir a:" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0" Foreground="#64748B"/>
                            <TextBox x:Name="TargetPageTextBox"
                                     Text="{Binding TargetPageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumberValidationTextBox"
                                     GotFocus="TargetPageInput_GotFocus"
                                     PreviewMouseLeftButtonDown="TargetPageInput_PreviewMouseLeftButtonDown"
                                     Width="48" Height="30"
                                     FontSize="12" FontWeight="Bold"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Padding="2,0" Margin="0,0,6,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SubmitGoToPageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Command="{Binding SubmitGoToPageCommand}"
                                    Style="{DynamicResource MaterialDesignRaisedButton}"
                                    Background="#5E35B1"
                                    BorderBrush="#5E35B1"
                                    Foreground="#FFFFFF"
                                    Height="30" Width="36" Padding="0"
                                    ToolTip="Ir a la página especificada">
                                <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
