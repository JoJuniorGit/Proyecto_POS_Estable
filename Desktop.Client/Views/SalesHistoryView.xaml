<UserControl x:Class="Desktop.Client.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Desktop.Client.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SalesHistoryViewModel}"
             d:DesignHeight="650" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Light sky-blue panel for invoice details -->
        <SolidColorBrush x:Key="InvoiceDetailPanelBackgroundBrush" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="InvoiceDetailPanelBorderBrush" Color="#B3E5FC"/>
        
        <Style x:Key="InvoiceDetailPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InvoiceDetailPanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InvoiceDetailPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12,14,12"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSale}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPurchaseDetailsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Right aligned column header style -->
        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,14,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Right aligned cell style -->
        <Style x:Key="RightAlignedElementStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Standard column header style -->
        <Style x:Key="StandardHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera con Botón Actualizar y Botón de Menú en el Extremo Derecho Superior -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadHistoryCommand}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="12,0"
                        Margin="0,0,8,0">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

                <!-- Botón de Menú Principal -->
                <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="Abrir Menú Principal"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ReceiptText" Width="26" Height="26" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Historial de Ventas" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- Filtros de Fecha con Etiquetas Superiores y Botón Buscar -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16,12" UniformCornerRadius="8" Background="{DynamicResource MaterialDesignPaper}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Buscador multicampo: N° de factura / Cliente / Cajero -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Buscar (Factura / Cliente / Cajero)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="N° de factura, cliente o cajero..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Width="280" Height="40" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Fecha Inicio -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Fecha Inicio" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                Width="160" Height="40"/>
                </StackPanel>

                <!-- Fecha Fin -->
                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Fecha Fin" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                                Width="160" Height="40"/>
                </StackPanel>

                <!-- Botón Principal Buscar -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="Buscar"
                            Command="{Binding LoadHistoryCommand}"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Height="40"
                            Padding="16,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Buscar" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <!-- Indicador de Carga -->
                <ProgressBar Grid.Column="4" 
                             IsIndeterminate="True" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Margin="16,0,0,0" />
            </Grid>
        </materialDesign:Card>

        <!-- Tabla Limpia sin Líneas Verticales, Filas Holgadas y Títulos en Mayúsculas -->
        <controls:PerformantDataGrid Grid.Row="2" 
                  ItemsSource="{Binding Sales}" 
                  SelectedItem="{Binding SelectedSale}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  MinRowHeight="44"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  materialDesign:DataGridAssist.CellPadding="12,8,12,8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10,12,10"
                  RowDetailsVisibilityMode="Collapsed">
            <controls:PerformantDataGrid.Columns>
                
                <!-- N° FACTURA -->
                <DataGridTextColumn Header="N° FACTURA" 
                                    HeaderStyle="{StaticResource StandardHeaderStyle}"
                                    Binding="{Binding InvoiceNumber, StringFormat={}N° {0:D6}}" 
                                    FontWeight="Bold" 
                                    Width="120" />
                
                <!-- CLIENTE -->
                <DataGridTextColumn Header="CLIENTE" 
                                    HeaderStyle="{StaticResource StandardHeaderStyle}"
                                    Binding="{Binding CustomerName, FallbackValue='Consumidor Final'}" 
                                    Width="*" />

                <!-- CAJERO -->
                <DataGridTextColumn Header="CAJERO" 
                                    HeaderStyle="{StaticResource StandardHeaderStyle}"
                                    Binding="{Binding CashierName, FallbackValue='Usuario Desconocido'}" 
                                    Width="140" />

                <!-- TOTAL BS.S (Monto Principal en Bs.S con Equivalente USD como Subtexto) -->
                <DataGridTemplateColumn Header="TOTAL BS.S" 
                                        HeaderStyle="{StaticResource RightAlignedHeaderStyle}"
                                        Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding TotalBsS, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" TextAlignment="Right"/>
                                <TextBlock Text="{Binding TotalUSD, StringFormat={}USD ${0:N2}}" Foreground="Gray" FontSize="10" TextAlignment="Right"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ESTADO (Badges tipo Píldora Redondeada con Ícono) -->
                <DataGridTemplateColumn Header="ESTADO" 
                                        HeaderStyle="{StaticResource StandardHeaderStyle}"
                                        Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="StatusBadgeBorder" 
                                    CornerRadius="12" 
                                    Padding="10,4" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    Background="#F3F4F6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="StatusIcon" Kind="ClockOutline" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#4B5563"/>
                                    <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#4B5563" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Completada / Pagado -->
                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                    <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircle"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#15803D"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="Completada"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#15803D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Pagado">
                                    <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircle"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#15803D"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="Completada"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#15803D"/>
                                </DataTrigger>

                                <!-- Cancelled / Anulada -->
                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                    <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircle"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#B91C1C"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="Anulada"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Anulada">
                                    <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircle"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#B91C1C"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="Anulada"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>

                                <!-- Pending -->
                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                    <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEF3C7"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="ClockOutline"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#B45309"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="Pendiente"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B45309"/>
                                </DataTrigger>

                                <!-- OnHold -->
                                <DataTrigger Binding="{Binding Status}" Value="OnHold">
                                    <Setter TargetName="StatusBadgeBorder" Property="Background" Value="#FEF3C7"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="ClockOutline"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#B45309"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="En Espera"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B45309"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </controls:PerformantDataGrid.Columns>
        </controls:PerformantDataGrid>

        <!-- Panel Desplegable de Detalle con la Hora de Emisión Integrada en la Cabecera -->
        <Border Grid.Row="3" Style="{StaticResource InvoiceDetailPanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado del Detalle con la Hora Exacta de Emisión -->
                <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{DynamicResource MaterialDesignIconButton}"
                                Command="{Binding TogglePurchaseDetailsPanelCommand}"
                                ToolTip="Minimizar/Restaurar detalle"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="WindowMinimize"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPurchaseDetailsExpanded}" Value="False">
                                                <Setter Property="Kind" Value="WindowRestore"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <Button Style="{DynamicResource MaterialDesignIconButton}"
                                Command="{Binding ClosePurchaseDetailsCommand}"
                                ToolTip="Cerrar detalle"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsPurchaseDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="Detalle de Factura N° "/>
                            <Run Text="{Binding SelectedSale.InvoiceNumber, StringFormat={}{0:D6}}"/>
                            <Run Text=" — Emitida: " Foreground="Gray" FontWeight="Normal"/>
                            <Run Text="{Binding SelectedSale.Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" MaxHeight="320" Background="Transparent"
                              Visibility="{Binding IsPurchaseDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="4,0,4,4">

                        <TextBlock Text="Cargando detalles..." Margin="0,0,0,8" Foreground="Gray"
                                   Visibility="{Binding IsDetailDebouncing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsDetailFetching, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Width="50" Height="4" VerticalAlignment="Center"/>
                            <TextBlock Text="Obteniendo datos..." Margin="8,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DetailErrorMessage}"
                                   Foreground="IndianRed"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DetailErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DetailErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Tabla de Productos Comprados -->
                        <controls:PerformantDataGrid ItemsSource="{Binding SelectedSaleItems}"
                                   AutoGenerateColumns="False"
                                   CanUserAddRows="False"
                                   IsReadOnly="True"
                                   HeadersVisibility="Column"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   GridLinesVisibility="Horizontal"
                                   HorizontalGridLinesBrush="#E2E8F0"
                                   Margin="0,0,0,12">
                            <controls:PerformantDataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" HeaderStyle="{StaticResource StandardHeaderStyle}"/>
                                <DataGridTextColumn Header="CANT." Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="80" HeaderStyle="{StaticResource StandardHeaderStyle}"/>
                                <DataGridTextColumn Header="P. UNIDAD" Binding="{Binding UnitPriceBsS, StringFormat={}{0:N2}}" Width="110" HeaderStyle="{StaticResource RightAlignedHeaderStyle}" ElementStyle="{StaticResource RightAlignedElementStyle}"/>
                                <DataGridTextColumn Header="SUBTOTAL BS.S" Binding="{Binding SubtotalBsS, StringFormat={}{0:N2}}" Width="130" HeaderStyle="{StaticResource RightAlignedHeaderStyle}" ElementStyle="{StaticResource RightAlignedElementStyle}" FontWeight="Bold"/>
                            </controls:PerformantDataGrid.Columns>
                        </controls:PerformantDataGrid>

                        <!-- Desglose de Métodos de Pago y Totales -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INFORMACIÓN DE PAGO" Style="{DynamicResource MaterialDesignCaptionTextBlock}" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedSalePayments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding MethodName}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AmountBsS, StringFormat={}{0:N2}}" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                <TextBlock Text="{Binding Reference, StringFormat={}Ref: {0}}" Foreground="Gray" FontSize="11" FontStyle="Italic" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Tasa Aplicada:" Margin="0,0,8,0" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedSale.AppliedRate, StringFormat={}{0:N2} Bs/$}" Foreground="Gray" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Total USD:" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="{Binding SelectedSale.TotalUSD, StringFormat={}${0:N2}}" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Factura Bs.S:" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedSale.TotalBsS, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Controles de Paginación y Resumen Total -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total del Período:" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalBsSForThePeriod, StringFormat='{}Bs.S {0:N2}'}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalItems, StringFormat={}Total registros: {0}}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" Foreground="Gray"/>
                
                <Button Command="{Binding PreviousPageCommand}" 
                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                        Height="32" Padding="8,0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Anterior" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding CurrentPage, StringFormat={}Pág. {0}}" VerticalAlignment="Center" FontWeight="Bold" Margin="8,0"/>

                <Button Command="{Binding NextPageCommand}" 
                        Style="{DynamicResource MaterialDesignOutlinedButton}" 
                        Height="32" Padding="8,0" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Siguiente" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
