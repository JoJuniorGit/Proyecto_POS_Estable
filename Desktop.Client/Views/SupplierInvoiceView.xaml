<UserControl x:Class="Desktop.Client.Views.SupplierInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignFont}"
             d:DataContext="{d:DesignInstance Type=vm:SupplierInvoiceViewModel}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:Base64PngToImageSourceConverter x:Key="Base64PngToImageSourceConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                    CommandParameter="{x:Static Dock.Right}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Abrir menú de navegación"
                    Margin="0,0,16,0" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ACTUALIZACIÓN DE PRECIOS POR FACTURA DE PROVEEDOR"
                           AutomationProperties.AutomationId="SupplierInvoice_Title"
                           Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
                           FontWeight="Bold" />
                <TextBlock Text="Revise costos, márgenes y coincidencias antes de procesar los cambios."
                           Style="{DynamicResource MaterialDesignSubtitle2TextBlock}"
                           Foreground="{DynamicResource MaterialDesignTextBoxBorder}" />
            </StackPanel>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding SupplierRifOrNit, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="RIF / NIT"
                         IsEnabled="{Binding CanMutateCatalog}"
                         Margin="0,0,10,8" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SupplierCommercialName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Nombre comercial"
                         IsEnabled="{Binding CanMutateCatalog}"
                         Margin="0,0,10,8" />
                <Button Grid.Row="0" Grid.Column="2"
                        Command="{Binding LookupSupplierCommand}"
                        Content="Buscar proveedor"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        IsEnabled="{Binding CanLookupSupplier}"
                        Margin="0,0,8,8" />
                <Button Grid.Row="0" Grid.Column="3"
                        Command="{Binding CreateSupplierCommand}"
                        Content="Registrar proveedor"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding CanCreateSupplier}"
                        Margin="0,0,0,8" />

                <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Seleccione el proveedor"
                          IsEnabled="{Binding CanMutateCatalog}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CommercialName}" />
                                <TextBlock Text="{Binding RifOrNit}" Margin="10,0,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Row="2" Grid.Column="0"
                          ItemsSource="{Binding CurrencyOptions}"
                          SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Moneda del documento"
                          IsEnabled="{Binding IsCurrencyInputEnabled}"
                          Margin="0,8,10,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,10,0">
                    <TextBox Text="{Binding AppliedRateText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Tasa aplicada (Bs.S)"
                             IsEnabled="{Binding IsRateInputEnabled}"
                             AutomationProperties.Name="Tasa de cambio aplicada" />
                    <TextBlock Text="Indique una tasa mayor que cero para facturas en Bs.S."
                               Foreground="#DC2626" FontSize="11" Margin="4,4,0,0"
                               Visibility="{Binding ShowRateValidationHint, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{Binding SelectFileCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsEnabled="{Binding CanSelectFile}"
                    Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileUploadOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Seleccionar factura (.xlsx, .csv, .xml)" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Command="{Binding ScanInvoiceCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsEnabled="{Binding CanScanInvoice}"
                    ToolTip="Cargar una imagen o PDF escaneado y extraer las líneas con OCR"
                    AutomationProperties.Name="Escanear factura con OCR"
                    Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ScanHelper" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Escanear factura (OCR)" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBox Grid.Column="2"
                     Text="{Binding SelectedFilePath}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center" />
            <ProgressBar Grid.Column="3"
                         IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         Width="100" Height="10" Margin="12,0,0,0"
                         VerticalAlignment="Center" />
        </Grid>

        <materialDesign:Card Grid.Row="3" Padding="16" Margin="0,0,0,12"
                             Visibility="{Binding HasMappings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Asignar columnas del archivo"
                           FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding ColumnMappings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,12,8" Width="190">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <ComboBox ItemsSource="{Binding AvailableColumns}"
                                          SelectedItem="{Binding SelectedColumnName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          IsEnabled="{Binding DataContext.CanMutateCatalog, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding StageInvoiceCommand}"
                        Content="Preparar factura para revisión"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding CanStageInvoice}"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0" />
            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 8.147-S5 (T7): revisión lado a lado solo cuando la factura staged viene de OCR;
                 sin origen OCR la columna colapsa y la grilla conserva su layout de siempre. -->
            <materialDesign:Card Grid.Column="0" Width="460" Margin="0,0,12,0"
                                 Visibility="{Binding IsOcrSource, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
                        <Button Command="{Binding OcrPreviousPageCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Página anterior"
                                AutomationProperties.Name="Página anterior de la factura escaneada">
                            <materialDesign:PackIcon Kind="ChevronLeft" />
                        </Button>
                        <TextBlock Text="{Binding OcrPageLabel}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="6,0" />
                        <Button Command="{Binding OcrNextPageCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Página siguiente"
                                AutomationProperties.Name="Página siguiente de la factura escaneada">
                            <materialDesign:PackIcon Kind="ChevronRight" />
                        </Button>
                        <Border Width="1" Background="{DynamicResource MaterialDesignDivider}" Margin="10,4" />
                        <Button Command="{Binding OcrZoomOutCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Alejar"
                                AutomationProperties.Name="Alejar preview">
                            <materialDesign:PackIcon Kind="MagnifyMinus" />
                        </Button>
                        <Button Command="{Binding ResetOcrZoomCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Restablecer zoom (100%)"
                                AutomationProperties.Name="Restablecer zoom del preview">
                            <materialDesign:PackIcon Kind="Restore" />
                        </Button>
                        <Button Command="{Binding OcrZoomInCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Acercar"
                                AutomationProperties.Name="Acercar preview">
                            <materialDesign:PackIcon Kind="MagnifyPlus" />
                        </Button>
                        <TextBlock Text="{Binding OcrZoom, Mode=OneWay, StringFormat={}{0:P0}}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OcrPreview_MouseWheel"
                                  Background="#FAFAFA">
                        <Image Source="{Binding OcrSelectedPreviewBase64, Mode=OneWay, Converter={StaticResource Base64PngToImageSourceConverter}}"
                               Stretch="None"
                               SnapsToDevicePixels="True"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding OcrZoom, Mode=OneWay}"
                                                ScaleY="{Binding OcrZoom, Mode=OneWay}" />
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Margin="8,6,8,8" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Verifique los campos resaltados en amarillo o rojo contra la imagen antes de aprobar." />
                </Grid>
            </materialDesign:Card>

            <DataGrid Grid.Column="1"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  HeadersVisibility="All"
                  Background="{DynamicResource MaterialDesignPaper}"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.IsDeferredScrollingEnabled="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanCreateProduct}" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                            <Setter Property="ToolTip" Value="Producto nuevo: use 'Crear Producto' para capturar el código de barras y resolver la línea." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Producto" Width="*" MinWidth="160">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NameConfidenceBand}" Value="Yellow">
                                    <Setter Property="Background" Value="#FFF3C4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NameConfidenceBand}" Value="Red">
                                    <Setter Property="Background" Value="#FFD6D6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsEditorEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         IsEnabled="{Binding IsEditorEnabled}"
                                         Visibility="{Binding IsEditorEnabled, Converter={StaticResource BoolToVis}}"
                                         Padding="5,2"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Nombre OCR editable" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Código proveedor" Binding="{Binding SupplierCode}" Width="130" />
                <DataGridTextColumn Header="Código de barras" Binding="{Binding Barcode}" Width="130" />
                <DataGridTemplateColumn Header="Estado" Width="115">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="7,3" CornerRadius="8" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusLabel}" Value="[NUEVO]">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLabel}" Value="[UPDATE]">
                                                <Setter Property="Background" Value="#FFF3E0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLabel}" Value="[UNCHANGED]">
                                                <Setter Property="Background" Value="#ECEFF1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusLabel}" Value="[CONFLICT]">
                                                <Setter Property="Background" Value="#FFEBEE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Cantidad" Width="90">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QuantityConfidenceBand}" Value="Yellow">
                                    <Setter Property="Background" Value="#FFF3C4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding QuantityConfidenceBand}" Value="Red">
                                    <Setter Property="Background" Value="#FFD6D6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:N3}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="8,0"
                                           Visibility="{Binding IsEditorEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox Text="{Binding EditQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         IsEnabled="{Binding IsEditorEnabled}"
                                         Visibility="{Binding IsEditorEnabled, Converter={StaticResource BoolToVis}}"
                                         HorizontalContentAlignment="Right"
                                         Padding="5,2"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Cantidad OCR editable" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Costo USD" Binding="{Binding UnitCostUSD, StringFormat={}{0:N2}}" Width="100" />
                <DataGridTemplateColumn Header="Costo factura (Bs.S)"
                                        Width="130"
                                        Visibility="{Binding Data.IsBsSInvoice, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVis}}">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UnitCostConfidenceBand}" Value="Yellow">
                                    <Setter Property="Background" Value="#FFF3C4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UnitCostConfidenceBand}" Value="Red">
                                    <Setter Property="Background" Value="#FFD6D6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding UnitCostDocument, Mode=OneWay, StringFormat={}{0:N2}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="8,0"
                                           Visibility="{Binding IsEditorEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox Text="{Binding EditUnitCostDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         IsEnabled="{Binding IsEditorEnabled}"
                                         Visibility="{Binding IsEditorEnabled, Converter={StaticResource BoolToVis}}"
                                         HorizontalContentAlignment="Right"
                                         Padding="5,2"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="Costo factura OCR editable" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Costo anterior → nuevo" Binding="{Binding CostComparison}" Width="160" />
                <DataGridTemplateColumn Header="Margen detal %" Width="125"
                                        Visibility="{Binding Data.CanMutateCatalog, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MarginRetailOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsEnabled="{Binding CanApprove}"
                                     HorizontalContentAlignment="Right"
                                     Padding="5,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Precio detal sugerido USD" Binding="{Binding SuggestedRetailPriceUSD, StringFormat={}{0:N2}}" Width="150" />
                <DataGridTemplateColumn Header="Margen mayor %" Width="125"
                                        Visibility="{Binding Data.CanMutateCatalog, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MarginWholesaleOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsEnabled="{Binding CanApprove}"
                                     HorizontalContentAlignment="Right"
                                     Padding="5,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Precio mayor sugerido USD" Binding="{Binding SuggestedWholesalePriceUSD, StringFormat={}{0:N2}}" Width="160" />
                <DataGridTemplateColumn Header="Aprobar" Width="85"
                                        Visibility="{Binding Data.CanMutateCatalog, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsApproved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanApprove}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Aprobar línea de factura" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Crear Producto" Width="140"
                                        Visibility="{Binding Data.CanMutateCatalog, Source={StaticResource ViewModelProxy}, Converter={StaticResource BoolToVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Crear Producto"
                                    Command="{Binding Data.CreateProductCommand, Source={StaticResource ViewModelProxy}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Visibility="{Binding CanCreateProduct, Converter={StaticResource BoolToVis}}"
                                    IsEnabled="{Binding CanCreateProduct}"
                                    FontSize="11"
                                    Padding="8,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Crear producto desde la línea" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Command="{Binding ClearInvoiceCommand}"
                    Content="Limpiar" Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,12,0" />
            <Button Grid.Column="2" Command="{Binding ConfirmInvoiceCommand}"
                    Content="Confirmar y Procesar Factura"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsEnabled="{Binding CanConfirmInvoice}"
                    FontWeight="Bold" />
        </Grid>
    </Grid>
</UserControl>
