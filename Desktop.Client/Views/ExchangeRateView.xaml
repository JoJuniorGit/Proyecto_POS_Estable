<UserControl x:Class="Desktop.Client.Views.ExchangeRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:behaviors="clr-namespace:Desktop.Client.Behaviors"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=vm:ExchangeRateViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Back shortcut -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Exchange Rate" 
                           Style="{DynamicResource MaterialDesignHeadline4TextBlock}" 
                           FontWeight="Bold"/>
                <TextBlock Text="Manage the USD to Bs.S daily conversion rate." 
                           Style="{DynamicResource MaterialDesignBody1TextBlock}" 
                           Opacity="0.7" Margin="0,5,0,0"/>

                <!-- Read-Only Mode Banner -->
                <Border Visibility="{Binding UserSession.CanMutateExchangeRate, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="LockOutline" Foreground="#D97706" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios e importaciones están bloqueados."
                                   Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Back to POS shortcut -->
            <Button Grid.Column="1"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    Command="{Binding DataContext.NavigateToPosCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    VerticalAlignment="Top"
                    ToolTip="Return to Point of Sale">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Back to POS" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Configuration Card -->
        <materialDesign:Card Grid.Row="1" Padding="24" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Current Rate Display -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource PrimaryHueLightBrush}" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current Rate" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentRate, StringFormat='{}{0:N4}'}" 
                                       FontSize="36" FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Last Updated" FontSize="11" Opacity="0.5" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding LastUpdated, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Never'}" 
                                       FontSize="12" Opacity="0.7" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Input: New Rate -->
                <TextBlock Grid.Row="1" Text="Set Today's Rate" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="RateInput"
                             Grid.Column="0"
                             Text="{Binding NewRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:DecimalCentsBehavior.IsEnabled="True"
                             IsEnabled="{Binding UserSession.CanMutateExchangeRate}"
                             materialDesign:HintAssist.Hint="Type digits (0.01 → 0.12 → 1.23)"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             FontSize="20" FontWeight="Bold"
                             HorizontalContentAlignment="Right"
                             Margin="0,0,10,0"/>

                    <Button Grid.Column="1"
                            Command="{Binding SaveRateCommand}"
                            IsEnabled="{Binding UserSession.CanMutateExchangeRate}"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Height="46" Padding="20,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Grid.Column="2"
                            Command="{Binding SyncBcvCommand}"
                            IsEnabled="{Binding UserSession.CanMutateExchangeRate}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="46" Padding="20,0" ToolTip="Fetch today's official BCV rate">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudSync" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Sync BCV" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status Message -->
                <TextBlock Grid.Row="3" 
                           Text="{Binding StatusMessage}" 
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           FontSize="13" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Loading indicator -->
                <ProgressBar Grid.Row="4" 
                             IsIndeterminate="True" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Margin="0,10,0,0"/>
            </Grid>
        </materialDesign:Card>

        <!-- History DataGrid -->
        <controls:PerformantDataGrid Grid.Row="2"
                  ItemsSource="{Binding History}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="0"
                  Background="Transparent">
            <controls:PerformantDataGrid.Columns>
                <DataGridTextColumn Header="Date" 
                                    Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" 
                                    Width="*" MinWidth="120"
                                    ElementStyle="{DynamicResource MaterialDesignDataGridTextColumnStyle}"/>
                <DataGridTextColumn Header="Rate" 
                                    Binding="{Binding Rate, StringFormat='{}{0:N4}'}" 
                                    Width="*" MinWidth="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Last Updated" 
                                    Binding="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                    Width="*" MinWidth="140"
                                    ElementStyle="{DynamicResource MaterialDesignDataGridTextColumnStyle}"/>
            </controls:PerformantDataGrid.Columns>
        </controls:PerformantDataGrid>
    </Grid>
</UserControl>
