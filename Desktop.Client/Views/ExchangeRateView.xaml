<UserControl x:Class="Desktop.Client.Views.ExchangeRateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:behaviors="clr-namespace:Desktop.Client.Behaviors"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:core="clr-namespace:Desktop.Client.Services;assembly=Desktop.Client.Core"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180"
             d:DataContext="{d:DesignInstance Type=vm:ExchangeRateViewModel}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="10"
                          Opacity="0.04"
                          Direction="270"
                          ShadowDepth="2"/>

        <Style x:Key="EnterpriseCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Effect" Value="{StaticResource EnterpriseCardShadow}"/>
        </Style>

        <Style x:Key="HistoryCardStyle" TargetType="Border"
               BasedOn="{StaticResource EnterpriseCardStyle}">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="RateInputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="240"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#6D28D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnterpriseFocusVisualStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3"
                                   Stroke="#6D28D9"
                                   StrokeThickness="2"
                                   StrokeDashArray="3 2"
                                   RadiusX="10"
                                   RadiusY="10"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EnterpriseFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6D28D9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EnterpriseFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C1D95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F3FF"/>
            <Setter Property="BorderBrush" Value="#DDD6FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6D28D9"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EnterpriseFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6FE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeaderLeftStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeaderRightStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GridHeaderLeftStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="GridHeaderUpdateStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GridHeaderLeftStyle}">
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="GridCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GridCellRateStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellVariationStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding VariationForeground}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellUpdateStyle" TargetType="TextBlock"
               BasedOn="{StaticResource GridCellTextStyle}">
            <Setter Property="Margin" Value="16,0,0,0"/>
        </Style>

        <Style x:Key="HistoryRowStyle" TargetType="DataGridRow"
               BasedOn="{StaticResource MaterialDesignDataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExchangeScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#CBD5E1"
                                                        CornerRadius="3" Width="6"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background"
                                                                Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource ExchangeScrollBarStyle}"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tasa de Cambio"
                           AutomationProperties.AutomationId="ExchangeRate_Title"
                           FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>

                <StackPanel Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}">
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Sincronización automática cada 2 horas. También puede sincronizar a demanda o ingresar la tasa del día manualmente."
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="999" Padding="9,3" Margin="10,0,0,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="Modo Híbrido" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#475569"/>
                        </Border>
                    </Grid>

                    <Border Visibility="{Binding IsRateOutdated, Converter={StaticResource BoolToVis}}"
                            Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#D97706"
                                                     Width="20" Height="20" VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="Tasa desactualizada: no se ha registrado una actualización en más de 24 horas. Sincronice con el BCV o ingrese la tasa oficial del día."
                                       Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding UserSession.CanMutateExchangeRate, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="LockOutline" Foreground="#D97706"
                                                     Width="20" Height="20" VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="Modo Solo Lectura: Su cuenta tiene permisos de consulta. Los cambios e importaciones están bloqueados."
                                       Foreground="#B45309" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource HeaderSecondaryButtonStyle}"
                    Command="{Binding DataContext.NavigateToPosCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    VerticalAlignment="Top"
                    ToolTip="Volver al Punto de Venta">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Volver al POS" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Single regime notice: no exchange rate exists, so current rate, manual entry, sync and history are hidden -->
        <Border Grid.Row="1"
                Style="{StaticResource EnterpriseCardStyle}"
                Margin="0,0,0,16"
                VerticalAlignment="Top"
                Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Foreground="#6D28D9"
                                         Width="22" Height="22" VerticalAlignment="Top"
                                         Margin="0,1,12,0"/>
                <TextBlock Text="{Binding SingleModeNotice}"
                           Foreground="#334155" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center" MaxWidth="820"/>
            </StackPanel>
        </Border>

        <!-- Top card: current rate + manual update -->
        <Border Grid.Row="1" Style="{StaticResource EnterpriseCardStyle}" Margin="0,0,0,16"
                Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Current rate KPI -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="TASA VIGENTE" FontSize="11" FontWeight="SemiBold"
                               Foreground="#64748B"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="1 " FontSize="18" FontWeight="SemiBold" Foreground="#64748B"/>
                        <Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyDisplayCode, Mode=OneWay}"
                             FontSize="18" FontWeight="SemiBold" Foreground="#64748B"/>
                        <Run Text=" = " FontSize="18" FontWeight="SemiBold" Foreground="#64748B"/>
                        <Run Text="{Binding CurrentRateDisplay, Mode=OneWay}"
                             FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                        <Run Text=" " FontSize="18" FontWeight="SemiBold" Foreground="#64748B"/>
                        <Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencyDisplayCode, Mode=OneWay}"
                             FontSize="18" FontWeight="SemiBold" Foreground="#64748B"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Border Width="8" Height="8" CornerRadius="999"
                                Background="{Binding LastUpdatedDotColor}"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LastUpdatedStatusText}"
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Manual update form -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Nueva tasa del día" FontSize="12" FontWeight="SemiBold"
                               Foreground="#334155"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource RateInputBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="10,0,6,0">
                                    <Run Text="1 "/>
                                    <Run Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=PrimaryCurrencyDisplayCode, Mode=OneWay}"/>
                                    <Run Text=" ="/>
                                </TextBlock>
                                <TextBox x:Name="RateInput"
                                         Grid.Column="1"
                                         AutomationProperties.AutomationId="ExchangeRate_RateInput"
                                         Text="{Binding NewRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:DecimalCentsBehavior.IsEnabled="True"
                                         IsEnabled="{Binding UserSession.CanMutateExchangeRate}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="20" FontWeight="Bold"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Padding="0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=LocalCurrencyDisplayCode, Mode=OneWay}"
                                           FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="6,0,10,0"/>
                            </Grid>
                        </Border>

                        <Button Margin="8,0,0,0"
                                AutomationProperties.AutomationId="ExchangeRate_SaveButton"
                                Command="{Binding SaveRateCommand}"
                                IsEnabled="{Binding UserSession.CanMutateExchangeRate}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Guardar la tasa manual">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="8,0,0,0"
                                AutomationProperties.AutomationId="ExchangeRate_SyncButton"
                                Command="{Binding SyncBcvCommand}"
                                IsEnabled="{Binding UserSession.CanMutateExchangeRate}"
                                Style="{StaticResource AccentSecondaryButtonStyle}"
                                ToolTip="Obtener la tasa oficial del BCV de hoy">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudSync" Width="16" Height="16"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Sincronizar BCV" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Escriba dígitos seguidos (ej. 92436 → 924,36)"
                               FontSize="11" Foreground="#94A3B8" Margin="2,6,0,0"/>

                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding SyncBcvCommand}"
                                Visibility="{Binding CanRetrySync, Converter={StaticResource BoolToVis}}"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Padding="8,2" Margin="10,0,0,0" Height="28">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Reintentar" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#6D28D9" FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- History -->
        <Border Grid.Row="2" Style="{StaticResource HistoryCardStyle}"
                Margin="0,16,0,0"
                Visibility="{Binding Source={x:Static core:MonetaryProfilePresenter.Instance}, Path=IsSingle, Converter={StaticResource DualOnlyVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF"
                        BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0" Padding="20,14">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding HistoryRows.Count, StringFormat={}{0} registros}"
                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="Historial de Tasas" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#0F172A" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <controls:PerformantDataGrid Grid.Row="1"
                                           ItemsSource="{Binding HistoryRows}"
                                           Visibility="{Binding HasHistoryRecords, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.AutomationId="ExchangeRate_HistoryGrid"
                                           AutoGenerateColumns="False"
                                           CanUserAddRows="False"
                                           CanUserDeleteRows="False"
                                           IsReadOnly="True"
                                           SelectionMode="Single"
                                           SelectionUnit="FullRow"
                                           HeadersVisibility="Column"
                                           ColumnHeaderHeight="42"
                                           RowHeight="42"
                                           GridLinesVisibility="Horizontal"
                                           HorizontalGridLinesBrush="#F1F5F9"
                                           VerticalGridLinesBrush="Transparent"
                                           BorderThickness="0"
                                           Background="Transparent"
                                           RowBackground="#FFFFFF"
                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                                           VirtualizingStackPanel.IsVirtualizing="True"
                                           VirtualizingStackPanel.VirtualizationMode="Recycling"
                                           VirtualizingPanel.ScrollUnit="Pixel"
                                           RowStyle="{StaticResource HistoryRowStyle}">
                    <controls:PerformantDataGrid.Columns>
                        <DataGridTextColumn Header="FECHA"
                                            Binding="{Binding DateDisplay}"
                                            Width="160"
                                            HeaderStyle="{StaticResource GridHeaderLeftStyle}"
                                            ElementStyle="{StaticResource GridCellTextStyle}"/>
                        <DataGridTextColumn Header="TASA"
                                            Binding="{Binding RateDisplay}"
                                            Width="180"
                                            HeaderStyle="{StaticResource GridHeaderRightStyle}"
                                            ElementStyle="{StaticResource GridCellRateStyle}"/>
                        <DataGridTextColumn Header="VARIACIÓN"
                                            Binding="{Binding VariationDisplay}"
                                            Width="120"
                                            HeaderStyle="{StaticResource GridHeaderRightStyle}"
                                            ElementStyle="{StaticResource GridCellVariationStyle}"/>
                        <DataGridTextColumn Header="ACTUALIZACIÓN"
                                            Binding="{Binding UpdatedAtDisplay}"
                                            Width="200"
                                            HeaderStyle="{StaticResource GridHeaderUpdateStyle}"
                                            ElementStyle="{StaticResource GridCellUpdateStyle}"/>
                        <DataGridTemplateColumn Header="ESTADO"
                                                Width="*"
                                                MinWidth="110"
                                                HeaderStyle="{StaticResource GridHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBackground}"
                                            CornerRadius="10" Padding="9,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusForeground}"
                                                   FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </controls:PerformantDataGrid.Columns>
                </controls:PerformantDataGrid>

                <TextBlock Grid.Row="1"
                           Text="Cargando historial..."
                           Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,40" FontSize="12" Foreground="#64748B"/>

                <TextBlock Grid.Row="1"
                           Text="No hay registros de cambios de tasa."
                           Visibility="{Binding HasNoHistoryRecords, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,40" FontSize="12" Foreground="#64748B"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
