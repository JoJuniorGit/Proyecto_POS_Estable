<Window x:Class="Desktop.Client.Views.PettyCashCancelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
        xmlns:converters="clr-namespace:Desktop.Client.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PettyCashCancelDialogViewModel}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Anular Gasto de Caja Chica"
        Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Anular Gasto de Caja Chica" FontSize="18" FontWeight="Bold" Foreground="#991B1B"/>
                <TextBlock Text="{Binding VoucherCode}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#B91C1C" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding ExpenseSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#1E293B"/>
                <TextBlock Text="La anulación conserva el registro histórico y genera una reversa compensatoria con los montos originales."
                           TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBox AutomationProperties.AutomationId="PettyCashCancel_ReasonInput"
                     Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Motivo de la anulación (obligatorio)"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="90" VerticalContentAlignment="Top"/>
            <TextBlock Text="{Binding ValidationMessage}"
                       Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVis}}"
                       Foreground="#B45309" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="2,8,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}"
                       AutomationProperties.AutomationId="PettyCashCancel_ErrorText"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                       Foreground="#B91C1C" TextWrapping="Wrap" Margin="2,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="CANCELAR"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="PettyCashCancel_CancelButton"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    Height="40" Padding="18,0" Margin="0,0,10,0"/>
            <Button Content="ANULAR GASTO"
                    Command="{Binding ConfirmCommand}"
                    AutomationProperties.AutomationId="PettyCashCancel_ConfirmButton"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    Background="#B91C1C" Foreground="White"
                    Height="40" Padding="22,0" FontWeight="Bold"
                    IsDefault="True"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsProcessing}"
                    materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                    materialDesign:ButtonProgressAssist.Value="-1"/>
        </StackPanel>
    </Grid>
</Window>
