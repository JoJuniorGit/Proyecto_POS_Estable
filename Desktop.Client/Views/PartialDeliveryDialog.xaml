<Window x:Class="Desktop.Client.Views.PartialDeliveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PartialDeliveryDialogViewModel}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Registrar Retiro Parcial"
        Height="600"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            CornerRadius="10"
            Background="{DynamicResource MaterialDesignPaper}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageCheck"
                                                 Width="26"
                                                 Height="26"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Registrar Retiro Parcial"
                                   Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Indique las cantidades que se entregan hoy."
                               FontSize="12"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="36,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        IsCancel="True"
                        ToolTip="Cancelar"
                        VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Las cantidades no pueden superar lo pendiente por producto."
                       FontSize="12"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Margin="0,8,0,12"/>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2"
                    Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          MinRowHeight="68"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTO"
                                            Binding="{Binding ProductName}"
                                            IsReadOnly="True"
                                            Width="*"/>
                        <DataGridTextColumn Header="PENDIENTE"
                                            Binding="{Binding PendingQuantity, StringFormat={}{0:0.###}}"
                                            IsReadOnly="True"
                                            Width="110"/>
                        <DataGridTemplateColumn Header="ENTREGAR HOY" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBox Text="{Binding InputQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanDeliver}"
                                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                                 HorizontalContentAlignment="Right"
                                                 Padding="8,4"
                                                 AutomationProperties.AutomationId="PartialDelivery_QuantityInput"/>
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="#B91C1C"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="2,2,2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Notas (opcional)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="68"
                         AutomationProperties.AutomationId="PartialDelivery_NotesInput"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Margin="0,0,12,0"
                        Height="40"
                        Padding="16,0"
                        Click="CancelButton_Click"/>
                <Button Content="Confirmar retiro"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Height="40"
                        Padding="18,0"
                        IsEnabled="{Binding CanConfirm}"
                        IsDefault="True"
                        Click="ConfirmButton_Click"
                        AutomationProperties.AutomationId="PartialDelivery_ConfirmButton"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
