<Window x:Class="Desktop.Client.Views.OcrScannerConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Configurar escáner OCR y plantilla del proveedor"
        Height="820" Width="1220"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Configuración avanzada del escáner OCR (Plantilla por proveedor)"
                           Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                           FontWeight="Bold" />
                <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0">
                    <Run Text="Proveedor seleccionado: " />
                    <Run Text="{Binding SupplierName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" — ajuste recorte, imagen, anclas, columnas y reglas matemáticas sin tocar código." />
                </TextBlock>
            </StackPanel>
            <ProgressBar Grid.Column="1"
                         IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         Width="140" Height="8"
                         VerticalAlignment="Center" />
        </Grid>

        <!-- MAIN SPLIT CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.25*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: INTERACTIVE IMAGE PREVIEW + ROI SELECTOR + SANDBOX RESULTS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.15*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.95*" />
                </Grid.RowDefinitions>

                <!-- Image Toolbar -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Command="{Binding LoadSampleFileCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileImageOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Cargar factura de muestra" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResetRoiCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,8,4"
                            ToolTip="Restablecer el recorte al 100% de la página">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CropFree" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Restablecer zona (100%)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox Content="Ver vista preprocesada (B/N)"
                              IsChecked="{Binding ShowPreprocessedPreview, Mode=TwoWay}"
                              IsEnabled="{Binding HasPreprocessedPreview}"
                              VerticalAlignment="Center"
                              Margin="4,0,0,4" />
                </WrapPanel>

                <!-- Interactive Image Canvas with ROI Drag Box -->
                <Border Grid.Row="1"
                        Background="#0F172A"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Grid x:Name="PreviewContainerGrid"
                          SizeChanged="PreviewContainerGrid_SizeChanged">
                        <Image x:Name="SamplePreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <Canvas x:Name="RoiOverlayCanvas"
                                Background="Transparent"
                                Cursor="Cross"
                                MouseLeftButtonDown="RoiOverlayCanvas_MouseLeftButtonDown"
                                MouseMove="RoiOverlayCanvas_MouseMove"
                                MouseLeftButtonUp="RoiOverlayCanvas_MouseLeftButtonUp">
                            <Rectangle x:Name="RoiSelectionRect"
                                       Stroke="#22C55E"
                                       StrokeThickness="2"
                                       StrokeDashArray="4 2"
                                       Fill="#2622C55E"
                                       Visibility="Collapsed" />
                        </Canvas>
                        <TextBlock x:Name="EmptyPreviewPlaceholder"
                                   Text="Cargue una imagen o PDF de muestra y arrastre con el mouse para delimitar la zona de la tabla de productos (ROI)."
                                   Foreground="#94A3B8"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Width="320"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- ROI & Hints Summary Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5"
                        Margin="0,6,0,6">
                    <StackPanel>
                        <TextBlock Text="{Binding RoiSummaryText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold" />
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,12,0">
                                <Run Text="RIF detectado: " />
                                <Run Text="{Binding DetectedRif, TargetNullValue='—', Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,12,0">
                                <Run Text="Factura: " />
                                <Run Text="{Binding DetectedInvoiceNumber, TargetNullValue='—', Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                <Run Text="Tasa detectada: " />
                                <Run Text="{Binding DetectedExchangeRate, StringFormat=N2, TargetNullValue='—', Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Sandbox Output: Extracted Table & Raw OCR Text -->
                <TabControl Grid.Row="3"
                            Style="{StaticResource MaterialDesignFilledTabControl}">
                    <TabItem Header="Tabla extraída (Prueba)">
                        <DataGrid ItemsSource="{Binding SandboxLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding SupplierCode}" Width="85" />
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Cant." Binding="{Binding Quantity, StringFormat=N2}" Width="65" />
                                <DataGridTextColumn Header="Costo Unit." Binding="{Binding UnitCost, StringFormat=N4}" Width="85" />
                                <DataGridTextColumn Header="Factor" Binding="{Binding ExtractedConversionFactor, StringFormat=N0, TargetNullValue='1'}" Width="60" />
                                <DataGridTextColumn Header="Conf. %" Binding="{Binding NameConfidence, StringFormat=N0}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Texto crudo detectado (Consola)">
                        <TextBox Text="{Binding RawExtractedText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Padding="8" />
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- RIGHT PANEL: 6 CONFIGURATION BLOCKS -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <!-- Bloque 2: Preprocesamiento Visual -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="1. Preprocesamiento visual y orientación"
                                       FontWeight="Bold" Margin="0,0,0,8" />
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding RotateLeftCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="RotateLeft" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Rotar -90°" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RotateRightCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="RotateRight" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Rotar +90°" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetVisualAdjustmentsCommand}"
                                        Content="Restablecer imagen"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="0,0,0,4" />
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="12">
                                        <Run Text="Contraste: " />
                                        <Run Text="{Binding ContrastFactor, StringFormat=N2}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Value="{Binding ContrastFactor, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="12">
                                        <Run Text="Brillo: " />
                                        <Run Text="{Binding BrightnessDelta, StringFormat=N0}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <Slider Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding BrightnessDelta, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          Content="Umbral binario manual (B/N):"
                                          IsChecked="{Binding UseCustomBinarizationThreshold, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2"
                                            IsEnabled="{Binding UseCustomBinarizationThreshold}"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Slider Minimum="30" Maximum="235" Width="180"
                                            Value="{Binding BinarizationThreshold, Mode=TwoWay}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BinarizationThreshold}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Bloque 3: Anclas de Inicio y Fin de Tabla -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="2. Anclas de inicio y fin de tabla"
                                       FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock Text="Palabras clave separadas por coma para detectar dónde empieza y dónde termina la lista de productos."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding HeaderAnchorKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Anclas de encabezado (ej. DESCRIPCION, CANT)"
                                         materialDesign:HintAssist.IsFloating="True" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding FooterAnchorKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Anclas de cierre (ej. SUB-TOTAL, TOTAL, NOTA)"
                                         materialDesign:HintAssist.IsFloating="True" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Bloque 4: Orden y Mapeo de Columnas -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="3. Orden horizontal de columnas (de izquierda a derecha)"
                                       FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock Text="Si la factura del proveedor no tiene encabezados estándar o usa otro orden, indique qué número de columna ocupa cada dato."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ComboBox Grid.Row="0" Grid.Column="0"
                                          ItemsSource="{Binding ColumnPositionOptions}"
                                          SelectedValuePath="Position"
                                          SelectedValue="{Binding ProductColumnPosition, Mode=TwoWay}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Columna de Producto / Descripción"
                                          materialDesign:HintAssist.IsFloating="True" />

                                <ComboBox Grid.Row="0" Grid.Column="2"
                                          ItemsSource="{Binding ColumnPositionOptions}"
                                          SelectedValuePath="Position"
                                          SelectedValue="{Binding QuantityColumnPosition, Mode=TwoWay}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Columna de Cantidad"
                                          materialDesign:HintAssist.IsFloating="True" />

                                <ComboBox Grid.Row="2" Grid.Column="0"
                                          ItemsSource="{Binding ColumnPositionOptions}"
                                          SelectedValuePath="Position"
                                          SelectedValue="{Binding UnitCostColumnPosition, Mode=TwoWay}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Columna de Precio / Costo"
                                          materialDesign:HintAssist.IsFloating="True" />

                                <ComboBox Grid.Row="2" Grid.Column="2"
                                          ItemsSource="{Binding ColumnPositionOptions}"
                                          SelectedValuePath="Position"
                                          SelectedValue="{Binding SupplierCodeColumnPosition, Mode=TwoWay}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Columna de Código (opcional)"
                                          materialDesign:HintAssist.IsFloating="True" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Bloque 5: Reglas Numéricas y Matemáticas -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="4. Reglas numéricas y cálculo de costo"
                                       FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Separador decimal en los montos del proveedor:"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton GroupName="DecSepGroup"
                                             Content="Automático"
                                             IsChecked="{Binding IsDecimalAuto, Mode=TwoWay}"
                                             Margin="0,0,16,0" />
                                <RadioButton GroupName="DecSepGroup"
                                             Content="Coma decimal (1.250,50)"
                                             IsChecked="{Binding IsDecimalComma, Mode=TwoWay}"
                                             Margin="0,0,16,0" />
                                <RadioButton GroupName="DecSepGroup"
                                             Content="Punto decimal (1,250.50)"
                                             IsChecked="{Binding IsDecimalDot, Mode=TwoWay}" />
                            </WrapPanel>

                            <TextBlock Text="Interpretación de la columna de monto:"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <StackPanel>
                                <RadioButton GroupName="CostRuleGroup"
                                             Content="El monto leído ya es el Costo Unitario del ítem"
                                             IsChecked="{Binding IsCostRuleUnitCost, Mode=TwoWay}"
                                             Margin="0,0,0,4" />
                                <RadioButton GroupName="CostRuleGroup"
                                             Content="El monto leído es el Total de la línea (calcular Costo Unitario = Total ÷ Cantidad)"
                                             IsChecked="{Binding IsCostRuleLineTotal, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Bloque 6: Limpieza de Texto y Factor de Empaque -->
                    <materialDesign:Card Padding="14" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="5. Limpieza de texto y extracción de factor (unidades por bulto/caja)"
                                       FontWeight="Bold" Margin="0,0,0,6" />

                            <ComboBox ItemsSource="{Binding FactorPatternOptions}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedFactorPatternKey, Mode=TwoWay}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Detección automática de factor en la descripción"
                                      materialDesign:HintAssist.IsFloating="True"
                                      Margin="0,0,0,8" />

                            <TextBox Text="{Binding CustomFactorRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsCustomFactorPattern, Converter={StaticResource BoolToVis}}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Expresión regular con grupo de captura, ej. X\s*(\d+)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Margin="0,0,0,8" />

                            <TextBlock Text="Reemplazos de caracteres frecuentes en nombres de productos:"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewReplacementFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Texto erróneo (ej. 1X4O)"
                                         materialDesign:HintAssist.IsFloating="True" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding NewReplacementTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Reemplazar por (ej. 1X40)"
                                         materialDesign:HintAssist.IsFloating="True" />
                                <Button Grid.Column="4"
                                        Command="{Binding AddReplacementRuleCommand}"
                                        Content="Agregar"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CharacterReplacements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12">
                                                    <Run Text="'" /><Run Text="{Binding From}" FontWeight="Bold" /><Run Text="'  →  '" /><Run Text="{Binding To}" FontWeight="Bold" /><Run Text="'" />
                                                </TextBlock>
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.RemoveReplacementRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Quitar"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Height="26" Padding="8,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER: STATUS & SANDBOX/SAVE ACTIONS -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />
            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding TestExtractionCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        IsEnabled="{Binding CanTestExtraction}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayOutline" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Probar extracción en vivo" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveTemplateCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding CanSaveTemplate}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Guardar plantilla del proveedor" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyToInvoiceButton"
                        Click="ApplyToInvoiceButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsEnabled="{Binding CanApplyToInvoice}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Guardar y llevar a revisión" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="Cerrar"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
