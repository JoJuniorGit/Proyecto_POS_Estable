<UserControl x:Class="Desktop.Client.Views.UsersManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             xmlns:entities="clr-namespace:Core.Entities;assembly=Core"
             xmlns:views="clr-namespace:Desktop.Client.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1180"
             Background="#F8FAFC"
             d:DataContext="{d:DesignInstance Type=vm:UsersManagementViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InitialsConverter x:Key="InitialsConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVis"/>

        <Style x:Key="EnterpriseCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="TableFooterStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderButtonBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButtonBaseStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UsersTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#6D28D9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CustomersTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="Foreground" Value="#6D28D9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCountPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UsersTabCountPillStyle" TargetType="Border" BasedOn="{StaticResource TabCountPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Background" Value="#EDE9FE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CustomersTabCountPillStyle" TargetType="Border" BasedOn="{StaticResource TabCountPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Background" Value="#EDE9FE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCountTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6D28D9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#5B21B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#4C1D95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#6D28D9"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="36,0,32,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="FilterComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#EDE9FE"/>
                    <Setter Property="Foreground" Value="#5B21B6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EDE9FE"/>
                    <Setter Property="Foreground" Value="#5B21B6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16"
                                                         Foreground="#64748B"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         Margin="0,0,9,0" IsHitTestVisible="False"/>
                                <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                       Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="8" Margin="0,4,0,0" MaxHeight="240" MinWidth="150">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnterpriseColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EnterpriseCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>

        <Style x:Key="EnterpriseMonoCellStyle" TargetType="TextBlock" BasedOn="{StaticResource EnterpriseCellTextStyle}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style x:Key="EnterprisePrimaryCellStyle" TargetType="TextBlock" BasedOn="{StaticResource EnterpriseCellTextStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="EnterpriseRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F5F3FF"/>
                    <Setter Property="BorderBrush" Value="#6D28D9"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EnterpriseCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#CBD5E1"
                                                        CornerRadius="3" Width="6"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                          Opacity="0" Focusable="False" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="24">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="HorizontalThumbBorder" Background="#CBD5E1"
                                                                CornerRadius="3" Height="6"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HorizontalThumbBorder" Property="Background" Value="#94A3B8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                          Opacity="0" Focusable="False" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>

        <Style x:Key="PaginationNumberButtonStyle" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#6D28D9"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaginationTextBoxFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="52"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#6D28D9"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaginationTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PaginationIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PaginationGoButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="#EDE9FE" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Foreground="#6D28D9"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Gestión de Usuarios y Clientes"
                                   AutomationProperties.AutomationId="UsersManagement_Title"
                                   FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Administra accesos, roles del personal y el directorio comercial de clientes."
                                   FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NewUserCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="Users_NewPrimaryButton">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Nuevo Usuario" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CustomerViewModel.OpenNewCustomerCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="Customers_NewPrimaryButton">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Nuevo Cliente" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarMenuButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Segmented control -->
            <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="10" Padding="4"
                    HorizontalAlignment="Left" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource UsersTabButtonStyle}"
                            Command="{Binding LoadUsersCommand}"
                            Click="TabUsers_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Usuarios y Cajeros" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource UsersTabCountPillStyle}">
                                <TextBlock Text="{Binding TotalUserCount}" Style="{StaticResource TabCountTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CustomersTabButtonStyle}"
                            Click="TabCustomers_Click" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountBox" Width="17" Height="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Gestión de Clientes" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource CustomersTabCountPillStyle}">
                                <TextBlock Text="{Binding CustomerViewModel.TotalCount}" Style="{StaticResource TabCountTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="2">
                <!-- Users -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource EnterpriseCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,16,16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SearchFrameStyle}" Margin="0,0,8,0">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBox Text="{Binding UserSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 AutomationProperties.AutomationId="Users_SearchBox"/>
                                        <TextBlock Text="Buscar usuario o nombre..."
                                                   FontSize="12" Foreground="#94A3B8" Margin="36,0,40,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UserSearchQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{DynamicResource MaterialDesignToolButton}"
                                                Command="{Binding ClearUserSearchCommand}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Width="28" Height="28" Margin="0,0,4,0"
                                                ToolTip="Limpiar búsqueda"
                                                Visibility="{Binding UserSearchQuery, Converter={StaticResource StringToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <ComboBox Grid.Column="1" Width="170" Margin="0,0,8,0"
                                          ItemsSource="{Binding UserRoleFilters}"
                                          SelectedItem="{Binding SelectedUserRoleFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBoxStyle}"
                                          AutomationProperties.AutomationId="Users_RoleFilter"/>

                                <ComboBox Grid.Column="2" Width="140" Margin="0,0,8,0"
                                          ItemsSource="{Binding UserStatusFilters}"
                                          SelectedItem="{Binding SelectedUserStatusFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBoxStyle}"
                                          AutomationProperties.AutomationId="Users_StatusFilter"/>

                                <Button Grid.Column="3" Command="{Binding LoadUsersCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        AutomationProperties.AutomationId="Users_RefreshButton">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refrescar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding Users}"
                                          SelectedItem="{Binding SelectedUser}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          VerticalGridLinesBrush="Transparent"
                                          RowHeight="52"
                                          ColumnHeaderHeight="42"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          RowBackground="#FFFFFF"
                                          AlternatingRowBackground="#FFFFFF"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ColumnHeaderStyle="{StaticResource EnterpriseColumnHeaderStyle}"
                                          RowStyle="{StaticResource EnterpriseRowStyle}"
                                          CellStyle="{StaticResource EnterpriseCellStyle}"
                                          MouseDoubleClick="UsersGrid_MouseDoubleClick"
                                          AutomationProperties.AutomationId="Users_Grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="USUARIO"
                                                            Binding="{Binding Cedula}"
                                                            Width="200" MinWidth="160"
                                                            ElementStyle="{StaticResource EnterprisePrimaryCellStyle}"/>

                                        <DataGridTemplateColumn Header="NOMBRE" Width="520" MinWidth="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="12,0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#EDE9FE"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                                       FontSize="11" FontWeight="Bold" Foreground="#5B21B6"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                                   TextWrapping="Wrap" MaxHeight="38"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ROL" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static entities:UserRole.Admin}">
                                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static entities:UserRole.Manager}">
                                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Role}" Value="{x:Static entities:UserRole.Driver}">
                                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Cajero"/>
                                                                    <Setter Property="Foreground" Value="#B45309"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static entities:UserRole.Admin}">
                                                                            <Setter Property="Text" Value="Administrador"/>
                                                                            <Setter Property="Foreground" Value="#5B21B6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static entities:UserRole.Manager}">
                                                                            <Setter Property="Text" Value="Gerente"/>
                                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static entities:UserRole.Driver}">
                                                                            <Setter Property="Text" Value="Conductor"/>
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ESTADO" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#94A3B8"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Fill" Value="#16A34A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Inactivo"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Text" Value="Activo"/>
                                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ACCIONES" Width="120" HeaderStyle="{StaticResource EnterpriseColumnHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.OpenEditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                                            Height="30" Padding="10,0"
                                                            HorizontalAlignment="Right"
                                                            AutomationProperties.AutomationId="Users_EditAction">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Editar" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding Users.Count, Converter={StaticResource CollectionEmptyToVis}}">
                                    <materialDesign:PackIcon Kind="AccountSearchOutline" Width="34" Height="34"
                                                             Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No se encontraron resultados para tu búsqueda."
                                               FontSize="13" Foreground="#64748B" Margin="0,10,0,8" HorizontalAlignment="Center"/>
                                    <Button Content="Limpiar filtros" Command="{Binding ClearUserFiltersCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}" Height="32"
                                            HorizontalAlignment="Center" IsHitTestVisible="True"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource TableFooterStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="#64748B" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding UserPageSummary}" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"
                                                   AutomationProperties.AutomationId="Users_PageSummary"/>
                                        <Button Command="{Binding FirstUserPageCommand}" IsEnabled="{Binding CanGoFirstUser}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="0,0,3,0" ToolTip="Primera página">
                                            <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding PreviousUserPageCommand}" IsEnabled="{Binding CanGoPreviousUser}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="0,0,5,0" ToolTip="Página anterior">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding UserPageNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.GoToUserPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding PageNumber}" Content="{Binding PageNumber}"
                                                            Style="{StaticResource PaginationNumberButtonStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Command="{Binding NextUserPageCommand}" IsEnabled="{Binding CanGoNextUser}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="5,0,3,0" ToolTip="Página siguiente">
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding LastUserPageCommand}" IsEnabled="{Binding CanGoLastUser}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="0,0,8,0" ToolTip="Última página">
                                            <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                                        </Button>
                                        <Rectangle Width="1" Height="20" Fill="#E2E8F0" Margin="0,0,7,0"/>
                                        <TextBlock Text="Ir a:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource PaginationTextBoxFrameStyle}" Margin="0,0,4,0">
                                            <TextBox Text="{Binding UserTargetPageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PaginationTextBoxStyle}"
                                                     PreviewTextInput="NumberValidationTextBox">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding SubmitUserGoToPageCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Border>
                                        <Button Command="{Binding SubmitUserGoToPageCommand}"
                                                Style="{StaticResource PaginationGoButtonStyle}" ToolTip="Ir a la página">
                                            <materialDesign:PackIcon Kind="ArrowRight" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Customers -->
                <Grid DataContext="{Binding CustomerViewModel}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource EnterpriseCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="16,16,16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SearchFrameStyle}" Margin="0,0,8,0">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 AutomationProperties.AutomationId="Customers_SearchBox"/>
                                        <TextBlock Text="Buscar por Cédula/RIF, Nombre o Teléfono..."
                                                   FontSize="12" Foreground="#94A3B8" Margin="36,0,40,0"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{DynamicResource MaterialDesignToolButton}"
                                                Command="{Binding ClearCustomerSearchCommand}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Width="28" Height="28" Margin="0,0,4,0"
                                                ToolTip="Limpiar búsqueda"
                                                Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0"
                                          ItemsSource="{Binding CustomerStatusFilters}"
                                          SelectedItem="{Binding SelectedCustomerStatusFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilterComboBoxStyle}"
                                          AutomationProperties.AutomationId="Customers_StatusFilter"/>

                                <Button Grid.Column="2" Command="{Binding LoadCustomersCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        AutomationProperties.AutomationId="Customers_RefreshButton">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Refrescar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          VerticalGridLinesBrush="Transparent"
                                          RowHeight="52"
                                          ColumnHeaderHeight="42"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          RowBackground="#FFFFFF"
                                          AlternatingRowBackground="#FFFFFF"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ColumnHeaderStyle="{StaticResource EnterpriseColumnHeaderStyle}"
                                          RowStyle="{StaticResource EnterpriseRowStyle}"
                                          CellStyle="{StaticResource EnterpriseCellStyle}"
                                          MouseDoubleClick="CustomersGrid_MouseDoubleClick"
                                          AutomationProperties.AutomationId="Customers_Grid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CÉDULA / RIF"
                                                            Binding="{Binding CedulaOrRif}"
                                                            Width="170" MinWidth="145"
                                                            ElementStyle="{StaticResource EnterpriseMonoCellStyle}"/>

                                        <DataGridTemplateColumn Header="NOMBRE / RAZÓN SOCIAL" Width="550" MinWidth="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="12,0" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#F1F5F9"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                                       FontSize="11" FontWeight="Bold" Foreground="#334155"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="TELÉFONO" Width="155" MinWidth="155">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#334155"
                                                               VerticalAlignment="Center" Margin="12,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Phone}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Phone}" Value="">
                                                                        <Setter Property="Text" Value="Sin teléfono"/>
                                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ESTADO" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#94A3B8"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Fill" Value="#16A34A"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Inactivo"/>
                                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Text" Value="Activo"/>
                                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="ACCIONES" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.OpenEditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                                            Height="30" Padding="10,0"
                                                            HorizontalAlignment="Right"
                                                            AutomationProperties.AutomationId="Customers_EditAction">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Editar" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding Customers.Count, Converter={StaticResource CollectionEmptyToVis}}">
                                    <materialDesign:PackIcon Kind="AccountSearchOutline" Width="34" Height="34"
                                                             Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No se encontraron resultados para tu búsqueda."
                                               FontSize="13" Foreground="#64748B" Margin="0,10,0,8" HorizontalAlignment="Center"/>
                                    <Button Content="Limpiar filtros" Command="{Binding ClearCustomerFiltersCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}" Height="32"
                                            HorizontalAlignment="Center" IsHitTestVisible="True"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource TableFooterStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11"
                                               Foreground="#64748B" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"
                                                   AutomationProperties.AutomationId="Customers_PageSummary"/>
                                        <Button Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoToFirstPage}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="0,0,3,0" ToolTip="Primera página">
                                            <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="0,0,5,0" ToolTip="Página anterior">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding PageNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding PageNumber}" Content="{Binding PageNumber}"
                                                            Style="{StaticResource PaginationNumberButtonStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="5,0,3,0" ToolTip="Página siguiente">
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoToLastPage}"
                                                Style="{StaticResource PaginationIconButtonStyle}" Margin="0,0,8,0" ToolTip="Última página">
                                            <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                                        </Button>
                                        <Rectangle Width="1" Height="20" Fill="#E2E8F0" Margin="0,0,7,0"/>
                                        <TextBlock Text="Ir a:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,5,0"/>
                                        <Border Style="{StaticResource PaginationTextBoxFrameStyle}" Margin="0,0,4,0">
                                            <TextBox Text="{Binding TargetPageInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PaginationTextBoxStyle}"
                                                     PreviewTextInput="NumberValidationTextBox">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding SubmitGoToPageCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Border>
                                        <Button Command="{Binding SubmitGoToPageCommand}"
                                                Style="{StaticResource PaginationGoButtonStyle}" ToolTip="Ir a la página">
                                            <materialDesign:PackIcon Kind="ArrowRight" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Toast no bloqueante -->
        <Border Grid.Row="2" Panel.ZIndex="40"
                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,8,8,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#16A34A"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="#166534" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Style="{DynamicResource MaterialDesignToolButton}" Command="{Binding DismissToastCommand}"
                        Width="24" Height="24" Margin="8,0,0,0" ToolTip="Cerrar aviso">
                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#166534"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- User modal overlay -->
        <Grid Panel.ZIndex="100" Background="#730F172A"
              Visibility="{Binding IsUserModalOpen, Converter={StaticResource BoolToVis}}">
            <views:UserEditorModal HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Customer modal overlay -->
        <Grid Panel.ZIndex="100" Background="#730F172A"
              Visibility="{Binding CustomerViewModel.IsCustomerModalOpen, Converter={StaticResource BoolToVis}}">
            <views:CustomerEditorModal DataContext="{Binding CustomerViewModel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
