<UserControl x:Class="Desktop.Client.Views.UsersManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             Background="{DynamicResource MaterialDesignPaper}"
             d:DataContext="{d:DesignInstance Type=vm:UsersManagementViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Segmented Control Tabs -->
            <RowDefinition Height="*"/>      <!-- Tab Content Area -->
        </Grid.RowDefinitions>

        <!-- ── 1. Encabezado Principal ── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Gestión de Usuarios y Clientes" FontSize="22" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                <Button Style="{DynamicResource MaterialDesignIconButton}"
                        Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        ToolTip="Abrir menú principal">
                    <materialDesign:PackIcon Kind="Cog" Width="28" Height="28" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ── 2. Segmented Control Switcher (Pestañas Usuarios / Clientes) ── -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="4" Margin="0,0,0,18" HorizontalAlignment="Left" Width="440">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding DataContext.LoadUsersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Click="TabUsers_Click"
                        Height="38" Padding="12,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Background" Value="#7C3AED"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Usuarios y Cajeros" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Click="TabCustomers_Click"
                        Height="38" Padding="12,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Background" Value="#7C3AED"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountBox" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Gestión de Clientes" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                </Button>
            </Grid>
        </Border>

        <!-- ── 3. ÁREA DE CONTENIDO ── -->
        <Grid Grid.Row="2">

            <!-- ══════════════════════════════════════════
                 PESTAÑA 1: GESTIÓN DE USUARIOS Y CAJEROS
                 ══════════════════════════════════════════ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Columna 1: DataGrid de Usuarios -->
                <Border Grid.Column="0" Margin="0,0,16,0" Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="12" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <DockPanel>
                        <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Bottom" Margin="4,8,4,4" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12"/>
                        <DataGrid ItemsSource="{Binding Users}"
                                  SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="100"/>
                                <DataGridTemplateColumn Header="Estado" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#1F2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#1FC62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="Activo"/>
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Columna 2: Formulario de Usuario -->
                <Border Grid.Column="1" Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="20" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nuevo Usuario"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Editar Usuario"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Command="{Binding NewUserCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="8,0" DockPanel.Dock="Right">
                                <TextBlock Text="+ Nuevo" FontSize="12"/>
                            </Button>
                        </DockPanel>

                        <TextBox Text="{Binding Cedula, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Cédula de Identidad *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Nombre y Apellido *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16"/>

                        <!-- Input Field: Contraseña con Botón de Ojo (Mostrar / Ocultar) -->
                        <Grid Margin="0,0,0,16">
                            <PasswordBox x:Name="UserPasswordBox"
                                         materialDesign:HintAssist.Hint="{Binding PasswordHint}"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         Padding="0,0,36,0"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}"
                                         PasswordChanged="UserPasswordBox_PasswordChanged"/>

                            <TextBox x:Name="UserPasswordTextBox"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{Binding PasswordHint}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="0,0,36,0"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>

                            <Button Style="{DynamicResource MaterialDesignToolButton}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="32" Height="32" Margin="0,0,6,0"
                                    ToolTip="Mostrar / Ocultar Contraseña">
                                <materialDesign:PackIcon Width="20" Height="20" Foreground="#64748B">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="EyeOutline"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Kind" Value="EyeOffOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                        </Grid>

                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding Role}"
                                  materialDesign:HintAssist.Hint="Rol del Usuario *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,16"/>

                        <CheckBox IsChecked="{Binding IsActive}"
                                  Content="Usuario Activo"
                                  Margin="0,0,0,24"/>

                        <Button Command="{Binding SaveUserCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="44" FontSize="14" FontWeight="Bold" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="GUARDAR USUARIO" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleActiveUserCommand}"
                                Height="38" FontSize="13" Margin="0,0,0,8"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="BorderBrush" Value="#C62828"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="False">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="AccountCancel"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="False">
                                                    <Setter Property="Kind" Value="AccountCheck"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Desactivar Usuario"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="False">
                                                    <Setter Property="Text" Value="Activar Usuario"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding HardDeleteUserCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#B71C1C" BorderBrush="#B71C1C"
                                Height="38" FontSize="13"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Eliminar Definitivamente" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════
                 PESTAÑA 2: GESTIÓN DE CLIENTES (CRUD COMPLETO)
                 ══════════════════════════════════════════ -->
            <Grid DataContext="{Binding CustomerViewModel}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Columna 1: DataGrid de Clientes y Búsqueda -->
                <Border Grid.Column="0" Margin="0,0,16,0" Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="16" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <DockPanel>
                        <!-- Buscador + Botón Refrescar -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" Panel.ZIndex="1"/>
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Buscar cliente por Cédula/RIF o Nombre..."
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                         Padding="38,8,12,8" FontSize="13"/>
                            </Grid>

                            <Button Grid.Column="1" Command="{Binding LoadCustomersCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="38" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refrescar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Controles de Paginación y Estado -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Width="34" Padding="0" Margin="0,0,4,0" ToolTip="Página Anterior">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                                </Button>
                                <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="6,0"/>
                                <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Width="34" Padding="0" Margin="4,0,0,0" ToolTip="Página Siguiente">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12"/>
                        </DockPanel>

                        <!-- DataGrid Clientes -->
                        <DataGrid ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cédula / RIF" Binding="{Binding CedulaOrRif}" Width="110" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Nombre / Razón Social" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTemplateColumn Header="Estado" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#1F2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#1FC62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="Activo"/>
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>


                <!-- Columna 2: Formulario de Creación / Edición de Cliente -->
                <Border Grid.Column="1" Background="{DynamicResource MaterialDesignCard}" CornerRadius="8" Padding="20" Effect="{DynamicResource MaterialDesignShadowDepth1}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nuevo Cliente"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Text" Value="Editar Cliente"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Command="{Binding NewCustomerCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="8,0" DockPanel.Dock="Right" IsEnabled="{Binding CanMutate}">
                                <TextBlock Text="+ Nuevo" FontSize="12"/>
                            </Button>
                        </DockPanel>

                        <!-- Cédula / RIF Input Controlado con Testigo Verde -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid>
                                <TextBox Text="{Binding CedulaOrRif, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Cédula o RIF *"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="12,10,34,10"
                                         IsEnabled="{Binding CanMutate}"/>
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="#059669"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                         Visibility="{Binding IsCedulaValid, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <TextBlock Text="Ej: V-12345678 (V/E + 7 u 8 dígitos)" FontSize="11" Foreground="#64748B" Margin="4,2,0,0"/>
                        </StackPanel>

                        <!-- Nombre o Razón Social (MaxLength = 50) -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="50"
                                         materialDesign:HintAssist.Hint="Nombre Completo o Razón Social *"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="12,10,50,10"
                                         IsEnabled="{Binding CanMutate}"/>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#64748B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNameNearLimit}" Value="True">
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding NameLength, Mode=OneWay}"/>
                                    <Run Text=" / 50"/>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Máximo 50 caracteres para reportes y facturas" FontSize="11" Foreground="#64748B" Margin="4,2,0,0"/>
                        </StackPanel>

                        <!-- Teléfono Input Controlado con Testigo Verde -->
                        <StackPanel Margin="0,0,0,14">
                            <Grid>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Teléfono *"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="12,10,34,10"
                                         IsEnabled="{Binding CanMutate}"/>
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="#059669"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                         Visibility="{Binding IsPhoneValid, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <TextBlock Text="Ej: 0412-1234567 (11 dígitos)" FontSize="11" Foreground="#64748B" Margin="4,2,0,0"/>
                        </StackPanel>

                        <!-- CheckBox Activo -->
                        <CheckBox IsChecked="{Binding IsActive}" Content="Cliente Activo" Margin="0,0,0,20" IsEnabled="{Binding CanMutate}"/>

                        <!-- Botón Guardar -->
                        <Button Command="{Binding SaveCustomerCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#7C3AED" Foreground="White"
                                Height="44" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"
                                IsEnabled="{Binding CanMutate}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="GUARDAR CLIENTE" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Desactivar / Activar -->
                        <Button Command="{Binding ToggleActiveCustomerCommand}"
                                Height="38" FontSize="13" Margin="0,0,0,8"
                                IsEnabled="{Binding CanMutate}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="BorderBrush" Value="#C62828"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="AccountCancel"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Kind" Value="AccountCheck"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Desactivar Cliente"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="Activar Cliente"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Botón Eliminar Cliente -->
                        <Button Command="{Binding DeleteCustomerCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#B71C1C" BorderBrush="#B71C1C"
                                Height="38" FontSize="13"
                                IsEnabled="{Binding CanMutate}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteForever" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Eliminar Cliente" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
