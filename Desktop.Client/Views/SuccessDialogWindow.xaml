<Window x:Class="Desktop.Client.Views.SuccessDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Success" Height="180" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    
    <!-- Transparent outer grid to allow drop shadow rendering space outside the border -->
    <Grid Margin="16">
        <Border Background="{DynamicResource MaterialDesignPaper}" 
                CornerRadius="8" 
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.15" />
            </Border.Effect>
            
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckCircle" Width="48" Height="48" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,16,0" />
                    
                    <TextBlock Text="{Binding Message}" 
                               FontFamily="Segoe UI" 
                               FontSize="18" 
                               FontWeight="Medium" 
                               TextWrapping="Wrap" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Continue" 
                            IsDefault="True"
                            Click="AcceptButton_Click"
                            Style="{DynamicResource MaterialDesignFlatButton}" 
                            Foreground="#10B981"
                            FontWeight="SemiBold"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
