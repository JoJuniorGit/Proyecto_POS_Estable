<UserControl x:Class="Desktop.Client.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Desktop.Client.Views"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:controls="clr-namespace:Desktop.Client.Controls"
             xmlns:converters="clr-namespace:Desktop.Client.Converters"
             xmlns:behaviors="clr-namespace:Desktop.Client.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyMultiplierConverter x:Key="CurrencyMultiplier"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CheckoutCommand}" />
        <KeyBinding Key="F2" Command="{Binding HoldOrderCommand}" />
    </UserControl.InputBindings>

    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Items & Search -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: Search -->
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="SearchInput"
                             materialDesign:HintAssist.Hint="Enter the desired product"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <i:Interaction.Behaviors>
                            <behaviors:SearchKeyboardBehavior TargetListBox="{Binding ElementName=SuggestionsList}"
                                                              EnterCommand="{Binding AddSelectedSuggestionCommand}" />
                        </i:Interaction.Behaviors>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="GotFocus">
                                <i:InvokeCommandAction Command="{Binding SearchGotFocusCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                    
                    <Popup IsOpen="{Binding HasSuggestions, Mode=TwoWay}"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=SearchInput}"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <materialDesign:Card MaxHeight="300" Width="{Binding ElementName=SearchInput, Path=ActualWidth}">
                            <ListBox x:Name="SuggestionsList"
                                     ItemsSource="{Binding Suggestions}"
                                     SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                        <!-- Prevent the ListBox item from logically stealing keyboard focus from TextBox -->
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="4" Background="Transparent">
                                            <StackPanel.InputBindings>
                                                <!-- Safely capture mouse click exclusively without disrupting logical tree -->
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.AddSelectedSuggestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              CommandParameter="{Binding}"/>
                                            </StackPanel.InputBindings>
                                            
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Opacity="0.7">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <!-- Hide prices and SKU details for dummy "Not Found" items (Id == -1) -->
                                                            <DataTrigger Binding="{Binding Id}" Value="-1">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding PriceBsS, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </materialDesign:Card>
                    </Popup>
                </Grid>

                <!-- Content Area -->
                <Grid Grid.Row="1">
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="{Binding Cart.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="CartOff" Width="64" Height="64" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No items" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" Foreground="Gray" HorizontalAlignment="Center"/>
                        <Button Content="Search product (F3)" 
                                Click="FocusSearch_Click"
                                Style="{DynamicResource MaterialDesignFlatButton}" 
                                Margin="0,10,0,0"/> 
                    </StackPanel>

                    <!-- Order Table -->
                    <DataGrid x:Name="CartGrid"
                              ItemsSource="{Binding Cart.CartItems}" 
                              SelectedItem="{Binding Cart.SelectedSaleItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionUnit="FullRow"
                              behaviors:DataGridFocusBehavior.KeepFocusOnSelection="True">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Add" Command="{Binding Cart.IncreaseQuantityCommand}" CommandParameter="{Binding Cart.SelectedSaleItem}" />
                            <KeyBinding Key="OemPlus" Command="{Binding Cart.IncreaseQuantityCommand}" CommandParameter="{Binding Cart.SelectedSaleItem}" />
                            <KeyBinding Key="Subtract" Command="{Binding Cart.DecreaseQuantityCommand}" CommandParameter="{Binding Cart.SelectedSaleItem}" />
                            <KeyBinding Key="OemMinus" Command="{Binding Cart.DecreaseQuantityCommand}" CommandParameter="{Binding Cart.SelectedSaleItem}" />
                            <KeyBinding Key="Delete" Command="{Binding Cart.RemoveItemCommand}" CommandParameter="{Binding Cart.SelectedSaleItem}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Cart.IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Product name" Width="*" MinWidth="120" MaxWidth="350">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                            <TextBlock Text="{Binding DisplayProductName}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Background="#10B981"
                                                    Visibility="{Binding IsWholesaleApplied, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Mayorista" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Qty" Width="Auto" MinWidth="80">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QuantityDisplay}" 
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" 
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 FontWeight="Bold"
                                                 BorderThickness="0"
                                                 Loaded="EditQuantityBox_Loaded"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Price" IsReadOnly="True" Width="Auto" MinWidth="110" MaxWidth="160">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPriceBsS, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Total" IsReadOnly="True" Width="Auto" MinWidth="110" MaxWidth="160">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SubtotalBsS, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Right Column: Totals -->
            <Border Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" materialDesign:ElevationAssist.Elevation="Dp2" Margin="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <Button Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Command="{Binding Cart.RemoveItemCommand}"
                                CommandParameter="{Binding Cart.SelectedSaleItem}"
                                ToolTip="Remove Selected Item (Delete)"
                                Foreground="Red" BorderBrush="Red"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete Item" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Summary" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,10"/>
                        
                    <!-- Customer Info -->
                    <Border Background="{DynamicResource PrimaryHueLightBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,15"
                            Effect="{DynamicResource MaterialDesignShadowDepth1}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Label -->
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                       Text="CLIENTE DE LA VENTA"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                       Opacity="0.75"
                                       Margin="0,0,0,6"/>

                            <!-- Avatar Icon -->
                            <Border Grid.Column="0" Grid.Row="1" Grid.RowSpan="2"
                                    Width="38" Height="38" CornerRadius="19"
                                    Background="{DynamicResource PrimaryHueDarkBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AccountCircle"
                                                         Width="24" Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                            </Border>

                            <!-- Customer Name -->
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{Binding Cart.CustomerName}"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                       VerticalAlignment="Bottom"/>

                            <!-- Cedula -->
                            <TextBlock Grid.Column="1" Grid.Row="2"
                                       Text="{Binding Cart.CustomerCedula}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                       Opacity="0.85"
                                       VerticalAlignment="Top"/>

                            <!-- Change Button -->
                            <Button Grid.Column="2" Grid.Row="1" Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Padding="10,6"
                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                    BorderBrush="{DynamicResource PrimaryHueMidForegroundBrush}"
                                    Command="{Binding ChangeCustomerCommand}"
                                    ToolTip="Buscar o cambiar el cliente de esta venta">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountSwitch" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cambiar" Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                        
                        <!-- Price List Selector (Detal / Mayor) -->
                        <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="4" Padding="10" Margin="0,0,0,15" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lista de Precios" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{DynamicResource MaterialDesignFlatButton}"
                                            Padding="8,2" Height="28" Margin="0,0,4,0"
                                            Content="Detal"
                                            Command="{Binding Cart.SetPriceListCommand}"
                                            CommandParameter="Retail"/>
                                    <Button Style="{DynamicResource MaterialDesignFlatButton}"
                                            Padding="8,2" Height="28"
                                            Content="Mayor"
                                            Command="{Binding Cart.SetPriceListCommand}"
                                            CommandParameter="Wholesale"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <Grid Margin="0,5">
                            <TextBlock Text="Subtotal"/>
                            <TextBlock Text="{Binding Cart.SubtotalLocal, StringFormat='Bs.S {0:N2}'}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="TOTAL" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                            
                            <!-- Primary Total (Bs.S) -->
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Cart.TotalAmountLocal, StringFormat='Bs.S {0:N2}'}" 
                                       FontWeight="Heavy" 
                                       FontSize="28" 
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}" 
                                       HorizontalAlignment="Right"/>
                                       
                            <!-- Secondary Legend (USD) -->
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Cart.TotalUSD, StringFormat='$ {0:N2}'}" 
                                       FontSize="14" 
                                       Opacity="0.6" 
                                       Foreground="Gray" 
                                       HorizontalAlignment="Right" 
                                       Margin="10,-5,10,0"/>
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <!-- EN ESPERA (F2) -->
                            <Button Grid.Column="0"
                                    Command="{Binding HoldOrderCommand}"
                                    Height="50"
                                    ToolTip="Guardar pedido en Cuentas Abiertas (requiere cliente registrado)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Setter Property="Foreground" Value="#B45309"/>
                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cart.IsEmpty}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardClock" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="EN ESPERA (F2)" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- CHECKOUT (F1) -->
                            <Button Grid.Column="2"
                                    Content="CHECKOUT (F1)" 
                                    Command="{Binding CheckoutCommand}" 
                                    Height="50"
                                    FontSize="17" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Cart.IsEmpty}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>

                    
                    <!-- Bottom-right Gear Icon (Opens Side Drawer) -->
                    <Button Grid.Row="1"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                            CommandParameter="{x:Static Dock.Right}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            ToolTip="Open Main Menu"
                            Margin="0,20,0,0">
                        <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.7">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#EEE" CornerRadius="3" Padding="5,2" Margin="0,0,5,0">
                        <TextBlock Text="F3" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="Search" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#EEE" CornerRadius="3" Padding="5,2" Margin="0,0,5,0">
                        <TextBlock Text="+/-" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="Qty" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#EEE" CornerRadius="3" Padding="5,2" Margin="0,0,5,0">
                        <TextBlock Text="DblClick" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="Edit Qty" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#EEE" CornerRadius="3" Padding="5,2" Margin="0,0,5,0">
                        <TextBlock Text="Esc" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="Close/Cancel" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
