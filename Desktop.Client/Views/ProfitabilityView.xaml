<UserControl x:Class="Desktop.Client.Views.ProfitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfitabilityViewModel}"
             d:DesignHeight="720" d:DesignWidth="1024">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Effect" Value="{DynamicResource MaterialDesignShadowDepth1}" />
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ChartBarStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="12" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
            <Setter Property="Fill" Value="#2563EB" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                            CommandParameter="{x:Static Dock.Right}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Open Navigation Menu"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" />
                    </Button>
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource PrimaryHueLightBrush}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Rentabilidad" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBlock Text="Estado de Resultados devengado y percibido"
                                   FontSize="12"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                 Value="0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Width="20" Height="20" Margin="0,0,12,0" />
                    <Button Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="Profitability_RefreshButton"
                            Style="{DynamicResource MaterialDesignIconButton}"
                            ToolTip="Actualizar rentabilidad"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="24" Height="24" />
                    </Button>
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}"
                            AutomationProperties.AutomationId="Profitability_ExportCsv"
                            IsEnabled="{Binding CanExport}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,6,0" />
                    <Button Content="XLSX" Command="{Binding ExportXlsxCommand}"
                            IsEnabled="{Binding CanExport}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,6,0" />
                    <Button Content="PDF" Command="{Binding ExportPdfCommand}"
                            IsEnabled="{Binding CanExport}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="12,0" />
                </StackPanel>
            </Grid>

            <!-- Period and view-mode controls -->
            <Border Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,0,14">
                <WrapPanel>
                    <TextBlock Text="Período:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Hoy" Command="{Binding SelectPresetCommand}" CommandParameter="Today"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,6" />
                    <Button Content="Ayer" Command="{Binding SelectPresetCommand}" CommandParameter="Yesterday"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,6" />
                    <Button Content="Semana" Command="{Binding SelectPresetCommand}" CommandParameter="Week"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,6" />
                    <Button Content="Mes" Command="{Binding SelectPresetCommand}" CommandParameter="Month"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,6" />
                    <Button Content="Personalizado" Command="{Binding SelectPresetCommand}" CommandParameter="Custom"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,10,6" />

                    <DatePicker SelectedDate="{Binding CustomFromDate, Mode=TwoWay}"
                                Visibility="{Binding IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Width="130" Height="32" Margin="0,0,6,6" />
                    <DatePicker SelectedDate="{Binding CustomToDate, Mode=TwoWay}"
                                Visibility="{Binding IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Width="130" Height="32" Margin="0,0,6,6" />
                    <Button Content="Aplicar" Command="{Binding ApplyCustomRangeCommand}"
                            Visibility="{Binding IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{DynamicResource MaterialDesignRaisedButton}" Height="32" Padding="12,0" Margin="0,0,16,6" />

                    <Rectangle Width="1" Height="22" Fill="#E2E8F0" Margin="4,0,12,6" />
                    <TextBlock Text="Vista:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Devengado"
                            AutomationProperties.AutomationId="Profitability_ToggleAccrued"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="{x:Static vm:ProfitabilityViewMode.Accrued}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,6" />
                    <Button Content="Percibido"
                            AutomationProperties.AutomationId="Profitability_ToggleRealized"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="{x:Static vm:ProfitabilityViewMode.Realized}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,6" />
                    <Button Content="Ambos"
                            AutomationProperties.AutomationId="Profitability_ToggleBoth"
                            Command="{Binding SetViewModeCommand}"
                            CommandParameter="{x:Static vm:ProfitabilityViewMode.Both}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,0,6" />
                </WrapPanel>
            </Border>

            <!-- Error state -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- Headline KPIs -->
            <UniformGrid Columns="2" Margin="0,0,0,2">
                <Border Style="{StaticResource KpiCardStyle}" Background="#EFF6FF" BorderBrush="#BFDBFE">
                    <StackPanel>
                        <TextBlock Text="UTILIDAD DEVENGADA" Style="{StaticResource KpiLabelStyle}" Foreground="#1D4ED8" />
                        <TextBlock Text="{Binding UtilidadDevengadaDisplay}" FontSize="34" FontWeight="ExtraBold"
                                   AutomationProperties.AutomationId="Profitability_KpiAccrued"
                                   Foreground="#1D4ED8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Resultado neto del período por ventas y gastos devengados"
                                   FontSize="11" Foreground="#3B82F6" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}" Background="#ECFDF5" BorderBrush="#A7F3D0">
                    <StackPanel>
                        <TextBlock Text="UTILIDAD PERCIBIDA EN CAJA" Style="{StaticResource KpiLabelStyle}" Foreground="#047857" />
                        <TextBlock Text="{Binding UtilidadPercibidaDisplay}" FontSize="30" FontWeight="ExtraBold"
                                   AutomationProperties.AutomationId="Profitability_KpiRealized"
                                   Foreground="#047857" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Resultado neto de los cobros efectivamente realizados"
                                   FontSize="11" Foreground="#10B981" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Detail KPIs -->
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="VENTAS NETAS" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding VentasNetasDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CMV" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding CmvDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="UTILIDAD BRUTA" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding UtilidadBrutaDisplay}" Style="{StaticResource KpiValueStyle}" Foreground="#047857" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MARGEN BRUTO" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding MargenDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="COMISIONES DE SERVICIO" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding ComisionesServicioDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DIFERENCIA FX (INFORMATIVA)" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding FxDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CAJA CHICA" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding CajaChicaDisplay}" Style="{StaticResource KpiValueStyle}" Foreground="#B45309" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="COMISIONES DE MEDIOS DE PAGO" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding ComisionesMediosDisplay}" Style="{StaticResource KpiValueStyle}" Foreground="#B45309" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="UTILIDAD NETA" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding UtilidadNetaDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MARGEN NETO" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding MargenNetoDisplay}" Style="{StaticResource KpiValueStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Coverage banner -->
            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,0,14"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Cobertura de datos históricos"
                               AutomationProperties.AutomationId="Profitability_Coverage"
                               FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                    <WrapPanel>
                        <TextBlock Text="Costo:" FontWeight="SemiBold" Margin="0,0,4,4" />
                        <TextBlock Text="{Binding CostCoverageDisplay}" Margin="0,0,14,4" />
                        <TextBlock Text="Comisiones:" FontWeight="SemiBold" Margin="0,0,4,4" />
                        <TextBlock Text="{Binding FeeCoverageDisplay}" Margin="0,0,14,4" />
                        <TextBlock Text="Ingreso sin costo:" FontWeight="SemiBold" Margin="0,0,4,4" />
                        <TextBlock Text="{Binding UnknownCostRevenueDisplay}" Margin="0,0,4,4" />
                        <TextBlock Margin="0,0,14,4">
                            <Run Text="(" /><Run Text="{Binding UnknownCostLinesCount, Mode=OneWay}" /><Run Text=" líneas)" />
                        </TextBlock>
                        <TextBlock Text="Cobros sin fee:" FontWeight="SemiBold" Margin="0,0,4,4" />
                        <TextBlock Text="{Binding UnknownFeePaymentAmountDisplay}" Margin="0,0,4,4" />
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="(" /><Run Text="{Binding UnknownFeePaymentsCount, Mode=OneWay}" /><Run Text=" pagos)" />
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Text="Los valores desconocidos se informan sin inventar ni reprocesar datos históricos."
                               FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GlobalCostsNote}"
                               Visibility="{Binding HasGlobalCostsNote, Converter={StaticResource BooleanToVisibilityConverter}}"
                               FontSize="11" Foreground="#B45309" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Series chart -->
            <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E2E8F0"
                    BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Serie temporal: utilidad neta"
                               AutomationProperties.AutomationId="Profitability_SeriesChart"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
                    <TextBlock Text="Devengado vs. percibido por período agrupado"
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SeriesBars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ShowAccrued, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Rectangle Width="{Binding AccruedBarWidth}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle" BasedOn="{StaticResource ChartBarStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AccruedIsNegative}" Value="True">
                                                                <Setter Property="Fill" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <TextBlock Text="{Binding AccruedDisplay}" FontSize="11" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#334155" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                    Visibility="{Binding ShowRealized, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Rectangle Width="{Binding RealizedBarWidth}" Height="12" RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Left">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Fill" Value="#F59E0B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RealizedIsNegative}" Value="True">
                                                                <Setter Property="Fill" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <TextBlock Text="{Binding RealizedDisplay}" FontSize="11" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#92400E" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Payment methods and products -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Métodos de pago" FontWeight="Bold" FontSize="14" Margin="0,0,0,2" />
                        <TextBlock Text="Cobros y comisión neta del período" FontSize="11" Foreground="#64748B" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding PaymentMethodRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FeeDisplay}" FontSize="11" Foreground="#B45309" />
                                        </Grid>
                                        <Rectangle Width="{Binding BarWidth}" Height="10" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" Fill="#2563EB" Margin="0,5,0,0" />
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CollectedDisplay}" FontSize="11" Foreground="#475569" />
                                            <TextBlock Grid.Column="1" Text="{Binding CoverageDisplay}" FontSize="11" Foreground="#64748B" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Productos" FontWeight="Bold" FontSize="14" Margin="0,0,0,2" />
                        <TextBlock Text="Ranking por ingreso del período" FontSize="11" Foreground="#64748B" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding ProductRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding GrossProfitDisplay}" FontSize="11" Foreground="#047857" />
                                        </Grid>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="#94A3B8" />
                                        <Rectangle Width="{Binding BarWidth}" Height="10" RadiusX="3" RadiusY="3"
                                                   HorizontalAlignment="Left" Fill="#10B981" Margin="0,5,0,0" />
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RevenueDisplay}" FontSize="11" Foreground="#475569" />
                                            <TextBlock Grid.Column="1" Text="{Binding MarginDisplay}" FontSize="11" Foreground="#64748B" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Categories and sellers -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Categorías" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding CategoryRows}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="32"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Ingreso" Binding="{Binding RevenueDisplay}" Width="Auto" />
                                <DataGridTextColumn Header="Utilidad" Binding="{Binding GrossProfitDisplay}" Width="Auto" />
                                <DataGridTextColumn Header="Margen" Binding="{Binding MarginDisplay}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Vendedores / cajeros" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding SellerRows}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="32"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cajero" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Ventas netas" Binding="{Binding NetSalesDisplay}" Width="Auto" />
                                <DataGridTextColumn Header="Utilidad bruta" Binding="{Binding GrossProfitDisplay}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alerts -->
            <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="#E2E8F0"
                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Alertas de erosión de margen" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SeverityLabel}" FontWeight="Bold"
                                                       Foreground="{Binding SeverityColor}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailDisplay}" FontSize="11" Foreground="#92400E" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Sin alertas de erosión de margen en el período."
                               FontSize="12" Foreground="#64748B"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ExportStatus}" FontSize="11" Foreground="#475569"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <!-- Empty state -->
            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10"
                    Padding="24" Margin="0,0,0,10"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBar" Width="42" Height="42" Foreground="#94A3B8"
                                             HorizontalAlignment="Center" />
                    <TextBlock Text="Sin movimientos para el período seleccionado"
                               FontWeight="Bold" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Ajuste el rango de fechas o los filtros para ver el Estado de Resultados."
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
