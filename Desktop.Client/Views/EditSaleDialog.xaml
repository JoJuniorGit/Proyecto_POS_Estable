<Window x:Class="Desktop.Client.Views.EditSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Editar Productos del Pedido" Height="640" Width="840"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource MaterialDesignPaper}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Encabezado -->
                <RowDefinition Height="Auto"/> <!-- 2. Área de Búsqueda -->
                <RowDefinition Height="*"/>    <!-- 3. Tabla de Productos -->
                <RowDefinition Height="Auto"/> <!-- 4. Resumen Financiero -->
                <RowDefinition Height="Auto"/> <!-- 5. Botones de Acción -->
            </Grid.RowDefinitions>

            <!-- 1. Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="26" Height="26" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" Text="Editar Productos del Pedido #000"
                                   Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
                                   FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubheader" Text="Cliente: - | Abonado: $0.00 USD"
                               FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="36,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{DynamicResource MaterialDesignIconButton}"
                        Click="BtnCancel_Click" ToolTip="Cerrar ventana" VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                </Button>
            </Grid>

            <!-- 2. Área de Búsqueda de Productos (Importada del POS) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Agregar producto al pedido:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Grid x:Name="SearchGrid">
                    <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="12,0,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" Panel.ZIndex="1"/>
                    <TextBox x:Name="TxtProductSearch"
                             materialDesign:HintAssist.Hint="Buscar producto por nombre o código (SKU)..."
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Padding="38,8,12,8" FontSize="13"
                             TextChanged="TxtProductSearch_TextChanged"/>

                    <!-- Popup emergente de sugerencias (estilo POS) -->
                    <Popup x:Name="PopupSuggestions"
                           StaysOpen="False"
                           PlacementTarget="{Binding ElementName=SearchGrid}"
                           Placement="Bottom"
                           IsOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <materialDesign:Card MaxHeight="250" Width="{Binding ElementName=SearchGrid, Path=ActualWidth}">
                            <ListBox x:Name="LstSuggestions"
                                     SelectionChanged="LstSuggestions_SelectionChanged"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding SKU, StringFormat='SKU: {0}'}" FontSize="11" Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PriceUSD, StringFormat='${0:N2}'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </materialDesign:Card>
                    </Popup>
                </Grid>
            </StackPanel>

            <!-- 3. Tabla de Productos -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,16">
                <DataGrid x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" Background="Transparent">
                    <DataGrid.Columns>
                        <!-- PRODUCTO -->
                        <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- CANT. (Stepper Limpio Unificado) -->
                        <DataGridTemplateColumn Header="CANT." Width="150">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource MaterialDesignPaper}" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DecreaseQuantityCommand}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="24" Height="24" Foreground="#334155" ToolTip="Disminuir cantidad">
                                                <materialDesign:PackIcon Kind="Minus" Width="12" Height="12"/>
                                            </Button>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G29}'}"
                                                     Width="44" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center"
                                                     BorderThickness="0" Background="Transparent" Padding="0"/>
                                            <Button Command="{Binding IncreaseQuantityCommand}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="24" Height="24" Foreground="#334155" ToolTip="Aumentar cantidad">
                                                <materialDesign:PackIcon Kind="Plus" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PRECIO BS.S (Alineado a la Derecha, Solo Bs.S) -->
                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="PRECIO BS.S" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitPriceBsS, StringFormat='Bs.S {0:N2}'}"
                                               FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- SUBTOTAL BS.S (Alineado a la Derecha, Solo Bs.S) -->
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="SUBTOTAL BS.S" HorizontalAlignment="Right" TextAlignment="Right"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SubtotalBsS, StringFormat='Bs.S {0:N2}'}"
                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACCIÓN -->
                        <DataGridTemplateColumn Width="85">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="ACCIÓN" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding RemoveItemCommand}"
                                            Style="{DynamicResource MaterialDesignIconButton}"
                                            Foreground="#C0392B" ToolTip="Eliminar producto"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Resumen Financiero (Equivalencia en $ mantenida únicamente aquí) -->
            <Border Grid.Row="3" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Nuevo Total USD / Bs.S: " FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtNewTotal" Text="$0.00 (Bs.S 0,00)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total Ya Abonado: " FontWeight="SemiBold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtTotalPaid" Text="$0.00" FontWeight="Bold" FontSize="12" Foreground="#059669"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Nuevo Saldo Restante: " FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtRemaining" Text="$0.00" FontWeight="Bold" FontSize="13" Foreground="#C0392B"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Botones de Acción -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancelar"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Margin="0,0,12,0" Height="40" Padding="16,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Height="40" Padding="16,0" Click="BtnSave_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar Cambios" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
