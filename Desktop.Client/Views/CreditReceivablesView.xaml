<UserControl x:Class="Desktop.Client.Views.CreditReceivablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Desktop.Client.ViewModels;assembly=Desktop.Client.Core"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Desktop.Client.Helpers"
             mc:Ignorable="d"
             Background="#F1F5F9"
             d:DataContext="{d:DesignInstance Type=vm:CreditReceivablesViewModel}">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DropShadowEffect x:Key="EnterpriseCardShadow"
                          Color="#000000"
                          BlurRadius="10"
                          Opacity="0.05"
                          Direction="270"
                          ShadowDepth="2"/>

        <Style x:Key="StandardHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="RightAlignedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CxcRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F5F3FF"/>
                    <Setter Property="BorderBrush" Value="#5E35B1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CxcCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="24,20,24,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        AutomationProperties.AutomationId="CreditReceivables_RefreshButton"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        BorderBrush="#CBD5E1" Foreground="#475569"
                        Height="36" Padding="14,0" Margin="0,0,8,0"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                        materialDesign:ButtonProgressAssist.Value="-1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Refrescar" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Static materialDesign:DrawerHost.OpenDrawerCommand}"
                        CommandParameter="{x:Static Dock.Right}"
                        Style="{DynamicResource MaterialDesignIconButton}"
                        ToolTip="Abrir Menú Principal"
                        Height="36" Width="36" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" Foreground="#475569"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CashMultiple" Width="26" Height="26" Foreground="#5E35B1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cuentas por Cobrar (CxC)" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <Border Grid.Row="1"
                Margin="24,0,24,12"
                Padding="16,12"
                CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Effect="{StaticResource EnterpriseCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,2,0"/>
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="CreditReceivables_SearchInput"
                                 Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Cliente, cédula/RIF o factura..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="12" Foreground="#1E293B" Padding="6,0,10,0"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1"
                          AutomationProperties.AutomationId="CreditReceivables_StatusFilter"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Estado"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          Height="38" Margin="0,0,10,0"/>

                <CheckBox Grid.Column="2"
                          AutomationProperties.AutomationId="CreditReceivables_OverdueFilter"
                          Content="Solo mora"
                          IsChecked="{Binding OverdueOnly, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          FontSize="12"/>

                <Button Grid.Column="3"
                        Command="{Binding ApplyFiltersCommand}"
                        AutomationProperties.AutomationId="CreditReceivables_ApplyFilters"
                        Content="APLICAR"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Background="#5E35B1" Foreground="White"
                        Height="38" Padding="16,0" FontSize="11" FontWeight="Bold"
                        materialDesign:ButtonAssist.CornerRadius="6" Margin="0,0,8,0"/>

                <Button Grid.Column="4"
                        Command="{Binding ClearFiltersCommand}"
                        AutomationProperties.AutomationId="CreditReceivables_ClearFilters"
                        Content="LIMPIAR"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Height="38" Padding="14,0" FontSize="11" FontWeight="SemiBold"
                        materialDesign:ButtonAssist.CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Totals -->
        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0" Effect="{StaticResource EnterpriseCardShadow}">
                <StackPanel>
                    <TextBlock Text="CARTERA ABIERTA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalOpenUSD, StringFormat='${0:N2}'}"
                               AutomationProperties.AutomationId="CreditReceivables_TotalOpen"
                               FontSize="20" FontWeight="Bold" Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0" Effect="{StaticResource EnterpriseCardShadow}">
                <StackPanel>
                    <TextBlock Text="VENCIDO (MORA)" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                    <TextBlock Text="{Binding TotalOverdueUSD, StringFormat='${0:N2}'}"
                               AutomationProperties.AutomationId="CreditReceivables_TotalOverdue"
                               FontSize="20" FontWeight="Bold" Foreground="#DC2626" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,10,0" Effect="{StaticResource EnterpriseCardShadow}">
                <StackPanel>
                    <TextBlock Text="OBLIGACIONES ABIERTAS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding OpenCount}"
                               AutomationProperties.AutomationId="CreditReceivables_OpenCount"
                               FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14,10" Effect="{StaticResource EnterpriseCardShadow}">
                <StackPanel>
                    <TextBlock Text="TASA DEL DÍA (BS.S/USD)" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                    <TextBlock Text="{Binding TodayRate, StringFormat='{}{0:N2}'}"
                               AutomationProperties.AutomationId="CreditReceivables_TodayRate"
                               FontSize="20" FontWeight="Bold" Foreground="#166534" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Alerts and messages -->
        <StackPanel Grid.Row="3" Margin="24,0,24,10">
            <Border Visibility="{Binding HasOverdueAlert, Converter={StaticResource BoolToVis}}"
                    Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="#DC2626" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OverdueAlertMessage}" Foreground="#991B1B" FontWeight="SemiBold"
                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#166534" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" FontWeight="SemiBold"
                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Receivables grid -->
        <Border Grid.Row="4"
                Margin="24,0,24,16"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{StaticResource EnterpriseCardShadow}"
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Receivables}"
                          SelectedItem="{Binding SelectedReceivable, Mode=TwoWay}"
                          AutomationProperties.AutomationId="CreditReceivables_DataGrid"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single"
                          Background="#FFFFFF" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column"
                          ColumnHeaderStyle="{StaticResource StandardHeaderStyle}"
                          RowStyle="{StaticResource CxcRowStyle}"
                          CellStyle="{StaticResource CxcCellStyle}"
                          RowHeight="54"
                          VerticalScrollBarVisibility="Auto"
                          materialDesign:DataGridAssist.CellPadding="12,8"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="12,12">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="FACTURA" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceDisplay}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding SaleId, StringFormat='Venta #{0}'}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="CLIENTE" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CustomerCedulaOrRif}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="EMISIÓN / VENCE" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IssuedDateDisplay}" FontSize="11" Foreground="#475569"/>
                                        <TextBlock Text="{Binding DueDateDisplay, StringFormat='Vence: {0}'}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SALDO USD" Width="120" HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BalanceDisplay}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding OriginalUSD, StringFormat='Orig. ${0:N2}'}" FontSize="10" Foreground="#64748B" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SALDO BS.S HOY" Width="140" HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BalanceTodayDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="#166534"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ESTADO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="100" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pagada">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Anulada">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pagada">
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACCIONES" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Cobrar"
                                                Command="{Binding Data.RegisterPaymentCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="CreditReceivables_RegisterPayment"
                                                Height="28" Padding="12,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"
                                                materialDesign:ButtonAssist.CornerRadius="5">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                    <Setter Property="Background" Value="#5E35B1"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Estado"
                                                Command="{Binding Data.ViewStatementCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="CreditReceivables_ViewStatement"
                                                Style="{StaticResource ActionButtonStyle}"/>
                                        <Button Content="Anular"
                                                Command="{Binding Data.CancelCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="CreditReceivables_Cancel">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Devolver"
                                                Command="{Binding Data.ReturnCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="CreditReceivables_Return">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Data.CanManageCreditReturns, Source={StaticResource Proxy}}" Value="True"/>
                                                                <Condition Binding="{Binding CanReturn}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="PDF"
                                                Command="{Binding Data.PrintCreditSaleReceiptCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="CreditReceivables_PrintCreditReceipt"
                                                Style="{StaticResource ActionButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Background="#60FFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" Foreground="#5E35B1"
                                     IsIndeterminate="True" Width="44" Height="44"/>
                        <TextBlock Text="Cargando cartera CxC..." Foreground="#475569" FontWeight="SemiBold" Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Receivables, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="CashCheck" Width="48" Height="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sin obligaciones para los filtros seleccionados." Foreground="#94A3B8" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
