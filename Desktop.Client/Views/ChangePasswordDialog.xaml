<Window x:Class="Desktop.Client.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Cambiar Contraseña" Height="380" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cambio de Contraseña" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold"/>
            <TextBlock Text="Por seguridad, debe establecer una nueva contraseña antes de continuar."
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource NavTextMutedBrush}"/>
        </StackPanel>

        <!-- Main Form -->
        <StackPanel Grid.Row="1">
            <PasswordBox x:Name="CurrentPasswordBox"
                         materialDesign:HintAssist.Hint="Contraseña actual"
                         Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,16" TabIndex="1"/>
            <PasswordBox x:Name="NewPasswordBox"
                         materialDesign:HintAssist.Hint="Nueva contraseña"
                         Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,16" TabIndex="2"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         materialDesign:HintAssist.Hint="Confirmar nueva contraseña"
                         Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,8" TabIndex="3"/>

            <TextBlock x:Name="ErrorText" Text="" Foreground="#EE5353" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Footer / Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCELAR" Click="Cancel_Click" Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,15,0" IsCancel="True" TabIndex="5"/>
            <Button Content="CAMBIAR CONTRASEÑA" Click="Save_Click" Style="{DynamicResource MaterialDesignRaisedButton}" IsDefault="True" TabIndex="4"/>
        </StackPanel>
    </Grid>
</Window>
