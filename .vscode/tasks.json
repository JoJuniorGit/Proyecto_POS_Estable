{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Safe)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/build-clean.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build (Safe + Performance)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/build-clean.ps1",
        "-clp:PerformanceSummary"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Backend Only",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Backend.API/Backend.API.csproj"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Desktop Only",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Desktop.Client/Desktop.Client.csproj"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/CommandCenter.Tests/CommandCenter.Tests.csproj"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Watch Backend",
      "type": "shell",
      "command": "dotnet",
      "args": ["watch", "--project", "${workspaceFolder}/Backend.API/Backend.API.csproj", "run"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
