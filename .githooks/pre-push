#!/usr/bin/env bash

# ======== GGA START ========
# Gentleman Guardian Angel - Code Review
# Revision con IA una vez por push (por work unit), no por commit.
# Ver AGENTS.md > "Commits, Hooks y --no-verify".
if git rev-parse --verify --quiet refs/heads/main >/dev/null \
   || git rev-parse --verify --quiet refs/heads/master >/dev/null \
   || git rev-parse --verify --quiet refs/heads/develop >/dev/null \
   || git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null; then
  gga run --pr-mode --diff-only || exit 1
else
  echo "[GGA] Sin rama base detectable; se revisa el ultimo commit (--ci)." >&2
  gga run --ci || exit 1
fi
# ======== GGA END ========
