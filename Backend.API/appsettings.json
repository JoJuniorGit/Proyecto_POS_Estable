{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "SystemSettings": {
    "MinimumClientVersion": "1.0.0",
    "ServerVersion": "1.0.0",
    "UpdateServerUrl": "http://localhost:5000/updates/",
    "AdminSeedUsername": "Admin",
    "BusinessName": "Mi Negocio POS"
  },
  "JwtSettings": {
    "Issuer": "SolucionesPos",
    "Audience": "PosClient",
    "ExpiryMinutes": 120
  },
  "MemoryCache": {
    "SizeLimit": 10000
  },
  "Idempotency": {
    "TtlHours": 24.0
  },
  "BcvSettings": {
    "TimeoutSeconds": 15
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Password": ""
      }
    }
  }
}
